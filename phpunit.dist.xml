<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Client">
            <directory>tests/Unit/Client</directory>
        </testsuite>
        <testsuite name="Expense">
            <directory>tests/Unit/Expense</directory>
        </testsuite>
        <testsuite name="Identity">
            <directory>tests/Unit/Identity</directory>
        </testsuite>
        <testsuite name="Inventory">
            <directory>tests/Unit/Inventory</directory>
        </testsuite>
        <testsuite name="Location">
            <directory>tests/Unit/Location</directory>
        </testsuite>
        <testsuite name="Notification">
            <directory>tests/Unit/Notification</directory>
        </testsuite>
        <testsuite name="Organization">
            <directory>tests/Unit/Organization</directory>
        </testsuite>
        <testsuite name="Support">
            <directory>tests/Unit/Support</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

    <extensions>
    </extensions>
</phpunit>
