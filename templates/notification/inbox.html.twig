{% extends 'base.html.twig' %}

{% block title %}Bandeja de notificaciones{% endblock %}
{% block page_title %}Notificaciones{% endblock %}

{% block header_actions %}
    <div class="flex items-center gap-2">
        {% if notifications is not empty %}
        <form method="POST" action="{{ path('notification_inbox_mark_all_read') }}">
            <button type="submit"
                    class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Marcar todas como leídas
            </button>
        </form>
        {% endif %}
        <a href="{{ path('notification_inbox') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/>
            </svg>
            Recargar
        </a>
    </div>
{% endblock %}

{% block body %}
{% if notifications is empty %}
    <div class="flex flex-col items-center justify-center py-20 text-gray-400">
        <svg class="w-14 h-14 mb-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
        </svg>
        <p class="text-sm font-medium text-gray-600">No tienes notificaciones.</p>
    </div>
{% else %}
    <div class="flex items-center gap-2 mb-4">
        <span class="text-sm text-gray-500">
            <strong class="text-gray-800">{{ unreadCount }}</strong> sin leer
        </span>
        <span class="text-gray-300">·</span>
        <span class="text-sm text-gray-400">{{ notifications|length }} notificaciones</span>
    </div>

    <div class="space-y-2">
        {% for notification in notifications %}
            {% set isUnread = notification.readAt is null %}
            <div class="bg-white rounded-xl shadow-sm border transition-colors
                {% if isUnread %}border-blue-200 border-l-4 border-l-blue-500{% else %}border-gray-200{% endif %}">
                <div class="p-4 flex items-start gap-4">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <p class="text-sm font-medium text-gray-900 {% if not isUnread %}text-gray-600{% endif %}">
                                    {{ notification.title }}
                                </p>
                                <p class="text-xs text-gray-500 mt-0.5">{{ notification.body }}</p>
                            </div>
                            {% if isUnread %}
                            <form method="POST" action="{{ path('notification_inbox_mark_read', {id: notification.id}) }}"
                                  class="shrink-0">
                                <button type="submit"
                                        class="text-xs font-medium px-2.5 py-1 rounded-full border border-blue-200 text-blue-600 hover:bg-blue-50 transition-colors">
                                    Marcar leído
                                </button>
                            </form>
                            {% endif %}
                        </div>
                        <div class="flex items-center gap-3 mt-2">
                            <span class="text-xs font-medium px-2 py-0.5 rounded-full
                                {% if notification.eventType starts with 'ticket' %}bg-purple-100 text-purple-700
                                {% elseif notification.eventType starts with 'expense' or notification.eventType starts with 'cash' %}bg-amber-100 text-amber-700
                                {% elseif notification.eventType starts with 'user' or notification.eventType starts with 'client' %}bg-blue-100 text-blue-700
                                {% elseif notification.eventType starts with 'stock' or notification.eventType starts with 'request' %}bg-green-100 text-green-700
                                {% elseif notification.eventType starts with 'sla' or notification.eventType starts with 'warranty' %}bg-red-100 text-red-700
                                {% else %}bg-gray-100 text-gray-600{% endif %}">
                                {{ notification.eventType|replace({'_': ' '})|title }}
                            </span>
                            <span class="text-xs text-gray-400">{{ notification.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
