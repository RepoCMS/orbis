{% extends 'base.html.twig' %}

{% block title %}Plantillas de notificación{% endblock %}
{% block page_title %}Plantillas de notificación{% endblock %}

{% block header_actions %}
    <div class="flex items-center gap-3">
        <a href="{{ path('notification_template_new') }}"
           class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm transition-all"
           style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
            + Nueva plantilla
        </a>
        <a href="{{ path('notification_admin', {tab: 'templates'}) }}"
           class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            ← Volver
        </a>
    </div>
{% endblock %}

{% block body %}
<form method="GET" action="{{ path('notification_template_list') }}"
      class="bg-white rounded-xl shadow-sm p-4 mb-5">
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Evento</label>
            <select name="eventType"
                    class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="">Todos</option>
                {% for et in eventTypes %}
                    <option value="{{ et.value }}" {% if filters.eventType == et.value %}selected{% endif %}>
                        {{ et.label }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Canal</label>
            <select name="channel"
                    class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="">Todos</option>
                {% for ch in channels %}
                    <option value="{{ ch.value }}" {% if filters.channel == ch.value %}selected{% endif %}>
                        {{ ch.label }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Estado</label>
            <select name="isActive"
                    class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="">Todos</option>
                <option value="1" {% if filters.isActive == '1' %}selected{% endif %}>Activo</option>
                <option value="0" {% if filters.isActive == '0' %}selected{% endif %}>Inactivo</option>
            </select>
        </div>
        <div class="flex items-end gap-2">
            <button type="submit"
                    class="px-4 py-2 rounded-lg text-sm font-medium text-white shadow-sm"
                    style="background: #1e3585;">
                Filtrar
            </button>
            <a href="{{ path('notification_template_list') }}"
               class="text-sm text-gray-500 hover:text-gray-700 underline">Limpiar</a>
        </div>
    </div>
</form>

{% if templates is empty %}
    <div class="flex flex-col items-center justify-center py-20 text-gray-400">
        <svg class="w-12 h-12 mb-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
        </svg>
        <p class="text-sm font-medium text-gray-600">No hay plantillas configuradas.</p>
    </div>
{% else %}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-gray-100 text-left">
                        <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Asunto</th>
                        <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Evento</th>
                        <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Canal</th>
                        <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Activo</th>
                        <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {% for template in templates %}
                    <tr class="hover:bg-gray-50/60 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-900">
                            <a href="{{ path('notification_template_show', {id: template.id}) }}"
                               class="hover:text-blue-700 transition-colors">{{ template.subject ?: '(sin asunto)' }}</a>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">{{ template.eventType|replace({'_': ' '})|title }}</span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-xs font-medium px-2 py-0.5 rounded-full
                                {% if template.channel == 'email' %}bg-blue-100 text-blue-700
                                {% elseif template.channel == 'in_app' %}bg-green-100 text-green-700
                                {% elseif template.channel == 'whatsapp' %}bg-emerald-100 text-emerald-700
                                {% else %}bg-gray-100 text-gray-600{% endif %}">
                                {{ template.channel|replace({'_': ' '})|title }}
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            {% if template.isActive %}
                                <span class="text-xs font-medium text-green-600">● Activo</span>
                            {% else %}
                                <span class="text-xs font-medium text-gray-400">● Inactivo</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('notification_template_show', {id: template.id}) }}"
                                   class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-100 transition-colors">
                                    Ver
                                </a>
                                <a href="{{ path('notification_template_edit', {id: template.id}) }}"
                                   class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-100 transition-colors">
                                    Editar
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
