{% extends 'base.html.twig' %}

{% block title %}{{ template.subject ?: 'Plantilla' }}{% endblock %}
{% block page_title %}Detalle de plantilla{% endblock %}

{% block header_actions %}
    <div class="flex items-center gap-2">
        <a href="{{ path('notification_template_edit', {id: template.id}) }}"
           class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
            Editar
        </a>
        <a href="{{ path('notification_template_list') }}"
           class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Volver
        </a>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-2xl">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 text-sm">
                <div class="sm:col-span-2">
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Asunto</dt>
                    <dd class="text-gray-800">{{ template.subject ?: '(sin asunto)' }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Evento</dt>
                    <dd>
                        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">
                            {{ template.eventType|replace({'_': ' '})|title }}
                        </span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Canal</dt>
                    <dd>
                        <span class="text-xs font-medium px-2 py-0.5 rounded-full
                            {% if template.channel == 'email' %}bg-blue-100 text-blue-700
                            {% elseif template.channel == 'in_app' %}bg-green-100 text-green-700
                            {% elseif template.channel == 'whatsapp' %}bg-emerald-100 text-emerald-700
                            {% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ template.channel|replace({'_': ' '})|title }}
                        </span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Estado</dt>
                    <dd>
                        {% if template.isActive %}
                            <span class="text-xs font-medium text-green-600">● Activo</span>
                        {% else %}
                            <span class="text-xs font-medium text-gray-400">● Inactivo</span>
                        {% endif %}
                    </dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Cuerpo de la plantilla</dt>
                    <dd class="text-gray-700 bg-gray-50 rounded-lg p-4 font-mono text-xs whitespace-pre-wrap">{{ template.bodyTemplate }}</dd>
                </div>
            </dl>
        </div>

        <div class="mt-6 flex items-center gap-3">
            <a href="{{ path('notification_template_edit', {id: template.id}) }}"
               class="px-5 py-2 text-sm font-medium text-white rounded-lg shadow-sm transition-all"
               style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                Editar plantilla
            </a>
            <a href="{{ path('notification_template_list') }}"
               class="px-4 py-2 text-sm font-medium text-gray-600 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors">
                Volver al listado
            </a>
        </div>
    </div>
{% endblock %}
