{% extends 'base.html.twig' %}

{% block title %}Registro de notificación{% endblock %}
{% block page_title %}Detalle de envío{% endblock %}

{% block header_actions %}
    <div class="flex items-center gap-2">
        {% if log.status == 'failed' %}
        <form method="POST" action="{{ path('notification_log_retry', {id: log.id}) }}">
            <button type="submit"
                    class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-amber-200 text-amber-600 hover:bg-amber-50 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/>
                </svg>
                Reintentar
            </button>
        </form>
        {% endif %}
        <a href="{{ path('notification_log_list') }}"
           class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Volver
        </a>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-2xl space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 text-sm">
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">ID</dt>
                    <dd class="font-mono text-xs text-gray-700">{{ log.id }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Estado</dt>
                    <dd>
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full
                            {% if log.status == 'sent' %}bg-green-100 text-green-700
                            {% elseif log.status == 'failed' %}bg-red-100 text-red-700
                            {% else %}bg-yellow-100 text-yellow-700{% endif %}">
                            {{ log.status|capitalize }}
                        </span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Destinatario</dt>
                    <dd class="text-gray-800">
                        <span class="font-mono text-xs">{{ log.recipientId }}</span>
                        <span class="text-xs text-gray-400">({{ log.recipientType|replace({'_': ' '})|title }})</span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Canal</dt>
                    <dd>
                        <span class="text-xs font-medium px-2 py-0.5 rounded-full
                            {% if log.channel == 'email' %}bg-blue-100 text-blue-700
                            {% elseif log.channel == 'in_app' %}bg-green-100 text-green-700
                            {% elseif log.channel == 'whatsapp' %}bg-emerald-100 text-emerald-700
                            {% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ log.channel|replace({'_': ' '})|title }}
                        </span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Evento</dt>
                    <dd class="text-gray-700">{{ log.eventType|replace({'_': ' '})|title }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Asunto</dt>
                    <dd class="text-gray-700">{{ log.subject ?: '—' }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Intentos</dt>
                    <dd class="text-gray-800">{{ log.attemptCount }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Creado</dt>
                    <dd class="text-gray-700">{{ log.createdAt|date('d/m/Y H:i:s') }}</dd>
                </div>
                {% if log.sentAt %}
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Enviado</dt>
                    <dd class="text-gray-700">{{ log.sentAt|date('d/m/Y H:i:s') }}</dd>
                </div>
                {% endif %}
                {% if log.readAt %}
                <div>
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Leído</dt>
                    <dd class="text-gray-700">{{ log.readAt|date('d/m/Y H:i:s') }}</dd>
                </div>
                {% endif %}
                {% if log.referenceType and log.referenceId %}
                <div class="sm:col-span-2">
                    <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Referencia</dt>
                    <dd class="text-gray-700">
                        {{ log.referenceType }}: <span class="font-mono text-xs">{{ log.referenceId }}</span>
                    </dd>
                </div>
                {% endif %}
            </dl>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Cuerpo del mensaje</h3>
            <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-700 whitespace-pre-wrap">{{ log.body }}</div>
        </div>

        {% if log.failureReason %}
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <div class="flex gap-3">
                <svg class="w-5 h-5 shrink-0 mt-0.5 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                </svg>
                <div class="flex-1">
                    <p class="text-sm font-medium text-red-800 mb-1">Motivo del fallo</p>
                    <p class="text-sm text-red-700">{{ log.failureReason }}</p>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
{% endblock %}
