{% extends 'base.html.twig' %}

{% block title %}Administración de notificaciones{% endblock %}
{% block page_title %}Notificaciones{% endblock %}

{% block body %}
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    {% set totalTemplates = templates|length %}
    {% set totalLogs = logs|length %}
    {% set failedCount = logs|filter(l => l.status == 'failed')|length %}
    {% set todayCount = logs|filter(l => l.createdAt|date('Y-m-d') == 'now'|date('Y-m-d'))|length %}

    <div class="bg-white rounded-xl shadow-sm p-5 flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: #1e358515;">
            <svg class="w-5 h-5" style="color: #1e3585" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
            </svg>
        </div>
        <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Plantillas</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ totalTemplates }}</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: #00a86b15;">
            <svg class="w-5 h-5" style="color: #00a86b" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Enviados hoy</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ todayCount }}</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: #dc262615;">
            <svg class="w-5 h-5" style="color: #dc2626" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
            </svg>
        </div>
        <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Fallidos</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ failedCount }}</p>
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="border-b border-gray-100">
        <nav class="flex">
            <a href="{{ path('notification_admin', {tab: 'templates'}) }}"
               class="px-5 py-3 text-sm font-medium transition-colors
                   {% if tab == 'templates' %}text-white{% else %}text-gray-500 hover:text-gray-700{% endif %}"
               {% if tab == 'templates' %}style="background: #1e3585;"{% endif %}>
                Plantillas
            </a>
            <a href="{{ path('notification_admin', {tab: 'logs'}) }}}"
               class="px-5 py-3 text-sm font-medium transition-colors
                   {% if tab == 'logs' %}text-white{% else %}text-gray-500 hover:text-gray-700{% endif %}"
               {% if tab == 'logs' %}style="background: #1e3585;"{% endif %}>
                Historial
            </a>
            <a href="{{ path('notification_template_list') }}"
               class="px-5 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors ml-auto">
                Ir a plantillas →
            </a>
            <a href="{{ path('notification_log_list') }}"
               class="px-5 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors">
                Ir a historial →
            </a>
        </nav>
    </div>

    <div class="p-6">
        {% if tab == 'templates' %}
        <div class="space-y-4">
            {% if templates is empty %}
                <p class="text-sm text-gray-400 text-center py-8">No hay plantillas configuradas.</p>
            {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Nombre</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Evento</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Canal</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Activo</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for template in templates %}
                        <tr class="hover:bg-gray-50/60 transition-colors">
                            <td class="px-4 py-3 font-medium text-gray-900">{{ template.subject ?: '(sin asunto)' }}</td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">{{ template.eventType }}</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2 py-0.5 rounded-full
                                    {% if template.channel == 'email' %}bg-blue-100 text-blue-700
                                    {% elseif template.channel == 'in_app' %}bg-green-100 text-green-700
                                    {% elseif template.channel == 'whatsapp' %}bg-green-100 text-green-700
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ template.channel|replace({'_': ' '})|title }}
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                {% if template.isActive %}
                                    <span class="text-xs font-medium text-green-600">● Activo</span>
                                {% else %}
                                    <span class="text-xs font-medium text-gray-400">● Inactivo</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
        {% else %}
        <div class="space-y-4">
            {% if logs is empty %}
                <p class="text-sm text-gray-400 text-center py-8">No hay registros de envío.</p>
            {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Destinatario</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Canal</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Estado</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Evento</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden lg:table-cell">Fecha</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for log in logs %}
                        <tr class="hover:bg-gray-50/60 transition-colors">
                            <td class="px-4 py-3 text-gray-700">{{ log.recipientId|slice(0,10) }}…</td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2 py-0.5 rounded-full
                                    {% if log.channel == 'email' %}bg-blue-100 text-blue-700
                                    {% elseif log.channel == 'in_app' %}bg-green-100 text-green-700
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ log.channel }}
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                                    {% if log.status == 'sent' %}bg-green-100 text-green-700
                                    {% elseif log.status == 'failed' %}bg-red-100 text-red-700
                                    {% else %}bg-yellow-100 text-yellow-700{% endif %}">
                                    {{ log.status }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-gray-600">{{ log.eventType|replace({'_': ' '})|title }}</td>
                            <td class="px-4 py-3 text-gray-400 text-xs hidden lg:table-cell">{{ log.createdAt|date('d/m/Y H:i') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
