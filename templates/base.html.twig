                        class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                        style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'notification_template' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'notification_template' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                        </svg>
                        <span class="hidden lg:inline">Plantillas</span>
                    </a>
                    <a href="{{ path('notification_log_list') }}"
                        title="Historial"
                        class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                        style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'notification_log' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'notification_log' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span class="hidden lg:inline">Historial</span>
                    </a>
                    <a href="{{ path('notification_preference_list') }}"
                        title="Preferencias"
                        class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                        style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'notification_preference' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'notification_preference' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.073.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/>
                        </svg>
                        <span class="hidden lg:inline">Preferencias</span>
                    </a>
                    {% endif %}

                </nav>

                {# Footer del sidebar #}
                <div class="px-4 py-3 text-xs overflow-hidden" style="border-top: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.3);">
                    <span class="hidden lg:inline">Orbis v0.1.0</span>
                    <span class="lg:hidden">v0.1</span>
                </div>
            </aside>

            {# ── Área principal ── #}
            <div class="flex-1 flex flex-col overflow-hidden">

                {# Top bar #}
                <header class="bg-white shadow-sm px-6 py-4 flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-3">
                        {# Breadcrumb / título de página #}
                        <h1 class="text-lg font-semibold" style="color: #1e3585;">{% block page_title %}{% endblock %}</h1>
                    </div>
                    <div class="flex items-center gap-3">
                        {% block header_actions %}{% endblock %}
                        {# Notificaciones (visible siempre que el usuario esté logueado) #}
                        {% if app.user %}
                        <a href="{{ path('notification_inbox') }}"
                           title="Notificaciones"
                           data-controller="notification-badge"
                           data-notification-badge-url-value="{{ path('notification_badge') }}"
                           class="relative flex items-center justify-center w-9 h-9 rounded-lg transition-colors"
                           style="{% if app.request.attributes.get('_route') starts with 'notification_' %}color:#1e3585;background:#eef1f9;{% else %}color:#9ca3af;{% endif %}"
                           onmouseover="this.style.background='#eef1f9'; this.style.color='#1e3585';"
                           onmouseout="this.style.background=''; this.style.color='{% if app.request.attributes.get('_route') starts with 'notification_' %}#1e3585{% else %}#9ca3af{% endif %}';">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
                            </svg>
                            <turbo-frame id="notification-badge" src="{{ path('notification_badge') }}"></turbo-frame>
                        </a>
                        {% endif %}
                        {# Usuario logueado #}
                        {% if app.user %}
                            <div class="flex items-center gap-2 pl-3" style="border-left: 1px solid #e2e8f0;">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold shrink-0" style="background: #1e3585;">
                                    {{ app.user.getUserIdentifier()|slice(0,1)|upper }}
                                </div>
                                <div class="hidden sm:block text-right">
                                    <p class="text-xs font-semibold text-gray-800 leading-tight">{{ app.user.getUserIdentifier() }}</p>
                                </div>
                                <form method="POST" action="{{ path('app_logout') }}" class="ml-1">
                                    <button type="submit" title="Cerrar sesión"
                                            class="w-7 h-7 flex items-center justify-center rounded-md text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </header>

                {# Flash messages #}
                {% for type, messages in app.flashes(['success', 'error', 'warning', 'info']) %}
                    {% for message in messages %}
                        <div class="mx-6 mt-4 px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2
                            {% if type == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200
                            {% elseif type == 'error' %}bg-red-50 text-red-800 border border-red-200
                            {% elseif type == 'info' %}bg-blue-50 text-blue-800 border border-blue-200
                            {% else %}bg-amber-50 text-amber-800 border border-amber-200{% endif %}">
                            {% if type == 'success' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {% elseif type == 'error' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                            {% endif %}
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Contenido de la página #}
                <main class="flex-1 overflow-y-auto p-6">
                    {% block body %}{% endblock %}
                </main>

            </div>
        </div>

        {# ── Funciones globales de modal ── #}
        <script>
            function openModal(id) { var el = document.getElementById(id); if (el) el.classList.remove('hidden'); }
            function closeModal(id) { var el = document.getElementById(id); if (el) el.classList.add('hidden'); }
        </script>

    </body>
</html>
