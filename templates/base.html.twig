<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Orbis{% endblock %} — CMS Orbis</title>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-slate-100 text-gray-900 antialiased">

        {# ── Layout principal ── #}
        <div class="flex h-screen overflow-hidden">

            {# ── Sidebar ── #}
            <aside id="sidebar"
                   class="flex flex-col shrink-0 shadow-xl transition-all duration-300 w-16 lg:w-64"
                   style="background: linear-gradient(180deg, #1e3585 0%, #152970 100%);">

                {# Logo / marca #}
                <div class="flex items-center gap-3 px-4 lg:px-6 py-5 overflow-hidden" style="border-bottom: 1px solid rgba(255,255,255,0.12);">
                    <div class="flex items-center gap-2 min-w-0">
                        {# Ícono swoosh en verde #}
                        <svg class="shrink-0" width="28" height="28" viewBox="0 0 32 32" fill="none">
                            <path d="M4 24 C8 14, 20 8, 30 10" stroke="#00a86b" stroke-width="3.5" stroke-linecap="round" fill="none"/>
                            <path d="M4 24 C10 20, 22 20, 30 10" stroke="#00c882" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
                        </svg>
                        <div class="hidden lg:block min-w-0">
                            <span class="block text-xl font-bold tracking-tight text-white leading-none">Orbis</span>
                            <span class="block text-xs font-medium leading-none mt-0.5" style="color: #00a86b;">CMS Business Solutions</span>
                        </div>
                    </div>
                </div>

                {# Navegación #}
                <nav class="flex-1 overflow-y-auto py-5 px-2 lg:px-3 space-y-0.5 text-sm">

                    {# Dashboard #}
                    <a href="{{ path('app_dashboard') }}"
                       title="Dashboard"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') == 'app_dashboard' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                        </svg>
                        <span class="hidden lg:inline">Dashboard</span>
                    </a>

                    {# Sección: Seguridad #}
                    {% set canSeeSecurity = is_granted('user.view_all') or is_granted('role.view_all') %}
                    {% if canSeeSecurity %}
                    <p class="hidden lg:block px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest" style="color: rgba(255,255,255,0.35);">Seguridad</p>
                    {% endif %}
                    {% if is_granted('user.view_all') %}
                    <a href="{{ path('user_list') }}"
                       title="Usuarios"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150
                              {% if app.request.attributes.get('_route') starts with 'user_' %}
                                  text-white
                              {% else %}
                                  text-blue-200 hover:text-white hover:bg-white/10
                              {% endif %}"
                       {% if app.request.attributes.get('_route') starts with 'user_' %}
                           style="background: rgba(0,168,107,0.25); border-left: 3px solid #00a86b;"
                       {% else %}
                           style="border-left: 3px solid transparent;"
                       {% endif %}>
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-5-4m-4 6H2v-2a4 4 0 015-4m4 6v-2m0-4a4 4 0 110-8 4 4 0 010 8z"/>
                        </svg>
                        <span class="hidden lg:inline">Usuarios</span>
                    </a>
                    {% endif %}
                    {% if is_granted('role.view_all') %}
                    <a href="{{ path('role_list') }}"
                       title="Roles"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150
                              {{ app.request.attributes.get('_route') starts with 'role_' ? 'text-white' : 'text-blue-200 hover:text-white hover:bg-white/10' }}"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'role_' ? '#00a86b' : 'transparent' }};
                              {{ app.request.attributes.get('_route') starts with 'role_' ? 'background: rgba(0,168,107,0.25);' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        <span class="hidden lg:inline">Roles</span>
                    </a>
                    {% endif %}

                    {# Sección: Negocio #}
                    {% set canSeeBusiness = is_granted('client.view_all') or is_granted('employee.view_all') or is_granted('service_zone.view_all') %}
                    {% if canSeeBusiness %}
                    <p class="hidden lg:block px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-widest" style="color: rgba(255,255,255,0.35);">Negocio</p>
                    {% endif %}
                    {% if is_granted('client.view_all') %}
                    <a href="{{ path('client_list') }}"
                       title="Clientes"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'client_' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'client_' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                        <span class="hidden lg:inline">Clientes</span>
                    </a>
                    {% endif %}
                    {% if is_granted('employee.view_all') %}
                    <a href="{{ path('employee_list') }}"
                       title="Empleados"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'employee_' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'employee_' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span class="hidden lg:inline">Empleados</span>
                    </a>
                    {% endif %}
                    {% if is_granted('service_zone.view_all') %}
                    <a href="{{ path('service_zone_list') }}"
                       title="Zonas de Servicio"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'service_zone_' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'service_zone_' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
                        </svg>
                        <span class="hidden lg:inline">Zonas de Servicio</span>
                    </a>
                    {% endif %}

                    {# Sección: Inventario #}
                    {% set canSeeInventory = is_granted('inventory.view') %}
                    {% if canSeeInventory %}
                    <p class="hidden lg:block px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-widest" style="color: rgba(255,255,255,0.35);">Inventario</p>
                    <a href="{{ path('inventory_product_list') }}"
                       title="Productos"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_product' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_product' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/>
                        </svg>
                        <span class="hidden lg:inline">Productos</span>
                    </a>
                    <a href="{{ path('inventory_location_list') }}"
                       title="Ubicaciones"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_location' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_location' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                        </svg>
                        <span class="hidden lg:inline">Ubicaciones</span>
                    </a>
                    <a href="{{ path('inventory_stock_overview') }}"
                       title="Stock"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_stock' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_stock' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                        </svg>
                        <span class="hidden lg:inline">Stock</span>
                    </a>
                    <a href="{{ path('inventory_po_list') }}"
                       title="Órdenes de compra"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_po' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_po' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/>
                        </svg>
                        <span class="hidden lg:inline">Órd. Compra</span>
                    </a>
                    <a href="{{ path('inventory_entry_list') }}"
                       title="Entradas"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_entry' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_entry' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
                        </svg>
                        <span class="hidden lg:inline">Entradas</span>
                    </a>
                    <a href="{{ path('inventory_repair_list') }}"
                       title="Reparaciones"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_repair' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_repair' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/>
                        </svg>
                        <span class="hidden lg:inline">Reparaciones</span>
                    </a>
                    <a href="{{ path('inventory_request_list') }}"
                       title="Solicitudes de Stock"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_request' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_request' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                        </svg>
                        <span class="hidden lg:inline">Solicitudes</span>
                    </a>
                    <a href="{{ path('inventory_movement_list') }}"
                       title="Movimientos"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_movement' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_movement' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 3M21 7.5H7.5"/>
                        </svg>
                        <span class="hidden lg:inline">Movimientos</span>
                    </a>
                    <a href="{{ path('inventory_transformation_list') }}"
                       title="Transformaciones"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'inventory_transformation' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'inventory_transformation' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/>
                        </svg>
                        <span class="hidden lg:inline">Transformaciones</span>
                    </a>
                    {% endif %}

                    {# ── Soporte ── #}
                    <div class="px-3 pt-4 pb-1">
                        <p class="hidden lg:block text-xs font-semibold uppercase tracking-widest" style="color:rgba(255,255,255,0.35);">Soporte</p>
                        <div class="lg:hidden border-t mt-1" style="border-color:rgba(255,255,255,0.15);"></div>
                    </div>
                    <a href="{{ path('support_ticket_list') }}"
                       title="Tickets"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-all duration-150 text-blue-200 hover:text-white hover:bg-white/10"
                       style="border-left: 3px solid {{ app.request.attributes.get('_route') starts with 'support_ticket' ? '#00a86b' : 'transparent' }}; {{ app.request.attributes.get('_route') starts with 'support_ticket' ? 'background: rgba(255,255,255,0.12); color: #fff;' : '' }}">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a3 3 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                        </svg>
                        <span class="hidden lg:inline">Tickets</span>
                    </a>

                </nav>

                {# Footer del sidebar #}
                <div class="px-4 py-3 text-xs overflow-hidden" style="border-top: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.3);">
                    <span class="hidden lg:inline">Orbis v0.1.0</span>
                    <span class="lg:hidden">v0.1</span>
                </div>
            </aside>

            {# ── Área principal ── #}
            <div class="flex-1 flex flex-col overflow-hidden">

                {# Top bar #}
                <header class="bg-white shadow-sm px-6 py-4 flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-3">
                        {# Breadcrumb / título de página #}
                        <h1 class="text-lg font-semibold" style="color: #1e3585;">{% block page_title %}{% endblock %}</h1>
                    </div>
                    <div class="flex items-center gap-3">
                        {% block header_actions %}{% endblock %}
                        {# Usuario logueado #}
                        {% if app.user %}
                            <div class="flex items-center gap-2 pl-3" style="border-left: 1px solid #e2e8f0;">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold shrink-0" style="background: #1e3585;">
                                    {{ app.user.getUserIdentifier()|slice(0,1)|upper }}
                                </div>
                                <div class="hidden sm:block text-right">
                                    <p class="text-xs font-semibold text-gray-800 leading-tight">{{ app.user.getUserIdentifier() }}</p>
                                </div>
                                <form method="POST" action="{{ path('app_logout') }}" class="ml-1">
                                    <button type="submit" title="Cerrar sesión"
                                            class="w-7 h-7 flex items-center justify-center rounded-md text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </header>

                {# Flash messages #}
                {% for type, messages in app.flashes(['success', 'error', 'warning', 'info']) %}
                    {% for message in messages %}
                        <div class="mx-6 mt-4 px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2
                            {% if type == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200
                            {% elseif type == 'error' %}bg-red-50 text-red-800 border border-red-200
                            {% elseif type == 'info' %}bg-blue-50 text-blue-800 border border-blue-200
                            {% else %}bg-amber-50 text-amber-800 border border-amber-200{% endif %}">
                            {% if type == 'success' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {% elseif type == 'error' %}
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                            {% endif %}
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Contenido de la página #}
                <main class="flex-1 overflow-y-auto p-6">
                    {% block body %}{% endblock %}
                </main>

            </div>
        </div>

    </body>
</html>
