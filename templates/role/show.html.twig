{% extends 'base.html.twig' %}

{% block title %}Rol: {{ role.name }} — CMS Orbis{% endblock %}
{% block page_title %}Detalle de Rol{% endblock %}

{% block header_actions %}
    <a href="{{ path('role_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-700">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="mb-4 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-sm text-amber-700">{{ message }}</div>
    {% endfor %}

    <div class="max-w-2xl space-y-4">

        {# ── Card de identidad del rol ─────────────────────────────────── #}
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">

            {# Header #}
            <div class="px-6 py-4 flex items-center justify-between" style="background: linear-gradient(135deg, #1e3585 0%, #2a4db5 100%);">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-white/20">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">{{ role.name }}</h2>
                        <p class="text-xs text-blue-200 font-mono mt-0.5">{{ role.id }}</p>
                    </div>
                </div>
                {% if role.status == 'active' %}
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold"
                          style="background: rgba(0,168,107,0.25); color: #00c882; border: 1px solid rgba(0,168,107,0.4);">Activo</span>
                {% else %}
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-white/60">Inactivo</span>
                {% endif %}
            </div>

            {# Acciones de estado #}
            <div class="px-6 py-3 flex items-center gap-3 border-b border-slate-100 bg-slate-50">
                {% if role.status == 'active' %}
                    <form method="POST" action="{{ path('role_deactivate', {id: role.id}) }}">
                        <button type="submit"
                                class="text-sm font-medium px-4 py-1.5 rounded-lg border transition-colors text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100"
                                onclick="return confirm('¿Desactivar el rol {{ role.name | e('js') }}?')">
                            Desactivar
                        </button>
                    </form>
                {% else %}
                    <form method="POST" action="{{ path('role_activate', {id: role.id}) }}">
                        <button type="submit"
                                class="text-sm font-medium px-4 py-1.5 rounded-lg border transition-colors text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100">
                            Activar
                        </button>
                    </form>
                {% endif %}
            </div>

            {# ── Editor de permisos ───────────────────────────────────── #}
            <div class="px-6 py-5">

                {# Barra superior: título + contador + accesos rápidos #}
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="#1e3585" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                        </svg>
                        Permisos
                        <span id="counter" class="text-xs font-normal text-gray-400">
                            {{ role.permissionIds | length }} de {{ permissions | length }} seleccionados
                        </span>
                    </h3>
                    {% if permissions is not empty %}
                        <div class="flex gap-3 text-xs">
                            <button type="button" onclick="toggleAll(true)" class="text-blue-600 hover:underline">Todos</button>
                            <span class="text-gray-300">|</span>
                            <button type="button" onclick="toggleAll(false)" class="text-gray-400 hover:underline">Ninguno</button>
                        </div>
                    {% endif %}
                </div>

                {% if permissions is not empty %}

                    {# Buscador #}
                    <div class="relative mb-3">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"
                             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                        </svg>
                        <input type="text" id="perm-search"
                               placeholder="Buscar permiso… ej: ticket, create, empleado"
                               class="w-full pl-9 pr-9 py-2 text-sm rounded-lg border border-gray-300 outline-none"
                               onfocus="this.style.borderColor='#1e3585'; this.style.boxShadow='0 0 0 3px rgba(30,53,133,0.12)'"
                               onblur="this.style.borderColor=''; this.style.boxShadow=''">
                        <button type="button" id="perm-search-clear"
                                onclick="clearSearch()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 hidden">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>

                    {# Mensaje sin resultados de búsqueda #}
                    <p id="no-results" class="hidden text-sm text-gray-400 italic py-4 text-center">
                        Sin resultados para tu búsqueda.
                    </p>

                    <form method="POST" action="{{ path('role_sync_permissions', {id: role.id}) }}">

                        {% set groups = {} %}
                        {% for permission in permissions %}
                            {% set parts = permission.key | split('.') %}
                            {% set resource = parts[0] %}
                            {% set groups = groups | merge({ (resource): (groups[resource] ?? []) | merge([permission]) }) %}
                        {% endfor %}

                        {% set resourceLabels = {
                            'user':           'Usuarios',
                            'role':           'Roles',
                            'permission':     'Permisos',
                            'employee':       'Empleados',
                            'client':         'Clientes',
                            'contact':        'Contactos',
                            'ticket':         'Tickets de servicio',
                            'expense':        'Gastos operativos',
                            'spare_part':     'Repuestos',
                            'warehouse':      'Almacenes y laboratorios',
                            'repair':         'Reparaciones',
                            'purchase_order': 'Órdenes de compra'
                        } %}

                        <div class="space-y-1.5" id="perm-groups">
                            {% for resource, group in groups %}
                                {# ¿Tiene algún permiso asignado? → abrir por defecto #}
                                {% set hasAssigned = false %}
                                {% for p in group %}
                                    {% if p.id in role.permissionIds %}{% set hasAssigned = true %}{% endif %}
                                {% endfor %}

                                <div class="perm-group border border-gray-200 rounded-lg overflow-hidden"
                                     data-resource="{{ resource }}"
                                     data-label="{{ (resourceLabels[resource] ?? resource) | lower }}">

                                    {# Cabecera del grupo (accordion trigger) #}
                                    <button type="button"
                                            class="group-header w-full flex items-center gap-2 px-4 py-2.5 bg-slate-50 hover:bg-slate-100 transition-colors text-left"
                                            data-group="{{ resource }}"
                                            onclick="toggleAccordion('{{ resource }}')">
                                        <input type="checkbox"
                                               id="group_{{ resource }}"
                                               class="rounded group-toggle shrink-0"
                                               data-group="{{ resource }}"
                                               style="accent-color: #1e3585;"
                                               onclick="event.stopPropagation()"
                                               onchange="toggleGroup('{{ resource }}', this.checked)">
                                        <span class="text-xs font-semibold text-gray-600 uppercase tracking-wide select-none flex-1">
                                            {{ resourceLabels[resource] ?? resource }}
                                        </span>
                                        <span class="group-badge text-xs text-gray-400 mr-2">
                                            <span class="group-checked-count" data-group="{{ resource }}">
                                                {{- loop.index0 -}}{# placeholder, JS lo rellena #}
                                            </span>
                                            / {{ group | length }}
                                        </span>
                                        <svg class="group-chevron w-4 h-4 text-gray-400 transition-transform shrink-0 {{ hasAssigned ? 'rotate-180' : '' }}"
                                             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                    </button>

                                    {# Permisos del grupo (colapsable) #}
                                    <div class="group-body {{ hasAssigned ? '' : 'hidden' }} divide-y divide-gray-100">
                                        {% for permission in group %}
                                            {% set isChecked = permission.id in role.permissionIds %}
                                            <label class="perm-row flex items-start gap-3 px-4 py-2.5 hover:bg-slate-50 cursor-pointer"
                                                   data-key="{{ permission.key }}"
                                                   data-desc="{{ permission.description | lower }}">
                                                <input type="checkbox"
                                                       name="permission_ids[]"
                                                       value="{{ permission.id }}"
                                                       class="mt-0.5 rounded perm-checkbox shrink-0"
                                                       data-group="{{ resource }}"
                                                       style="accent-color: #1e3585;"
                                                       {{ isChecked ? 'checked' : '' }}
                                                       onchange="syncGroupToggle('{{ resource }}'); updateCounter(); updateGroupCount('{{ resource }}')">
                                                <div class="min-w-0">
                                                    <p class="text-xs font-mono text-gray-500">{{ permission.key }}</p>
                                                    {% if permission.description %}
                                                        <p class="text-xs text-gray-700 mt-0.5">{{ permission.description }}</p>
                                                    {% endif %}
                                                </div>
                                            </label>
                                        {% endfor %}
                                    </div>

                                </div>
                            {% endfor %}
                        </div>

                        <div class="mt-5">
                            <button type="submit"
                                    class="text-white text-sm font-medium px-5 py-2.5 rounded-lg shadow-sm transition-all hover:shadow-md"
                                    style="background: #1e3585;"
                                    onmouseover="this.style.background='#152970'"
                                    onmouseout="this.style.background='#1e3585'">
                                Guardar permisos
                            </button>
                        </div>

                    </form>

                {% else %}
                    <div class="rounded-lg p-4 text-sm" style="background: #f8f9fc; border: 1px dashed #c5cde8;">
                        <p class="font-medium" style="color: #1e3585;">No hay permisos definidos en el sistema.</p>
                        <p class="text-xs mt-1 text-gray-400">
                            Ejecuta <code class="bg-gray-100 px-1 rounded">symfony console app:permissions:seed</code> para crear el catálogo.
                        </p>
                    </div>
                {% endif %}

            </div>
        </div>

    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    const totalPermissions = {{ permissions | length }};

    // ── Acordeón ──────────────────────────────────────────────────────────
    function toggleAccordion(resource) {
        const group = document.querySelector(`.perm-group[data-resource="${resource}"]`);
        if (!group) return;
        const body    = group.querySelector('.group-body');
        const chevron = group.querySelector('.group-chevron');
        body.classList.toggle('hidden');
        chevron.classList.toggle('rotate-180');
    }

    function openGroup(resource) {
        const group = document.querySelector(`.perm-group[data-resource="${resource}"]`);
        if (!group) return;
        group.querySelector('.group-body').classList.remove('hidden');
        group.querySelector('.group-chevron').classList.add('rotate-180');
    }

    function closeGroup(resource) {
        const group = document.querySelector(`.perm-group[data-resource="${resource}"]`);
        if (!group) return;
        group.querySelector('.group-body').classList.add('hidden');
        group.querySelector('.group-chevron').classList.remove('rotate-180');
    }

    // ── Selección ─────────────────────────────────────────────────────────
    function toggleGroup(resource, checked) {
        document.querySelectorAll(`.perm-checkbox[data-group="${resource}"]`)
            .forEach(cb => cb.checked = checked);
        updateCounter();
        updateGroupCount(resource);
    }

    function syncGroupToggle(resource) {
        const checkboxes = [...document.querySelectorAll(`.perm-checkbox[data-group="${resource}"]`)];
        const visible    = checkboxes.filter(cb => !cb.closest('.perm-row').classList.contains('hidden'));
        const allChecked = visible.length > 0 && visible.every(cb => cb.checked);
        const toggle     = document.querySelector(`#group_${resource}`);
        if (toggle) toggle.checked = allChecked;
    }

    function toggleAll(checked) {
        document.querySelectorAll('.perm-checkbox:not([style*="display:none"])')
            .forEach(cb => {
                if (!cb.closest('.perm-row').classList.contains('hidden')) {
                    cb.checked = checked;
                    updateGroupCount(cb.dataset.group);
                }
            });
        document.querySelectorAll('.group-toggle').forEach(cb => cb.checked = checked);
        updateCounter();
    }

    function updateCounter() {
        const checked = document.querySelectorAll('.perm-checkbox:checked').length;
        const counter = document.getElementById('counter');
        if (counter) counter.textContent = `${checked} de ${totalPermissions} seleccionados`;
    }

    function updateGroupCount(resource) {
        const total   = document.querySelectorAll(`.perm-checkbox[data-group="${resource}"]`).length;
        const checked = document.querySelectorAll(`.perm-checkbox[data-group="${resource}"]:checked`).length;
        const span    = document.querySelector(`.group-checked-count[data-group="${resource}"]`);
        if (span) span.textContent = `${checked}`;
        // Color del badge según si tiene alguno seleccionado
        const badge = span?.closest('.group-badge');
        if (badge) {
            badge.style.color = checked > 0 ? '#1e3585' : '';
            badge.style.fontWeight = checked > 0 ? '600' : '';
        }
    }

    // ── Buscador ──────────────────────────────────────────────────────────
    const searchInput = document.getElementById('perm-search');
    const clearBtn    = document.getElementById('perm-search-clear');
    const noResults   = document.getElementById('no-results');

    function applySearch(query) {
        const q = query.trim().toLowerCase();
        clearBtn.classList.toggle('hidden', q === '');
        let anyVisible = false;

        document.querySelectorAll('.perm-group').forEach(groupEl => {
            const resource = groupEl.dataset.resource;
            const label    = groupEl.dataset.label;
            let groupVisible = false;

            groupEl.querySelectorAll('.perm-row').forEach(row => {
                const key  = row.dataset.key  ?? '';
                const desc = row.dataset.desc ?? '';
                const match = q === '' || key.includes(q) || desc.includes(q) || label.includes(q) || resource.includes(q);
                row.classList.toggle('hidden', !match);
                if (match) groupVisible = true;
            });

            groupEl.classList.toggle('hidden', !groupVisible);

            if (groupVisible) {
                anyVisible = true;
                if (q !== '') openGroup(resource); // expandir al buscar
            }
        });

        noResults.classList.toggle('hidden', anyVisible);

        // Restaurar acordeón cuando se limpia la búsqueda
        if (q === '') {
            document.querySelectorAll('.perm-group').forEach(groupEl => {
                const resource = groupEl.dataset.resource;
                const hasChecked = [...groupEl.querySelectorAll('.perm-checkbox')].some(cb => cb.checked);
                if (!hasChecked) closeGroup(resource);
            });
        }

        document.querySelectorAll('.group-toggle').forEach(toggle => {
            syncGroupToggle(toggle.dataset.group);
        });
    }

    function clearSearch() {
        searchInput.value = '';
        applySearch('');
        searchInput.focus();
    }

    if (searchInput) {
        searchInput.addEventListener('input', e => applySearch(e.target.value));
    }

    // ── Init ──────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.group-toggle').forEach(toggle => {
            syncGroupToggle(toggle.dataset.group);
        });
        document.querySelectorAll('.perm-group').forEach(groupEl => {
            updateGroupCount(groupEl.dataset.resource);
        });
        updateCounter();
    });
    </script>
{% endblock %}
