<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar contraseña — CMS Orbis</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body class="bg-gray-100 text-gray-900 antialiased min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-sm">

        <div class="flex flex-col items-center mb-8">
            <div class="flex items-center gap-2 mb-2">
                <svg width="36" height="36" viewBox="0 0 32 32" fill="none">
                    <path d="M4 24 C8 14, 20 8, 30 10" stroke="#00a86b" stroke-width="3.5" stroke-linecap="round" fill="none"/>
                    <path d="M4 24 C10 20, 22 20, 30 10" stroke="#00c882" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
                </svg>
                <span class="text-2xl font-bold tracking-tight" style="color: #1e3585;">Orbis</span>
            </div>
            <p class="text-sm text-gray-500">CMS Business Solutions</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 px-8 py-8">

            <h1 class="text-lg font-semibold text-gray-800 mb-2">Recuperar contraseña</h1>
            <p class="text-sm text-gray-500 mb-6">Ingrese su correo electrónico y le enviaremos las instrucciones.</p>

            {% for message in app.flashes('success') %}
                <div class="mb-4 bg-green-50 border border-green-200 rounded-lg px-4 py-3">
                    <p class="text-sm text-green-700">{{ message }}</p>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="mb-4 bg-red-50 border border-red-200 rounded-lg px-4 py-3">
                    <p class="text-sm text-red-700">{{ message }}</p>
                </div>
            {% endfor %}

            <form id="forgot-password-form" class="space-y-4">
                <div>
                    <label for="email" class="block text-xs font-medium text-gray-700 mb-1">Correo electrónico</label>
                    <input id="email" type="email" name="email" required autofocus
                           class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2.5 focus:outline-none"
                           onfocus="this.style.boxShadow='0 0 0 3px rgba(30,53,133,0.15)'; this.style.borderColor='#1e3585';"
                           onblur="this.style.boxShadow=''; this.style.borderColor='';">
                </div>

                <button type="submit" id="forgot-password-btn"
                        class="w-full text-white text-sm font-semibold py-2.5 rounded-lg shadow-sm transition-all mt-2"
                        style="background: #1e3585;"
                        onmouseover="this.style.background='#152970'"
                        onmouseout="this.style.background='#1e3585'">
                    Enviar instrucciones
                </button>

                <div class="text-center mt-3">
                    <a href="{{ path('app_login') }}"
                       class="text-xs text-gray-500 hover:text-gray-700 hover:underline transition-colors">
                        Volver al inicio de sesión
                    </a>
                </div>
            </form>

            <script>
                document.getElementById('forgot-password-form').addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const btn = document.getElementById('forgot-password-btn');
                    btn.disabled = true;
                    btn.textContent = 'Enviando...';
                    try {
                        const resp = await fetch('{{ path('api_auth_forgot_password') }}', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ email: document.getElementById('email').value }),
                        });
                        const data = await resp.json();
                        if (resp.ok) {
                            this.innerHTML = '<div class="bg-green-50 border border-green-200 rounded-lg px-4 py-4 text-center"><p class="text-sm text-green-700 font-medium">Instrucciones enviadas</p><p class="text-xs text-green-600 mt-1">Revise su correo electrónico para restablecer su contraseña.</p></div>';
                        } else {
                            alert(data.error || 'Error al enviar instrucciones');
                            btn.disabled = false;
                            btn.textContent = 'Enviar instrucciones';
                        }
                    } catch (err) {
                        alert('Error de conexión. Intente nuevamente.');
                        btn.disabled = false;
                        btn.textContent = 'Enviar instrucciones';
                    }
                });
            </script>
        </div>

        <p class="text-center text-xs text-gray-400 mt-6">
            Ecuador © {{ "now"|date("Y") }} Orbis. Todos los derechos reservados.
        </p>
    </div>

</body>
</html>
