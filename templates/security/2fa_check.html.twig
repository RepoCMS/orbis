<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificación 2FA — CMS Orbis</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body class="bg-slate-100 text-gray-900 antialiased min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-sm">

        {# Marca #}
        <div class="flex flex-col items-center mb-8">
            <div class="flex items-center gap-2 mb-2">
                <svg width="36" height="36" viewBox="0 0 32 32" fill="none">
                    <path d="M4 24 C8 14, 20 8, 30 10" stroke="#00a86b" stroke-width="3.5" stroke-linecap="round" fill="none"/>
                    <path d="M4 24 C10 20, 22 20, 30 10" stroke="#00c882" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
                </svg>
                <span class="text-2xl font-bold tracking-tight" style="color: #1e3585;">Orbis</span>
            </div>
            <p class="text-sm text-gray-500">Verificación en dos pasos</p>
        </div>

        {# Card #}
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 px-8 py-8">

            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: #eef1f9;">
                    <svg class="w-5 h-5" fill="none" stroke="#1e3585" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-base font-semibold text-gray-800">Segundo factor</h1>
                    <p class="text-xs text-gray-500">Ingresa el código de tu aplicación autenticadora</p>
                </div>
            </div>

            {% if error is defined and error %}
                <div class="mb-4 bg-red-50 border border-red-200 rounded-lg px-4 py-3 flex items-start gap-2">
                    <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-sm text-red-700">{{ error }}</p>
                </div>
            {% endif %}

            <form method="POST" action="{{ path('mfa_check_submit') }}" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Código de 6 dígitos</label>
                    <input type="text" name="code"
                           inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                           autocomplete="one-time-code" autofocus required
                           placeholder="000000"
                           class="w-full rounded-lg border border-gray-300 text-center text-2xl tracking-[0.5em] font-mono py-3 px-3 focus:outline-none"
                           onfocus="this.style.boxShadow='0 0 0 3px rgba(30,53,133,0.15)'; this.style.borderColor='#1e3585';"
                           onblur="this.style.boxShadow=''; this.style.borderColor='';">
                    <p class="mt-1.5 text-xs text-gray-400 text-center">El código cambia cada 30 segundos</p>
                </div>
                <button type="submit"
                        class="w-full text-white text-sm font-semibold py-2.5 rounded-lg shadow-sm"
                        style="background: #1e3585;"
                        onmouseover="this.style.background='#152970'"
                        onmouseout="this.style.background='#1e3585'">
                    Verificar
                </button>
            </form>
        </div>

        <form method="POST" action="{{ path('app_logout') }}" class="text-center mt-4">
            <button type="submit" class="text-xs text-gray-400 hover:text-gray-600">Cerrar sesión y volver al login</button>
        </form>

    </div>

</body>
</html>
