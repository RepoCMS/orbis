{% extends 'base.html.twig' %}

{% block title %}Importar datos{% endblock %}
{% block page_title %}Importaci&oacute;n de datos &mdash; Inventario{% endblock %}

{% block body %}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {# ── Productos ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Importar productos</h2>
            <p class="text-sm text-gray-500 mb-4">
                Suba un archivo CSV o XLSX con los datos de productos.
                <a href="{{ path('inventory_import_template', { type: 'products' }) }}" class="text-blue-600 hover:text-blue-800 underline">
                    Descargar plantilla
                </a>
            </p>
            <form method="post" action="{{ path('inventory_import_products') }}" enctype="multipart/form-data">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Archivo</label>
                        <input type="file" name="file" accept=".csv,.xlsx" required
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="dry_run" id="dry_run_products" value="1"
                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        <label for="dry_run_products" class="text-sm text-gray-600">Solo previsualizar (dry run)</label>
                    </div>
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                            style="background: #1e3585;">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                        </svg>
                        Importar productos
                    </button>
                </div>
            </form>
        </div>

        {# ── Stock Serializado ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Importar stock serializado</h2>
            <p class="text-sm text-gray-500 mb-4">
                Suba un archivo CSV o XLSX con los datos de stock serializado.
                <a href="{{ path('inventory_import_template', { type: 'serialized-stock' }) }}" class="text-blue-600 hover:text-blue-800 underline">
                    Descargar plantilla
                </a>
            </p>
            <form method="post" action="{{ path('inventory_import_serialized') }}" enctype="multipart/form-data">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Archivo</label>
                        <input type="file" name="file" accept=".csv,.xlsx" required
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="dry_run" id="dry_run_serialized" value="1"
                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        <label for="dry_run_serialized" class="text-sm text-gray-600">Solo previsualizar (dry run)</label>
                    </div>
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                            style="background: #1e3585;">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                        </svg>
                        Importar stock serializado
                    </button>
                </div>
            </form>
        </div>

        {# ── Stock No Serializado ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Importar stock no serializado</h2>
            <p class="text-sm text-gray-500 mb-4">
                Suba un archivo CSV o XLSX con los datos de stock no serializado.
                <a href="{{ path('inventory_import_template', { type: 'nonserialized-stock' }) }}" class="text-blue-600 hover:text-blue-800 underline">
                    Descargar plantilla
                </a>
            </p>
            <form method="post" action="{{ path('inventory_import_nonserialized') }}" enctype="multipart/form-data">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Archivo</label>
                        <input type="file" name="file" accept=".csv,.xlsx" required
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="dry_run" id="dry_run_nonserialized" value="1"
                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        <label for="dry_run_nonserialized" class="text-sm text-gray-600">Solo previsualizar (dry run)</label>
                    </div>
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                            style="background: #1e3585;">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                        </svg>
                        Importar stock no serializado
                    </button>
                </div>
            </form>
        </div>

        {# ── Órdenes de Compra ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Importar &oacute;rdenes de compra</h2>
            <p class="text-sm text-gray-500 mb-4">
                Suba un archivo CSV o XLSX con los datos de &oacute;rdenes de compra.
                <a href="{{ path('inventory_import_template', { type: 'purchase-orders' }) }}" class="text-blue-600 hover:text-blue-800 underline">
                    Descargar plantilla
                </a>
            </p>
            <form method="post" action="{{ path('inventory_import_po') }}" enctype="multipart/form-data">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Archivo</label>
                        <input type="file" name="file" accept=".csv,.xlsx" required
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="dry_run" id="dry_run_po" value="1"
                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        <label for="dry_run_po" class="text-sm text-gray-600">Solo previsualizar (dry run)</label>
                    </div>
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                            style="background: #1e3585;">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                        </svg>
                        Importar &oacute;rdenes de compra
                    </button>
                </div>
            </form>
        </div>

    </div>
{% endblock %}
