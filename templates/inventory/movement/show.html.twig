{% extends 'base.html.twig' %}

{% block title %}Movimiento #{{ movement.id|slice(0,8) }}{% endblock %}
{% set tz = 'America/Guayaquil' %}
{% block page_title %}Detalle de movimiento{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_movement_list') }}"
       class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        ← Volver a movimientos
    </a>
{% endblock %}

{% block body %}
    {% if movement.status == 'in_transit' and is_granted('inventory.move_stock') %}
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-5 flex items-center justify-between">
        <div class="text-sm text-yellow-800">
            <strong>En tránsito</strong> — el stock está reservado en origen.
            {% if movement.assignedToUserId %}
                Asignado al destinatario.
            {% endif %}
        </div>
        <div class="flex gap-2">
            {% if canConfirm %}
            <div data-controller="modal">
                <button type="button"
                        data-action="modal#open"
                        class="px-4 py-2 rounded-lg text-sm font-medium text-white shadow-sm"
                        style="background: #1e3585;">
                    Confirmar recepción
                </button>

                <div data-modal-target="backdrop"
                     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
                     data-action="click->modal#closeBackdrop">
                    <div data-modal-target="content"
                         class="hidden bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Confirmar recepción</h3>
                        <p class="text-sm text-gray-600 mb-5">Se agregará el stock a la ubicación de destino.</p>
                        <form method="POST" action="{{ path('inventory_movement_confirm', {id: movement.id}) }}">
                            <div class="flex justify-end gap-3">
                                <button type="button"
                                        data-action="modal#close"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                                    Volver
                                </button>
                                <button type="submit"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-white shadow-sm"
                                        style="background: #1e3585;">
                                    Confirmar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if canReject %}
            <div data-controller="modal">
                <button type="button"
                        data-action="modal#open"
                        class="px-4 py-2 rounded-lg text-sm font-medium text-orange-700 bg-orange-50 border border-orange-200 hover:bg-orange-100">
                    Rechazar
                </button>

                <div data-modal-target="backdrop"
                     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
                     data-action="click->modal#closeBackdrop">
                    <div data-modal-target="content"
                         class="hidden bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Rechazar transferencia</h3>
                        <p class="text-sm text-gray-600 mb-1">Cantidad a devolver al origen:</p>
                        <form method="POST" action="{{ path('inventory_movement_reject', {id: movement.id}) }}">
                            <input type="number" name="reject_qty" min="1" max="{{ movement.quantity }}"
                                   value="{{ movement.quantity }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 mb-3">
                            <textarea name="reason" rows="3" required
                                      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
                                      placeholder="Motivo del rechazo…"></textarea>
                            <div class="flex justify-end gap-3 mt-4">
                                <button type="button"
                                        data-action="modal#close"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                                    Volver
                                </button>
                                <button type="submit"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-orange-600 hover:bg-orange-700">
                                    Rechazar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if canCancel %}
            <div data-controller="modal">
                <button type="button"
                        data-action="modal#open"
                        class="px-4 py-2 rounded-lg text-sm font-medium text-red-700 bg-red-50 border border-red-200 hover:bg-red-100">
                    Cancelar transferencia
                </button>

                <div data-modal-target="backdrop"
                     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
                     data-action="click->modal#closeBackdrop">
                    <div data-modal-target="content"
                         class="hidden bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Cancelar transferencia</h3>
                        <p class="text-sm text-gray-600 mb-5">El stock reservado volverá a la ubicación de origen.</p>
                        <form method="POST" action="{{ path('inventory_movement_cancel', {id: movement.id}) }}">
                            <div class="flex justify-end gap-3">
                                <button type="button"
                                        data-action="modal#close"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                                    Volver
                                </button>
                                <button type="submit"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700">
                                    Sí, cancelar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {% if movement.status == 'rejected' and movement.rejectionReason %}
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-5">
        <div class="flex gap-3">
            <div class="flex-1">
                <p class="text-sm font-medium text-red-800 mb-1">Rechazado</p>
                <p class="text-sm text-red-700">{{ movement.rejectionReason }}</p>
                {% if movement.rejectedAt %}
                <p class="text-xs text-red-500 mt-1">{{ movement.rejectedAt|date('d/m/Y H:i', tz) }}</p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 max-w-2xl">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 text-sm">
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Producto</dt>
                <dd class="text-gray-800">{{ movement.productName ?? movement.productId|slice(0,8)~'…' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Tipo</dt>
                <dd>
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full
                        {% if movement.type == 'entry' %}bg-green-100 text-green-700
                        {% elseif movement.type == 'exit' %}bg-red-100 text-red-700
                        {% else %}bg-blue-100 text-blue-700{% endif %}">
                        {{ movement.typeLabel }}
                    </span>
                </dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Estado</dt>
                <dd>
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full
                        {% if movement.status == 'completed' %}bg-green-100 text-green-700
                        {% elseif movement.status == 'cancelled' %}bg-red-100 text-red-700
                        {% elseif movement.status == 'rejected' %}bg-red-100 text-red-700
                        {% elseif movement.status == 'in_transit' %}bg-yellow-100 text-yellow-700
                        {% else %}bg-gray-100 text-gray-600{% endif %}">
                        {{ movement.statusLabel }}
                    </span>
                </dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Fecha</dt>
                <dd class="text-gray-700">{{ movement.createdAt|date('d/m/Y H:i', tz) }}</dd>
            </div>
            {% if movement.completedAt %}
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Completado</dt>
                <dd class="text-gray-700">{{ movement.completedAt|date('d/m/Y H:i', tz) }}</dd>
            </div>
            {% endif %}
            {% if movement.serializedStockId %}
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Stock serializado</dt>
                <dd class="font-mono text-gray-800">{{ movement.serializedStockId }}</dd>
            </div>
            {% endif %}
            {% if movement.serializedStockId is null and movement.quantity > 0 %}
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Cantidad</dt>
                <dd class="text-gray-800">{{ movement.quantity }} uds.</dd>
            </div>
            {% endif %}
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Ubicación origen</dt>
                {% if movement.sourceLocationName %}
                <dd class="text-gray-800">{{ movement.sourceLocationName }}<br><span class="font-mono text-xs text-gray-400">{{ movement.sourceLocationId|slice(0,8) }}…</span></dd>
                {% else %}
                <dd class="text-gray-400">(exterior)</dd>
                {% endif %}
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Ubicación destino</dt>
                {% if movement.destinationLocationName %}
                <dd class="text-gray-800">{{ movement.destinationLocationName }}<br><span class="font-mono text-xs text-gray-400">{{ movement.destinationLocationId|slice(0,8) }}…</span></dd>
                {% else %}
                <dd class="text-gray-400">(exterior)</dd>
                {% endif %}
            </div>
            {% if movement.notes %}
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Notas</dt>
                <dd class="text-gray-700">{{ movement.notes }}</dd>
            </div>
            {% endif %}
        </dl>
    </div>
{% endblock %}
