{% extends 'base.html.twig' %}

{% block title %}Movimiento #{{ movement.id|slice(0,8) }}{% endblock %}
{% block page_title %}Detalle de movimiento{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_movement_list') }}"
       class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        ← Volver a movimientos
    </a>
{% endblock %}

{% block body %}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 max-w-2xl">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 text-sm">
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">ID</dt>
                <dd class="font-mono text-gray-800 break-all">{{ movement.id }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Tipo</dt>
                <dd>
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full
                        {% if movement.type == 'ENTRY' %}bg-green-100 text-green-700
                        {% elseif movement.type == 'EXIT' %}bg-red-100 text-red-700
                        {% else %}bg-blue-100 text-blue-700{% endif %}">
                        {{ movement.typeLabel }}
                    </span>
                </dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Estado</dt>
                <dd>
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full
                        {% if movement.status == 'COMPLETED' %}bg-green-100 text-green-700
                        {% elseif movement.status == 'CANCELLED' %}bg-red-100 text-red-700
                        {% elseif movement.status == 'IN_TRANSIT' %}bg-yellow-100 text-yellow-700
                        {% else %}bg-slate-100 text-slate-600{% endif %}">
                        {{ movement.statusLabel }}
                    </span>
                </dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Fecha</dt>
                <dd class="text-gray-700">{{ movement.createdAt|date('d/m/Y H:i') }}</dd>
            </div>
            {% if movement.serializedStockId %}
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Stock serializado</dt>
                <dd class="font-mono text-gray-800">{{ movement.serializedStockId }}</dd>
            </div>
            {% endif %}
            {% if movement.nonserializedStockId %}
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Stock no serializado</dt>
                <dd class="font-mono text-gray-800">{{ movement.nonserializedStockId }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Cantidad</dt>
                <dd class="text-gray-800">{{ movement.quantity }}</dd>
            </div>
            {% endif %}
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Ubicación origen</dt>
                <dd class="font-mono text-gray-700">{{ movement.sourceLocationId ?? '(exterior)' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Ubicación destino</dt>
                <dd class="font-mono text-gray-700">{{ movement.destinationLocationId ?? '(exterior)' }}</dd>
            </div>
            {% if movement.notes %}
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Notas</dt>
                <dd class="text-gray-700">{{ movement.notes }}</dd>
            </div>
            {% endif %}
        </dl>
    </div>
{% endblock %}
