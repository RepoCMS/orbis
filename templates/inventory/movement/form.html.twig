{% extends 'base.html.twig' %}

{% block title %}Nueva transferencia{% endblock %}
{% block page_title %}Nueva Transferencia de Stock{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_movement_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-2xl">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('inventory_movement_create') }}" novalidate>
                <div class="space-y-5">

                    <div>
                        <label for="destinationLocationId" class="block text-sm font-medium text-gray-700 mb-1">
                            Ubicación destino <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="destinationLocationId" name="destinationLocationId"
                               value="{{ input.destinationLocationId ?? '' }}"
                               maxlength="26"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ULID de la ubicación destino"
                               required autocomplete="off">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Items a transferir <span class="text-red-500">*</span>
                        </label>
                        <div id="items-container" class="space-y-3">
                            <div class="item-row border border-gray-200 rounded-lg p-4 space-y-3">
                                <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                                    <div>
                                        <label class="block text-xs font-medium text-gray-500 mb-1">Tipo</label>
                                        <select name="items[0][type]" required
                                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                                onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''">
                                            <option value="serialized" {{ input.items[0].type == 'serialized' ? 'selected' : '' }}>Serializado</option>
                                            <option value="nonserialized" {{ input.items[0].type == 'nonserialized' ? 'selected' : '' }}>No serializado</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-500 mb-1">Stock ID</label>
                                        <input type="text" name="items[0][stockId]"
                                               value="{{ input.items[0].stockId ?? '' }}"
                                               maxlength="26"
                                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                               placeholder="ULID del stock" required autocomplete="off">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-500 mb-1">Producto ID</label>
                                        <input type="text" name="items[0][productId]"
                                               value="{{ input.items[0].productId ?? '' }}"
                                               maxlength="26"
                                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                               placeholder="ULID del producto" required autocomplete="off">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-500 mb-1">Cantidad</label>
                                        <input type="number" name="items[0][quantity]"
                                               value="{{ input.items[0].quantity ?? 1 }}" min="1"
                                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
                        <textarea id="notes" name="notes" rows="3"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none resize-none"
                                  onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                  style="transition: border-color .15s;"
                                  placeholder="Observaciones...">{{ input.notes ?? '' }}</textarea>
                    </div>

                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="px-5 py-2 text-sm font-medium text-white rounded-lg shadow-sm"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        Crear transferencia
                    </button>
                    <a href="{{ path('inventory_movement_list') }}"
                       class="px-4 py-2 text-sm font-medium text-gray-600 rounded-lg border border-gray-200 hover:bg-gray-50">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
