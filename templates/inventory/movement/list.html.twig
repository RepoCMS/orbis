{% extends 'base.html.twig' %}

{% block title %}Movimientos de stock{% endblock %}
{% block page_title %}Movimientos de stock{% endblock %}
{% set tz = 'America/Guayaquil' %}

{% block header_actions %}
    {% if is_granted('inventory.move_stock') %}
    <a href="{{ path('inventory_movement_form') }}"
       class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm flex items-center gap-1.5"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        Nuevo movimiento
    </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% if movements is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <svg class="w-12 h-12 mb-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 3M21 7.5H7.5"/>
            </svg>
            <p class="text-sm font-medium text-gray-600">No hay movimientos registrados.</p>
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Tipo</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Estado</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden md:table-cell">Stock</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden md:table-cell">Origen → Destino</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden lg:table-cell">Fecha</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Detalle</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for movement in movements %}
                        <tr class="hover:bg-gray-50/60 transition-colors">
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                                    {% if movement.type == 'entry' %}bg-green-100 text-green-700
                                    {% elseif movement.type == 'exit' %}bg-red-100 text-red-700
                                    {% else %}bg-blue-100 text-blue-700{% endif %}">
                                    {{ movement.typeLabel }}
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                                    {% if movement.status == 'completed' %}bg-green-100 text-green-700
                                    {% elseif movement.status == 'cancelled' %}bg-red-100 text-red-700
                                    {% elseif movement.status == 'rejected' %}bg-red-100 text-red-700
                                    {% elseif movement.status == 'in_transit' %}bg-yellow-100 text-yellow-700
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ movement.statusLabel }}
                                </span>
                            </td>
                            <td class="px-4 py-3 hidden md:table-cell text-xs text-gray-600">
                                <span class="font-medium text-gray-800">{{ movement.productName ?? movement.productId|slice(0,8)~'…' }}</span>
                                {% if movement.serializedStockId %}
                                <br><span class="font-mono text-gray-400">{{ movement.serializedStockId|slice(0,10) }}…</span>
                                {% elseif movement.quantity > 1 %}
                                <br><span class="text-gray-400">{{ movement.quantity }} uds.</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 hidden md:table-cell text-gray-600">
                                <span class="text-gray-800">{{ movement.sourceLocationName ?? (movement.sourceLocationId ? movement.sourceLocationId|slice(0,8)~'…' : '(exterior)') }}</span>
                                →
                                <span class="text-gray-800">{{ movement.destinationLocationName ?? (movement.destinationLocationId ? movement.destinationLocationId|slice(0,8)~'…' : '(exterior)') }}</span>
                            </td>
                            <td class="px-4 py-3 hidden lg:table-cell text-gray-500 text-xs">
                                {{ movement.createdAt|date('d/m/Y H:i', tz) }}
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a href="{{ path('inventory_movement_show', {id: movement.id}) }}"
                                   class="text-xs font-medium text-blue-600 hover:underline">Ver</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
