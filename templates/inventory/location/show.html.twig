{% extends 'base.html.twig' %}

{% block title %}{{ location.name }}{% endblock %}
{% block page_title %}{{ location.name }}{% endblock %}

{% block header_actions %}
    <div class="flex items-center gap-2">
        {% if is_granted('inventory.update') %}
        <a href="{{ path('inventory_location_edit', {id: location.id}) }}"
           class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-slate-200 text-gray-600 hover:bg-slate-50 transition-colors">
            Editar
        </a>
        {% endif %}
        <a href="{{ path('inventory_location_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Volver
        </a>
    </div>
{% endblock %}

{% block body %}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div>
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Nombre</dt>
                <dd class="text-sm font-medium text-gray-900">{{ location.name }}</dd>
            </div>
            <div>
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Tipo</dt>
                <dd>
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full
                        {% if location.type == 'warehouse' %}bg-blue-100 text-blue-700
                        {% elseif location.type == 'laboratory' %}bg-purple-100 text-purple-700
                        {% else %}bg-gray-100 text-gray-600{% endif %}">
                        {{ location.typeLabel }}
                    </span>
                </dd>
            </div>
            <div>
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Ciudad</dt>
                <dd class="text-sm text-gray-700">{{ location.city }}</dd>
            </div>
            <div>
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Dirección</dt>
                <dd class="text-sm text-gray-700">{{ location.address ?: '—' }}</dd>
            </div>
        </dl>
    </div>
{% endblock %}
