{% extends 'base.html.twig' %}

{% block title %}Ubicaciones{% endblock %}
{% block page_title %}Gestión de Ubicaciones{% endblock %}

{% block header_actions %}
    {% if is_granted('inventory.create') %}
    <a href="{{ path('inventory_location_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nueva ubicación
    </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% if locations is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <svg class="w-12 h-12 mb-3 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            <p class="text-sm font-medium text-gray-600">No hay ubicaciones registradas.</p>
            {% if is_granted('inventory.create') %}
            <a href="{{ path('inventory_location_new') }}"
               class="mt-4 inline-flex items-center text-white text-sm font-medium px-4 py-2 rounded-lg"
               style="background: #1e3585;">Crear ubicación</a>
            {% endif %}
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Nombre</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Tipo</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden md:table-cell">Ciudad</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden lg:table-cell">Dirección</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for location in locations %}
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-3 font-medium text-gray-900">
                                <a href="{{ path('inventory_location_show', {id: location.id}) }}"
                                   class="hover:text-blue-700 transition-colors">{{ location.name }}</a>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                                    {% if location.type == 'warehouse' %}bg-blue-100 text-blue-700
                                    {% elseif location.type == 'laboratory' %}bg-purple-100 text-purple-700
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ location.typeLabel }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-gray-500 hidden md:table-cell">{{ location.city }}</td>
                            <td class="px-4 py-3 text-gray-500 hidden lg:table-cell truncate max-w-xs">{{ location.address }}</td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex justify-end gap-2">
                                    {% if is_granted('inventory.update') %}
                                    <a href="{{ path('inventory_location_edit', {id: location.id}) }}"
                                       class="text-xs px-3 py-1.5 rounded-lg border border-slate-200 text-gray-600 hover:bg-slate-100 transition-colors">
                                        Editar
                                    </a>
                                    {% endif %}
                                    {% if is_granted('inventory.delete') %}
                                    <form method="POST" action="{{ path('inventory_location_delete', {id: location.id}) }}"
                                          onsubmit="return confirm('¿Eliminar esta ubicación?')">
                                        <button type="submit"
                                                class="text-xs px-3 py-1.5 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 transition-colors">
                                            Eliminar
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
