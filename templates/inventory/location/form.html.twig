{% extends 'base.html.twig' %}

{% set isEdit = location is defined %}
{% block title %}{{ isEdit ? 'Editar ubicación' : 'Nueva ubicación' }}{% endblock %}
{% block page_title %}{{ isEdit ? 'Editar ubicación' : 'Nueva ubicación' }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_location_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-lg">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST"
                  action="{{ isEdit ? path('inventory_location_update', {id: location.id}) : path('inventory_location_create') }}"
                  novalidate>

                <div class="space-y-5">

                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                            Nombre <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="name" name="name"
                               value="{{ input.name ?? '' }}"
                               maxlength="200"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ej: Bodega Central Guayaquil"
                               required autocomplete="off">
                    </div>

                    <div>
                        <label for="type" class="block text-sm font-medium text-gray-700 mb-1">
                            Tipo <span class="text-red-500">*</span>
                        </label>
                        <select id="type" name="type" required
                                {% if isEdit %}disabled{% endif %}
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white outline-none"
                                onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                style="transition: border-color .15s;">
                            <option value="">— Seleccionar —</option>
                            {% for type in types %}
                            <option value="{{ type.value }}"
                                    {% if (input.type ?? '') == type.value %}selected{% endif %}>
                                {% if type.value == 'warehouse' %}Almacén
                                {% elseif type.value == 'laboratory' %}Laboratorio
                                {% elseif type.value == 'backpack' %}Mochila
                                {% elseif type.value == 'custody' %}Custodia
                                {% endif %}
                            </option>
                            {% endfor %}
                        </select>
                        {% if isEdit %}
                            <p class="mt-1 text-xs text-gray-400">El tipo no puede modificarse.</p>
                        {% endif %}
                    </div>

                    <div>
                        <label for="city" class="block text-sm font-medium text-gray-700 mb-1">
                            Ciudad <span class="text-red-500">*</span>
                        </label>
                        {% if cities is not empty %}
                            <select id="city" name="city" required
                                    class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white outline-none"
                                    onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                    style="transition: border-color .15s;">
                                <option value="">— Seleccionar ciudad —</option>
                                {% for city in cities %}
                                    <option value="{{ city.name }}"
                                            {% if (input.city ?? '') == city.name %}selected{% endif %}>
                                        {{ city.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% else %}
                            <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
                                <div class="flex items-start gap-3">
                                    <svg class="w-5 h-5 shrink-0 mt-0.5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                                    </svg>
                                    <div class="text-sm">
                                        <p class="font-medium text-amber-800">Ciudades no disponibles</p>
                                        <p class="text-amber-700 mt-0.5">Debe cargar las ciudades primero (consola: <code class="text-amber-800 text-xs bg-amber-100 px-1 py-0.5 rounded">php bin/console app:geography:seed</code>).</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="address" class="block text-sm font-medium text-gray-700 mb-1">
                            Dirección
                        </label>
                        <input type="text" id="address" name="address"
                               value="{{ input.address ?? '' }}"
                               maxlength="300"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ej: Av. Carlos Julio Arosemena Km 2"
                               autocomplete="off">
                    </div>

                    <div>
                        <label for="employee_id" class="block text-sm font-medium text-gray-700 mb-1">
                            Responsable <span class="text-red-500">*</span>
                        </label>
                        <select id="employee_id" name="employee_id" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white outline-none"
                                onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                style="transition: border-color .15s;">
                            <option value="">— Seleccionar responsable —</option>
                            {% for employee in employees %}
                            <option value="{{ employee.id }}"
                                    {% if (input.employee_id ?? '') == employee.id %}selected{% endif %}>
                                {{ employee.fullName }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="px-5 py-2 text-sm font-medium text-white rounded-lg shadow-sm transition-all"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        {{ isEdit ? 'Guardar cambios' : 'Crear ubicación' }}
                    </button>
                    <a href="{{ path('inventory_location_list') }}"
                       class="px-4 py-2 text-sm font-medium text-gray-600 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
