{% extends 'base.html.twig' %}

{% block title %}Solicitud {{ stockRequest.reference }}{% endblock %}
{% block page_title %}Solicitud {{ stockRequest.reference }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_request_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="space-y-6">

        {# Datos generales #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-start justify-between mb-4">
                <h2 class="text-sm font-semibold text-gray-700">Detalle de la solicitud</h2>
                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                    {% if stockRequest.status == 'pending' %}bg-yellow-100 text-yellow-700
                    {% elseif stockRequest.status == 'approved' %}bg-blue-100 text-blue-700
                    {% elseif stockRequest.status == 'awaiting_technician_acceptance' %}bg-purple-100 text-purple-700
                    {% elseif stockRequest.status == 'partially_fulfilled' %}bg-amber-100 text-amber-700
                    {% elseif stockRequest.status == 'fulfilled' %}bg-green-100 text-green-700
                    {% elseif stockRequest.status == 'rejected' %}bg-red-100 text-red-700
                    {% elseif stockRequest.status == 'cancelled' %}bg-gray-100 text-gray-500
                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                    {{ stockRequest.statusLabel }}
                </span>
            </div>
            <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Referencia</dt>
                    <dd class="text-sm font-mono font-medium text-gray-900">{{ stockRequest.reference }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Solicitado por</dt>
                    <dd class="text-sm text-gray-700">{{ stockRequest.requestedByName }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Fecha</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.createdAt }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Origen</dt>
                    <dd class="text-sm text-gray-700">{{ stockRequest.sourceLocationName }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Destino</dt>
                    <dd class="text-sm text-gray-700">{{ stockRequest.destinationLocationName }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Items</dt>
                    <dd class="text-sm text-gray-700">{{ stockRequest.fulfilledItemsCount }}/{{ stockRequest.fulfilledItemsCount + stockRequest.pendingItemsCount }} despachados</dd>
                </div>
                {% if stockRequest.notes %}
                <div class="sm:col-span-2 lg:col-span-3">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Notas</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.notes }}</dd>
                </div>
                {% endif %}
            </dl>
        </div>

        {# Tabla de items #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Items de la solicitud</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Producto</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Cantidad</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Serial</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Estado</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden lg:table-cell">Movement</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for item in stockRequest.items %}
                        <tr class="hover:bg-gray-50/60 transition-colors">
                            <td class="px-4 py-3 text-gray-700">{{ item.productName }}</td>
                            <td class="px-4 py-3 text-gray-700">{{ item.quantity }}</td>
                            <td class="px-4 py-3 font-mono text-xs text-gray-500">
                                {{ item.serializedStockId ?? '-' }}
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                                    {% if item.status == 'pending' %}bg-yellow-100 text-yellow-700
                                    {% elseif item.status == 'fulfilled' %}bg-green-100 text-green-700
                                    {% elseif item.status == 'cancelled' %}bg-gray-100 text-gray-500
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ item.statusLabel }}
                                </span>
                            </td>
                            <td class="px-4 py-3 hidden lg:table-cell font-mono text-xs text-gray-500">
                                {{ item.fulfilledMovementId ?? '-' }}
                            </td>
                            <td class="px-4 py-3 text-right">
                                {% if stockRequest.status in ['approved', 'awaiting_technician_acceptance'] and item.status == 'pending' and is_granted('inventory.update') %}
                                <form method="POST" action="{{ path('inventory_request_fulfill_item', {id: stockRequest.id, itemId: item.id}) }}" class="inline">
                                    <button type="submit"
                                            class="text-xs px-3 py-1.5 rounded-lg border border-blue-200 text-blue-700 hover:bg-blue-50 transition-colors">
                                        Despachar
                                    </button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Historial de aprobación/rechazo #}
        {% if stockRequest.approvedAt or stockRequest.rejectedAt %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Historial</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% if stockRequest.approvedAt %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Aprobado por</dt>
                    <dd class="text-sm text-gray-700">{{ stockRequest.approvedByName }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Aprobado el</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.approvedAt }}</dd>
                </div>
                {% endif %}
                {% if stockRequest.rejectedAt %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Rechazado por</dt>
                    <dd class="text-sm text-gray-700">{{ stockRequest.rejectedByName }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Rechazado el</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.rejectedAt }}</dd>
                </div>
                {% if stockRequest.rejectionReason %}
                <div class="sm:col-span-2 lg:col-span-3">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Motivo de rechazo</dt>
                    <dd class="text-sm text-red-700">{{ stockRequest.rejectionReason }}</dd>
                </div>
                {% endif %}
                {% endif %}
            </dl>
        </div>
        {% endif %}

        {# Acciones #}
        {% if is_granted('inventory.update') or is_granted('spare_part.request') %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Acciones</h2>
            <div class="flex flex-wrap gap-3">

                {% if stockRequest.status == 'pending' and is_granted('inventory.update') %}
                <form method="POST" action="{{ path('inventory_request_approve', {id: stockRequest.id}) }}">
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm bg-green-600 hover:bg-green-700 transition-colors">
                        Aprobar
                    </button>
                </form>

                <button type="button" onclick="openModal('modal-reject-request')"
                        class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm bg-red-600 hover:bg-red-700 transition-colors">
                    Rechazar
                </button>
                {% endif %}

                {% if stockRequest.status == 'pending' and (is_granted('inventory.update') or is_granted('spare_part.request')) %}
                <button type="button" onclick="openModal('modal-cancel-request')"
                        class="px-4 py-2 text-sm font-medium rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                    Cancelar solicitud
                </button>
                {% endif %}

            </div>
        </div>
        {% endif %}

    </div>

    {% if stockRequest.status == 'pending' %}
    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-reject-request',
        title: 'Rechazar solicitud',
        message: '¿Está seguro de rechazar esta solicitud? Indique el motivo.',
        action: path('inventory_request_reject', {id: stockRequest.id}),
        confirmText: 'Rechazar',
        confirmStyle: 'red',
    } %}
    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-cancel-request',
        title: 'Cancelar solicitud',
        message: '¿Cancelar esta solicitud?',
        action: path('inventory_request_cancel', {id: stockRequest.id}),
        confirmText: 'Cancelar solicitud',
        confirmStyle: 'red',
    } %}
    {% endif %}
{% endblock %}
