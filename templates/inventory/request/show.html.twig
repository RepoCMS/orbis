{% extends 'base.html.twig' %}

{% block title %}Solicitud {{ stockRequest.reference }}{% endblock %}
{% block page_title %}Solicitud {{ stockRequest.reference }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_request_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="space-y-6">

        {# Datos generales #}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <div class="flex items-start justify-between mb-4">
                <h2 class="text-sm font-semibold text-gray-700">Detalle de la solicitud</h2>
                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                    {% if stockRequest.status == 'pending' %}bg-yellow-100 text-yellow-700
                    {% elseif stockRequest.status == 'approved' %}bg-blue-100 text-blue-700
                    {% elseif stockRequest.status == 'fulfilled' %}bg-green-100 text-green-700
                    {% elseif stockRequest.status == 'rejected' %}bg-red-100 text-red-700
                    {% elseif stockRequest.status == 'cancelled' %}bg-gray-100 text-gray-500
                    {% else %}bg-slate-100 text-slate-600{% endif %}">
                    {{ stockRequest.statusLabel }}
                </span>
            </div>
            <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Referencia</dt>
                    <dd class="text-sm font-mono font-medium text-gray-900">{{ stockRequest.reference }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Solicitado por</dt>
                    <dd class="text-sm text-gray-700 font-mono text-xs">{{ stockRequest.requestedBy }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Fecha</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.createdAt }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Producto</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.productId }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Cantidad</dt>
                    <dd class="text-sm font-semibold text-gray-900">{{ stockRequest.quantity }}</dd>
                </div>
                {% if stockRequest.serializedStockId %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Stock serializado</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.serializedStockId }}</dd>
                </div>
                {% endif %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Origen</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.sourceLocationId }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Destino</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.destinationLocationId }}</dd>
                </div>
                {% if stockRequest.notes %}
                <div class="sm:col-span-2 lg:col-span-3">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Notas</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.notes }}</dd>
                </div>
                {% endif %}
            </dl>
        </div>

        {# Historial de aprobación/rechazo #}
        {% if stockRequest.approvedAt or stockRequest.rejectedAt or stockRequest.fulfilledMovementId %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Historial</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% if stockRequest.approvedAt %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Aprobado por</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.approvedBy }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Aprobado el</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.approvedAt }}</dd>
                </div>
                {% endif %}
                {% if stockRequest.rejectedAt %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Rechazado por</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.rejectedBy }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Rechazado el</dt>
                    <dd class="text-sm text-gray-600">{{ stockRequest.rejectedAt }}</dd>
                </div>
                {% if stockRequest.rejectionReason %}
                <div class="sm:col-span-2 lg:col-span-3">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Motivo de rechazo</dt>
                    <dd class="text-sm text-red-700">{{ stockRequest.rejectionReason }}</dd>
                </div>
                {% endif %}
                {% endif %}
                {% if stockRequest.fulfilledMovementId %}
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Movimiento generado</dt>
                    <dd class="text-sm font-mono text-xs text-gray-700">{{ stockRequest.fulfilledMovementId }}</dd>
                </div>
                {% endif %}
            </dl>
        </div>
        {% endif %}

        {# Acciones #}
        {% if is_granted('inventory.update') %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Acciones</h2>
            <div class="flex flex-wrap gap-3">

                {% if stockRequest.status == 'pending' %}
                {# Aprobar #}
                <form method="POST" action="{{ path('inventory_request_approve', {id: stockRequest.id}) }}">
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm bg-green-600 hover:bg-green-700 transition-colors">
                        Aprobar
                    </button>
                </form>

                {# Rechazar #}
                <form method="POST" action="{{ path('inventory_request_reject', {id: stockRequest.id}) }}"
                      onsubmit="var r = prompt('Motivo del rechazo:'); if(!r){return false;} this.querySelector('[name=reason]').value=r;">
                    <input type="hidden" name="reason" value="">
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm bg-red-600 hover:bg-red-700 transition-colors">
                        Rechazar
                    </button>
                </form>
                {% endif %}

                {% if stockRequest.status == 'pending' %}
                {# Cancelar (solo el propio solicitante, o admin) #}
                <form method="POST" action="{{ path('inventory_request_cancel', {id: stockRequest.id}) }}"
                      onsubmit="return confirm('¿Cancelar esta solicitud?')">
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium rounded-lg border border-slate-200 text-gray-600 hover:bg-slate-50 transition-colors">
                        Cancelar
                    </button>
                </form>
                {% endif %}

                {% if stockRequest.status == 'approved' %}
                {# Ejecutar traslado #}
                <form method="POST" action="{{ path('inventory_request_fulfill', {id: stockRequest.id}) }}"
                      onsubmit="return confirm('¿Confirmar ejecución del traslado de stock?')">
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm bg-blue-600 hover:bg-blue-700 transition-colors">
                        Ejecutar traslado
                    </button>
                </form>
                {% endif %}

            </div>
        </div>
        {% endif %}

    </div>
{% endblock %}
