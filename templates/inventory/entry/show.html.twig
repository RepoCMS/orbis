{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Entrada: {{ entry.reference }}{% endblock %}

{% block page_title %}Entrada: {{ entry.reference }}{% endblock %}

{% set confirmEntryAction = is_granted('inventory.create') and entry.status == 'draft' ? path('inventory_entry_confirm', {id: entry.id}) : '' %}
{% set cancelEntryAction = is_granted('inventory.update') and entry.status == 'draft' ? path('inventory_entry_cancel', {id: entry.id}) : '' %}
{% block header_actions %}
    <div class="flex items-center gap-2">
        {% if is_granted('inventory.update') and entry.status == 'draft' %}
        <button type="button" onclick="openModal('modal-edit-entry')"
                class="text-sm font-medium px-3 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50">
            Editar
        </button>
        {% endif %}
        {% if confirmEntryAction %}
        <form method="POST" action="{{ confirmEntryAction }}"
              onsubmit="return false;" onclick="event.preventDefault(); openModal('modal-confirm-entry')">
            <button type="submit"
                    class="text-sm font-medium px-4 py-2 rounded-lg text-white"
                    style="background: #00a86b;" onmouseover="this.style.background='#009060'" onmouseout="this.style.background='#00a86b'">
                Confirmar entrada
            </button>
        </form>
        {% endif %}
        {% if cancelEntryAction %}
        <form method="POST" action="{{ cancelEntryAction }}"
              onsubmit="return false;" onclick="event.preventDefault(); openModal('modal-cancel-entry')">
            <button type="submit"
                    class="text-sm font-medium px-3 py-2 rounded-lg border border-red-200 text-red-600 hover:bg-red-50">
                Cancelar
            </button>
        </form>
        {% endif %}
        <a href="{{ path('inventory_entry_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Volver
        </a>
    </div>
{% endblock %}

{% block body %}
    <div class="space-y-6">
        {# Cabecera #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Referencia</dt>
                    <dd class="text-sm font-medium text-gray-900">{{ entry.reference }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Estado</dt>
                    <dd>
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full
                            {% if entry.status == 'draft' %}bg-yellow-100 text-yellow-700
                            {% elseif entry.status == 'confirmed' %}bg-green-100 text-green-700
                            {% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ entry.statusLabel }}
                        </span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Creado</dt>
                    <dd class="text-sm text-gray-600">{{ entry.createdAt }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Confirmado</dt>
                    <dd class="text-sm text-gray-600">{{ entry.confirmedAt ?: '&mdash;' }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Costo total</dt>
                    <dd class="text-sm font-mono text-gray-900">{{ entry.totalCost is not null ? '$ ' ~ entry.totalCost : '&mdash;' }}</dd>
                </div>
            </dl>
            {% if entry.notes %}
            <div class="mt-4 pt-4 border-t border-gray-100">
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Notas</dt>
                <dd class="text-sm text-gray-600">{{ entry.notes }}</dd>
            </div>
            {% endif %}
        </div>

        {# Items #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-100">
                <h2 class="text-sm font-semibold text-gray-700">Items recibidos</h2>
            </div>

            {% if items is not empty %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Producto</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Tipo</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">N. Serie</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Cant.</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">OC</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden md:table-cell">Ubicacion</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Costo unit.</th>
                            {% if entry.status == 'draft' and is_granted('inventory.update') %}
                            <th class="px-4 py-3 w-10"></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for item in items %}
                        <tr class="hover:bg-gray-50/60">
                            <td class="px-4 py-2.5 text-gray-700 text-xs font-mono">{{ item.productId }}</td>
                            <td class="px-4 py-2.5">
                                <span class="text-xs font-medium px-2 py-0.5 rounded-full
                                    {% if item.serialized %}bg-blue-100 text-blue-700{% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ item.serialized ? 'Serializado' : 'No serializado' }}
                                </span>
                            </td>
                            <td class="px-4 py-2.5 font-mono text-xs text-gray-600">
                                {{ item.serialized ? item.serialNumber : '&mdash;' }}
                            </td>
                            <td class="px-4 py-2.5 text-xs text-right font-mono text-gray-700">
                                {{ item.quantity }}
                            </td>
                            <td class="px-4 py-2.5 text-xs text-gray-600">
                                {% if item.purchaseOrderItemId and itemPoRefMap[item.purchaseOrderItemId] is defined %}
                                    {{ itemPoRefMap[item.purchaseOrderItemId] }}
                                {% else %}
                                    <span class="text-gray-300">&mdash;</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2.5 text-gray-500 text-xs hidden md:table-cell">{{ item.locationId }}</td>
                            <td class="px-4 py-2.5 text-xs text-right text-gray-700 font-mono">
                                {{ item.unitCost is not null ? '$ ' ~ item.unitCost : '&mdash;' }}
                            </td>
                            {% if entry.status == 'draft' and is_granted('inventory.update') %}
                            <td class="px-4 py-2.5 text-right">
                                <form method="POST" action="{{ path('inventory_entry_remove_item', {id: entry.id, itemId: item.id}) }}"
                                      onsubmit="return confirm('&iquest;Eliminar este item de la entrada?')">
                                    <button type="submit" class="text-red-400 hover:text-red-600 transition-colors" title="Eliminar item">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                        </svg>
                                    </button>
                                </form>
                            </td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            {# Agregar item (solo en draft) #}
            {% if is_granted('inventory.create') and entry.status == 'draft' %}
            <div class="px-6 py-4 border-t border-gray-100">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Agregar item</h3>

                {# Orden de compra vinculada (fija si entry tiene purchaseOrderId, sino selector) #}
                {% if entry.purchaseOrderId %}
                <div class="mb-4 pb-4 border-b border-gray-100">
                    <span class="text-xs font-medium text-gray-500">Orden de compra vinculada:</span>
                    <span class="text-sm font-semibold text-gray-700 ml-2">
                        {% for po in purchaseOrders %}
                            {% if po.id == entry.purchaseOrderId %}{{ po.reference }}{% endif %}
                        {% endfor %}
                    </span>
                    <input type="hidden" name="po" value="{{ entry.purchaseOrderId }}">
                </div>
                {% else %}
                <form method="GET" action="{{ path('inventory_entry_show', {id: entry.id}) }}"
                      class="flex flex-wrap items-end gap-3 mb-4 pb-4 border-b border-gray-100">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Orden de compra <span class="text-red-500">*</span></label>
                        <select name="po" onchange="this.form.submit()" required
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400/30">
                            <option value="">&mdash; Seleccionar OC &mdash;</option>
                            {% for po in purchaseOrders %}
                            <option value="{{ po.id }}" {{ selectedPoId == po.id ? 'selected' : '' }}>
                                {{ po.reference }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
                {% endif %}

                <form method="POST" action="{{ path('inventory_entry_add_item', {id: entry.id}) }}"
                      class="flex flex-wrap items-end gap-3">
                    <input type="hidden" name="purchase_order_id" value="{{ entry.purchaseOrderId ?? selectedPoId ?? '' }}">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Producto</label>
                        <select name="product_id" required
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400/30">
                            <option value="">&mdash; Seleccionar &mdash;</option>
                            {% for product in products %}
                            <option value="{{ product.id }}">{{ product.name }} ({{ product.code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Ubicacion destino</label>
                        <select name="location_id" required
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400/30">
                            <option value="">&mdash; Seleccionar &mdash;</option>
                            {% for location in locations %}
                            <option value="{{ location.id }}">{{ location.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">N. Serie (uno por linea)</label>
                        <textarea name="serial_numbers" rows="3"
                                  class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 font-mono w-48 focus:outline-none focus:ring-2 focus:ring-blue-400/30"
                                  placeholder="Dejar vacio si es no serializado"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Cantidad (no serializado)</label>
                        <input type="number" name="quantity" min="1" value="1"
                               class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 w-20 focus:outline-none focus:ring-2 focus:ring-blue-400/30">
                    </div>
                    <button type="submit"
                            class="text-sm font-medium px-4 py-1.5 rounded-lg text-white"
                            style="background: #1e3585;">Agregar</button>
                </form>
            </div>
            {% endif %}
        </div>
    </div>

    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-entry',
        title: 'Confirmar entrada',
        message: '¿Confirmar la entrada? Esto cargará el stock al inventario.',
        action: confirmEntryAction,
        confirmText: 'Confirmar',
        confirmStyle: 'amber',
    } %}

    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-cancel-entry',
        title: 'Cancelar entrada',
        message: '¿Cancelar esta entrada?',
        action: cancelEntryAction,
        confirmText: 'Cancelar entrada',
        confirmStyle: 'red',
    } %}

    {# Modal: editar entrada #}
    <div id="modal-edit-entry" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40" onclick="if(event.target===this)closeModal('modal-edit-entry')">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800">Editar entrada</h3>
                <button type="button" onclick="closeModal('modal-edit-entry')" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <form method="POST" action="{{ path('inventory_entry_update', {id: entry.id}) }}" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Referencia <span class="text-red-500">*</span></label>
                    <input type="text" name="reference" required maxlength="100" value="{{ entry.reference }}"
                           class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400/40 transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
                    <textarea name="notes" rows="3" maxlength="1000"
                              class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400/40 transition-colors resize-none"
                              placeholder="Opcional">{{ entry.notes }}</textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Costo total ($)</label>
                    <input type="number" name="total_cost" step="0.01" min="0" value="{{ entry.totalCost ?? '' }}"
                           class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400/40 transition-colors"
                           placeholder="0.00">
                </div>
                <div class="flex justify-end gap-3 pt-1">
                    <button type="button" onclick="closeModal('modal-edit-entry')"
                            class="text-sm px-4 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="text-sm px-4 py-2 rounded-lg text-white font-medium transition-colors"
                            style="background: #1e3585;"
                            onmouseover="this.style.background='#152970'"
                            onmouseout="this.style.background='#1e3585'">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }
    </script>
{% endblock %}
