{% extends 'base.html.twig' %}

{% block title %}Nueva entrada{% endblock %}
{% block page_title %}Nueva Entrada de Inventario{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_entry_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-lg">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('inventory_entry_create') }}" novalidate>

                {% if purchaseOrderId %}
                <input type="hidden" name="purchase_order_id" value="{{ purchaseOrderId }}">
                <div class="mb-5 bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <p class="text-sm text-blue-700">Esta entrada se crear&aacute; vinculada a la orden de compra.</p>
                </div>
                {% endif %}

                <div class="space-y-5">

                    <div>
                        <label for="reference" class="block text-sm font-medium text-gray-700 mb-1">
                            Referencia <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="reference" name="reference"
                               value="{{ input.reference ?? '' }}"
                               maxlength="100"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ej: ENT-2026-001"
                               required autocomplete="off">
                    </div>

                    <div>
                        <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
                        <textarea id="notes" name="notes" rows="3"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none resize-none"
                                  onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                  style="transition: border-color .15s;"
                                  placeholder="Observaciones...">{{ input.notes ?? '' }}</textarea>
                    </div>

                    <div>
                        <label for="total_cost" class="block text-sm font-medium text-gray-700 mb-1">Costo total de entrada ($)</label>
                        <input type="number" id="total_cost" name="total_cost" step="0.01" min="0"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="0.00">
                    </div>

                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="px-5 py-2 text-sm font-medium text-white rounded-lg shadow-sm"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        Crear entrada
                    </button>
                    <a href="{{ path('inventory_entry_list') }}"
                       class="px-4 py-2 text-sm font-medium text-gray-600 rounded-lg border border-gray-200 hover:bg-gray-50">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
