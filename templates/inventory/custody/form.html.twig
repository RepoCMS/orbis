{% extends 'base.html.twig' %}

{% block title %}Asignar custodia{% endblock %}
{% block page_title %}Asignar custodia{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            {% if errors is defined and errors is not empty %}
                <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    {% for error in errors %}<p>{{ error }}</p>{% endfor %}
                </div>
            {% endif %}

            <form method="post" action="{{ path('inventory_custody_assign') }}">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Empleado</label>
                        <select name="employeeId" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Seleccione un empleado</option>
                            {% for emp in employees %}
                            <option value="{{ emp.id }}" {{ input.employeeId is defined and input.employeeId == emp.id ? 'selected' : '' }}>{{ emp.firstName }} {{ emp.lastName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Item de stock</label>
                        <input type="text" name="stockItemId" value="{{ input.stockItemId ?? '' }}" required
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <p class="text-xs text-gray-400 mt-1">ID del item de stock serializado</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Ubicaci&oacute;n de custodia</label>
                        <select name="locationId" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Seleccione una ubicaci&oacute;n</option>
                            {% for loc in locations %}
                            <option value="{{ loc.id }}" {{ input.locationId is defined and input.locationId == loc.id ? 'selected' : '' }}>{{ loc.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Notas (opcional)</label>
                        <textarea name="notes" rows="3" maxlength="500"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">{{ input.notes ?? '' }}</textarea>
                    </div>
                    <div class="flex items-center gap-3 pt-2">
                        <button type="submit"
                                class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                                style="background: #1e3585;">
                            Asignar custodia
                        </button>
                        <a href="{{ path('inventory_custody_list') }}" class="text-sm text-gray-500 hover:underline">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
