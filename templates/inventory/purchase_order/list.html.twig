{% extends 'base.html.twig' %}

{% block title %}Órdenes de compra{% endblock %}
{% block page_title %}Órdenes de Compra{% endblock %}

{% block header_actions %}
    {% if is_granted('inventory.create') %}
    <a href="{{ path('inventory_po_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nueva orden
    </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% if purchaseOrders is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <svg class="w-12 h-12 mb-3 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
            </svg>
            <p class="text-sm font-medium text-gray-600">No hay órdenes de compra abiertas.</p>
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Referencia</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Estado</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden md:table-cell">Creado</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for po in purchaseOrders %}
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-3 font-medium text-gray-900">
                                <a href="{{ path('inventory_po_show', {id: po.id}) }}"
                                   class="hover:text-blue-700 transition-colors">{{ po.reference }}</a>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                                    {% if po.status == 'open' %}bg-green-100 text-green-700
                                    {% elseif po.status == 'partial' %}bg-yellow-100 text-yellow-700
                                    {% elseif po.status == 'completed' %}bg-blue-100 text-blue-700
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ po.statusLabel }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-gray-500 text-xs hidden md:table-cell">{{ po.createdAt }}</td>
                            <td class="px-4 py-3 text-right">
                                {% if is_granted('inventory.update') and po.status == 'open' %}
                                <form method="POST" action="{{ path('inventory_po_cancel', {id: po.id}) }}"
                                      onsubmit="return confirm('¿Cancelar esta orden?')" class="inline">
                                    <button type="submit"
                                            class="text-xs px-3 py-1.5 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 transition-colors">
                                        Cancelar
                                    </button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
