{% extends 'base.html.twig' %}

{% block title %}Nueva transformación{% endblock %}
{% block page_title %}Registrar transformación{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_transformation_list') }}"
       class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        ← Volver
    </a>
{% endblock %}

{% block body %}
    {% for error in errors %}
        <div class="mb-4 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
            {{ error }}
        </div>
    {% endfor %}

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 max-w-xl">
        <form method="POST" action="{{ path('inventory_transformation_create') }}" class="space-y-5">
            <div>
                <label for="serialized_stock_id" class="block text-sm font-medium text-gray-700 mb-1">
                    Stock serializado <span class="text-red-500">*</span>
                </label>
                {% if stock is not empty %}
                <select id="serialized_stock_id" name="serialized_stock_id" required
                        class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">— Seleccione —</option>
                    {% for s in stock %}
                        <option value="{{ s.id }}"
                            {% if (input.serializedStockId ?? '') == s.id %}selected{% endif %}>
                            {{ s.serialNumber ?? s.id }} ({{ s.productId|slice(0,8) }}…)
                        </option>
                    {% endfor %}
                </select>
                {% else %}
                    <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 shrink-0 mt-0.5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                            </svg>
                            <div class="text-sm">
                                <p class="font-medium text-amber-800">No hay stock serializado disponible</p>
                                <p class="text-amber-700 mt-0.5">Debe registrar stock serializado antes de poder realizar una transformación.</p>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div>
                <label for="laboratory_id" class="block text-sm font-medium text-gray-700 mb-1">
                    Laboratorio <span class="text-red-500">*</span>
                </label>
                {% if locations is not empty %}
                <select id="laboratory_id" name="laboratory_id" required
                        class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">— Seleccione —</option>
                    {% for loc in locations %}
                        {% if loc.type == 'LABORATORY' %}
                            <option value="{{ loc.id }}"
                                {% if (input.laboratoryId ?? '') == loc.id %}selected{% endif %}>
                                {{ loc.name }}
                            </option>
                        {% endif %}
                    {% endfor %}
                </select>
                {% else %}
                    <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 shrink-0 mt-0.5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                            </svg>
                            <div class="text-sm">
                                <p class="font-medium text-amber-800">No hay laboratorios disponibles</p>
                                <p class="text-amber-700 mt-0.5">Debe crear al menos un laboratorio antes de poder realizar una transformación.</p>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div>
                <label for="new_product_id" class="block text-sm font-medium text-gray-700 mb-1">
                    Nuevo producto (opcional)
                </label>
                <input type="text" id="new_product_id" name="new_product_id"
                       value="{{ input.newProductId ?? '' }}"
                       placeholder="ID del nuevo producto (ULID)"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 font-mono"/>
                <p class="mt-1 text-xs text-gray-400">Dejar en blanco si el producto no cambia.</p>
            </div>

            <div>
                <label for="new_serial_number" class="block text-sm font-medium text-gray-700 mb-1">
                    Nuevo número de serie (opcional)
                </label>
                <input type="text" id="new_serial_number" name="new_serial_number"
                       value="{{ input.newSerialNumber ?? '' }}"
                       placeholder="Ej: SN-12345678"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400"/>
                <p class="mt-1 text-xs text-gray-400">Dejar en blanco si el número de serie no cambia.</p>
            </div>

            <div>
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
                <textarea id="notes" name="notes" rows="3"
                          placeholder="Descripción del trabajo realizado…"
                          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none">{{ input.notes ?? '' }}</textarea>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <a href="{{ path('inventory_transformation_list') }}"
                   class="px-4 py-2 text-sm font-medium text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit"
                        class="px-5 py-2 text-sm font-medium text-white rounded-lg shadow-sm transition-colors"
                        style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                    Registrar transformación
                </button>
            </div>
        </form>
    </div>
{% endblock %}
