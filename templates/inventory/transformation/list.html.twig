{% extends 'base.html.twig' %}

{% block title %}Transformaciones{% endblock %}
{% block page_title %}Transformaciones de stock{% endblock %}

{% block header_actions %}
    {% if is_granted('inventory.create') %}
    <a href="{{ path('inventory_transformation_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nueva transformación
    </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% if transformations is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <svg class="w-12 h-12 mb-3 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/>
            </svg>
            <p class="text-sm font-medium text-gray-600">No hay transformaciones registradas.</p>
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-left">
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Stock (N.º Serie)</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden md:table-cell">Laboratorio</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Cambios</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide hidden lg:table-cell">Fecha</th>
                            <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide text-right">Detalle</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for t in transformations %}
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-4 py-3 font-mono text-xs text-gray-700">{{ t.serializedStockId|slice(0,10) }}…</td>
                            <td class="px-4 py-3 hidden md:table-cell text-gray-600 font-mono text-xs">{{ t.laboratoryId|slice(0,10) }}…</td>
                            <td class="px-4 py-3">
                                {% if t.changedProduct and t.changedSerial %}
                                    <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-purple-100 text-purple-700">Producto + Serie</span>
                                {% elseif t.changedProduct %}
                                    <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-100 text-blue-700">Producto</span>
                                {% elseif t.changedSerial %}
                                    <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-teal-100 text-teal-700">N.º Serie</span>
                                {% else %}
                                    <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Notas</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 hidden lg:table-cell text-gray-500 text-xs">
                                {{ t.createdAt|date('d/m/Y H:i') }}
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a href="{{ path('inventory_transformation_show', {id: t.id}) }}"
                                   class="text-xs font-medium text-blue-600 hover:underline">Ver</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
