{% extends 'base.html.twig' %}

{% block title %}{{ subLocation is defined ? 'Editar' : 'Nueva' }} sub-ubicaci&oacute;n{% endblock %}
{% block page_title %}{{ subLocation is defined ? 'Editar' : 'Nueva' }} sub-ubicaci&oacute;n{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <p class="text-sm text-gray-500 mb-4">Ubicaci&oacute;n: <strong>{{ location.name }}</strong></p>

            {% if errors is defined and errors is not empty %}
                <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    {% for error in errors %}<p>{{ error }}</p>{% endfor %}
                </div>
            {% endif %}

            <form method="post" action="{{ subLocation is defined ? path('inventory_sublocation_update', {locationId: location.id, id: subLocation.id}) : path('inventory_sublocation_create', {locationId: location.id}) }}">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
                        <select name="type" {{ subLocation is defined ? 'disabled' : 'required' }}
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            {% for type in types %}
                            <option value="{{ type.value }}" {{ input.type is defined and input.type == type.value ? 'selected' : '' }}>{{ type.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                        <input type="text" name="name" value="{{ input.name ?? (subLocation.name ?? '') }}" required maxlength="100"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">C&oacute;digo</label>
                        <input type="text" name="code" value="{{ input.code ?? (subLocation.code ?? '') }}" required maxlength="50"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Sub-ubicaci&oacute;n padre</label>
                        <select name="parent_id"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Ninguna (ra&iacute;z)</option>
                            {% for opt in parentOptions %}
                            <option value="{{ opt.id }}" {{ input.parentId is defined and input.parentId == opt.id ? 'selected' : '' }}>{{ opt.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="flex items-center gap-3 pt-2">
                        <button type="submit"
                                class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                                style="background: #1e3585;">
                            {{ subLocation is defined ? 'Actualizar' : 'Crear' }}
                        </button>
                        <a href="{{ path('inventory_sublocation_list', {locationId: location.id}) }}" class="text-sm text-gray-500 hover:underline">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
