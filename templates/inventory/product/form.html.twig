{% extends 'base.html.twig' %}

{% set isEdit = product is defined %}
{% block title %}{{ isEdit ? 'Editar producto' : 'Nuevo producto' }}{% endblock %}
{% block page_title %}{{ isEdit ? 'Editar producto' : 'Registrar producto' }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('inventory_product_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-lg">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">â€¢ {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST"
                  action="{{ isEdit ? path('inventory_product_update', {id: product.id}) : path('inventory_product_create') }}"
                  novalidate>

                <div class="space-y-5">

                    <div>
                        <label for="code" class="block text-sm font-medium text-gray-700 mb-1">
                            Código de proveedor <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="code" name="code"
                               value="{{ input.code ?? '' }}"
                               maxlength="100"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none font-mono"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ej: NCR-PRT-001"
                               required autocomplete="off"
                               {% if isEdit %}readonly{% endif %}>
                        {% if isEdit %}
                            <p class="mt-1 text-xs text-gray-400">El Código no puede modificarse.</p>
                        {% endif %}
                    </div>

                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                            Nombre <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="name" name="name"
                               value="{{ input.name ?? '' }}"
                               maxlength="200"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ej: Impresora térmica NCR"
                               required autocomplete="off">
                    </div>

                    <div>
                        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                            Descripción
                        </label>
                        <textarea id="description" name="description" rows="3"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none resize-none"
                                  onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                  style="transition: border-color .15s;"
                                  placeholder="Descripción del producto...">{{ input.description ?? '' }}</textarea>
                    </div>

                    {% if not isEdit %}
                    <div>
                        <p class="block text-sm font-medium text-gray-700 mb-2">
                            Tipo de rastreo <span class="text-red-500">*</span>
                        </p>
                        <p class="text-xs text-gray-400 mb-3">
                            Puede cambiarse solo mientras el producto no tenga stock registrado.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex items-start gap-3 p-4 rounded-xl border-2 cursor-pointer transition-colors
                                          {% if (input.tracking_type ?? 'serialized') == 'serialized' %}border-blue-500 bg-blue-50{% else %}border-gray-200 hover:border-gray-300{% endif %}"
                                   id="label-serialized">
                                <input type="radio" name="tracking_type" value="serialized"
                                       {% if (input.tracking_type ?? 'serialized') == 'serialized' %}checked{% endif %}
                                       class="mt-0.5 accent-blue-600"
                                       onchange="updateTrackingLabel()">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800">Serializado</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Cada unidad tiene un número de serie único (ej: impresora, lector de tarjetas).</p>
                                </div>
                            </label>
                            <label class="flex items-start gap-3 p-4 rounded-xl border-2 cursor-pointer transition-colors
                                          {% if (input.tracking_type ?? '') == 'non_serialized' %}border-blue-500 bg-blue-50{% else %}border-gray-200 hover:border-gray-300{% endif %}"
                                   id="label-non-serialized">
                                <input type="radio" name="tracking_type" value="non_serialized"
                                       {% if (input.tracking_type ?? '') == 'non_serialized' %}checked{% endif %}
                                       class="mt-0.5 accent-blue-600"
                                       onchange="updateTrackingLabel()">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800">No serializado</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Se gestiona por cantidad (ej: tornillos, papel, cables).</p>
                                </div>
                            </label>
                        </div>
                    </div>
                    {% elseif hasStock is defined and not hasStock %}
                    {# Edición: sin stock → se puede cambiar el tipo #}
                    <div>
                        <p class="block text-sm font-medium text-gray-700 mb-2">
                            Tipo de rastreo
                        </p>
                        <p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 mb-3">
                            El producto no tiene stock. Puede cambiar el tipo de rastreo.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex items-start gap-3 p-4 rounded-xl border-2 cursor-pointer transition-colors
                                          {% if (input.tracking_type ?? 'serialized') == 'serialized' %}border-blue-500 bg-blue-50{% else %}border-gray-200 hover:border-gray-300{% endif %}"
                                   id="label-serialized">
                                <input type="radio" name="tracking_type" value="serialized"
                                       {% if (input.tracking_type ?? 'serialized') == 'serialized' %}checked{% endif %}
                                       class="mt-0.5 accent-blue-600"
                                       onchange="updateTrackingLabel()">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800">Serializado</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Cada unidad tiene un número de serie único (ej: impresora, lector de tarjetas).</p>
                                </div>
                            </label>
                            <label class="flex items-start gap-3 p-4 rounded-xl border-2 cursor-pointer transition-colors
                                          {% if (input.tracking_type ?? '') == 'non_serialized' %}border-blue-500 bg-blue-50{% else %}border-gray-200 hover:border-gray-300{% endif %}"
                                   id="label-non-serialized">
                                <input type="radio" name="tracking_type" value="non_serialized"
                                       {% if (input.tracking_type ?? '') == 'non_serialized' %}checked{% endif %}
                                       class="mt-0.5 accent-blue-600"
                                       onchange="updateTrackingLabel()">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800">No serializado</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Se gestiona por cantidad (ej: tornillos, papel, cables).</p>
                                </div>
                            </label>
                        </div>
                    </div>
                    {% else %}
                    {# Edición: con stock → bloqueado #}
                    <div class="rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 flex items-center gap-3">
                        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <p class="text-xs text-gray-500">
                            Tipo de rastreo: <strong class="text-gray-700">{{ product.trackingType == 'serialized' ? 'Serializado' : 'No serializado' }}</strong>
                            — no modificable mientras haya stock registrado.
                        </p>
                    </div>
                    {% endif %}

                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="px-5 py-2 text-sm font-medium text-white rounded-lg shadow-sm transition-all"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        {{ isEdit ? 'Guardar cambios' : 'Registrar producto' }}
                    </button>
                    <a href="{{ path('inventory_product_list') }}"
                       class="px-4 py-2 text-sm font-medium text-gray-600 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
    <script>
    function updateTrackingLabel() {
        var s = document.getElementById('label-serialized');
        var n = document.getElementById('label-non-serialized');
        if (!s || !n) return;
        var isSer = document.querySelector('input[name="tracking_type"][value="serialized"]')?.checked;
        s.className = s.className.replace(/border-blue-500 bg-blue-50/g, 'border-gray-200').replace(/border-gray-200/g, isSer ? 'border-blue-500 bg-blue-50' : 'border-gray-200');
        n.className = n.className.replace(/border-blue-500 bg-blue-50/g, 'border-gray-200').replace(/border-gray-200/g, !isSer ? 'border-blue-500 bg-blue-50' : 'border-gray-200');
    }
    </script>
{% endblock %}


