{% extends 'base.html.twig' %}

{% block title %}Dashboard de gastos{% endblock %}
{% block page_title %}Dashboard de gastos{% endblock %}

{% block body %}
<div class="space-y-6">

    {# ════════════════════════════════════════════════════
       ROW 1 — KPI Cards
       ════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Pendientes aprobación</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ summary.pendingApproval }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Adelantos pendientes</p>
            <p class="text-2xl font-bold text-amber-600 mt-1">${{ summary.totalOutstandingAdvances|number_format(2) }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Adelantos vencidos</p>
            <p class="text-2xl font-bold text-red-600 mt-1">{{ summary.overdueAdvances }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Gastos del mes</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">${{ summary.monthlyExpenseTotal|number_format(2) }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-green-600 uppercase tracking-wide">Gastos aprobados del mes</p>
            <p class="text-2xl font-bold text-green-700 mt-1">${{ summary.monthlyApprovedExpenseTotal|number_format(2) }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Adelantos del mes</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">${{ summary.monthlyAdvanceTotal|number_format(2) }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total liquidaciones</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ summary.totalExpenses }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total adelantos</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ summary.totalAdvances }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Adelantos por liquidar</p>
            <p class="text-2xl font-bold text-amber-600 mt-1">{{ summary.pendingSettlementAdvances }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Prom. gasto/liquidación</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">${{ summary.totalExpenses > 0 ? (summary.monthlyExpenseTotal / summary.totalExpenses)|number_format(2) : '0.00' }}</p>
        </div>
    </div>

    {# ════════════════════════════════════════════════════
       ROW 2 — Expense by status + Monthly by technician + Quick access
       ════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# Left: Expense by status #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Liquidaciones por estado</h3>
            {% if summary.expenseByStatus is not empty %}
            {% set maxCount = summary.expenseByStatus|reduce((max, row) => max > row.count ? max : row.count, 0) %}
            <div class="space-y-4">
                {% for row in summary.expenseByStatus %}
                {% set pct = maxCount > 0 ? ((row.count / maxCount) * 100)|round : 0 %}
                {% set color = row.status == 'draft' ? '#6b7280' : (row.status == 'submitted' ? '#f59e0b' : (row.status == 'approved' ? '#10b981' : '#ef4444')) %}
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-600 font-medium capitalize">{{ row.status }}</span>
                        <span class="font-bold text-gray-700">{{ row.count }}</span>
                    </div>
                    <div class="bg-gray-100 rounded-full h-3 overflow-hidden">
                        <div class="h-full rounded-full transition-all" style="width:{{ pct }}%; background:{{ color }};"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-sm text-gray-500 py-4 text-center">Sin datos</p>
            {% endif %}
        </div>

        {# Center: Monthly by technician #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Gastos del mes por técnico</h3>
            {% if summary.monthlyTotalByTechnician is not empty %}
            {% set maxTech = summary.monthlyTotalByTechnician|reduce((max, row) => max > row.total ? max : row.total, 0) %}
            <div class="space-y-4">
                {% for row in summary.monthlyTotalByTechnician %}
                {% set pct = maxTech > 0 ? ((row.total / maxTech) * 100)|round : 0 %}
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-600 font-medium truncate mr-2">{{ row.employeeId|slice(0, 8) ~ '…' }}</span>
                        <span class="font-bold text-gray-700 shrink-0">${{ row.total|number_format(2) }}</span>
                    </div>
                    <div class="bg-gray-100 rounded-full h-2.5 overflow-hidden">
                        <div class="h-full rounded-full" style="width:{{ pct }}%; background:#3b82f6;"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-sm text-gray-500 py-4 text-center">Sin gastos este mes</p>
            {% endif %}
        </div>

        {# Right: Quick actions #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Acceso rápido</h3>
            <div class="grid grid-cols-2 gap-3">
                <a href="{{ path('expense_oe_list') }}" class="p-3 rounded-lg border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition-colors text-sm font-medium text-gray-700 text-center">Liquidaciones</a>
                <a href="{{ path('expense_ca_list') }}" class="p-3 rounded-lg border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition-colors text-sm font-medium text-gray-700 text-center">Adelantos</a>
                <a href="{{ path('expense_oe_new') }}" class="p-3 rounded-lg border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition-colors text-sm font-medium text-gray-700 text-center">Nueva liquidación</a>
                <a href="{{ path('expense_ca_new') }}" class="p-3 rounded-lg border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition-colors text-sm font-medium text-gray-700 text-center">Nuevo adelanto</a>
            </div>
        </div>
    </div>

    {# ════════════════════════════════════════════════════
       ROW 3 — Expense by type + Advances by technician
       ════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {# Left: Expense by type #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Gastos por tipo</h3>
            {% if summary.expenseByType is not empty %}
            {% set maxType = summary.expenseByType|reduce((max, row) => max > row.total ? max : row.total, 0) %}
            <div class="space-y-3 max-h-80 overflow-y-auto pr-1">
                {% for row in summary.expenseByType %}
                {% set pct = maxType > 0 ? ((row.total / maxType) * 100)|round : 0 %}
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-600 font-medium capitalize">{{ row.type|replace({'_': ' '}) }}</span>
                        <span class="font-bold text-gray-700">${{ row.total|number_format(2) }} ({{ row.count }})</span>
                    </div>
                    <div class="bg-gray-100 rounded-full h-2.5 overflow-hidden">
                        <div class="h-full rounded-full" style="width:{{ pct }}%; background:#6366f1;"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-sm text-gray-500 py-4 text-center">Sin gastos registrados</p>
            {% endif %}
        </div>

        {# Right: Advances by technician #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Adelantos pendientes por técnico</h3>
            {% if summary.advancesByTechnician is not empty %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                            <th class="px-3 py-2 text-left">Técnico</th>
                            <th class="px-3 py-2 text-right">Cantidad</th>
                            <th class="px-3 py-2 text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {% for row in summary.advancesByTechnician %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-3 py-2 font-medium text-gray-700">{{ row.employeeId|slice(0, 8) ~ '…' }}</td>
                            <td class="px-3 py-2 text-right text-gray-600">{{ row.count }}</td>
                            <td class="px-3 py-2 text-right font-bold text-gray-800">${{ row.total|number_format(2) }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <p class="text-sm text-gray-500 py-4 text-center">Sin adelantos pendientes</p>
            {% endif %}
        </div>
    </div>

    {# ════════════════════════════════════════════════════
       ROW 4 — Recent expenses table
       ════════════════════════════════════════════════════ #}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Últimas liquidaciones</h3>
        {% if summary.recentExpenses is not empty %}
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                        <th class="px-3 py-2 text-left">ID</th>
                        <th class="px-3 py-2 text-left">Empleado</th>
                        <th class="px-3 py-2 text-left">Estado</th>
                        <th class="px-3 py-2 text-right">Total</th>
                        <th class="px-3 py-2 text-left">Inicio</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    {% for expense in summary.recentExpenses %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-3 py-2 font-mono text-xs text-gray-500">{{ expense.id|slice(0, 8) ~ '…' }}</td>
                        <td class="px-3 py-2 font-medium text-gray-700">{{ expense.employeeId|slice(0, 8) ~ '…' }}</td>
                        <td class="px-3 py-2">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                                {% if expense.status == 'approved' %}bg-green-100 text-green-700
                                {% elseif expense.status == 'submitted' %}bg-yellow-100 text-yellow-700
                                {% elseif expense.status == 'rejected' %}bg-red-100 text-red-700
                                {% else %}bg-gray-100 text-gray-600{% endif %}">
                                {{ expense.status|capitalize }}
                            </span>
                        </td>
                        <td class="px-3 py-2 text-right font-bold text-gray-800">${{ expense.total|number_format(2) }}</td>
                        <td class="px-3 py-2 text-gray-500">{{ expense.startDate }}</td>
                        <td class="px-3 py-2 text-right">
                            <a href="{{ path('expense_oe_show', {id: expense.id}) }}" class="text-xs font-medium text-blue-600 hover:text-blue-800">Ver →</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="text-sm text-gray-500 py-4 text-center">Sin liquidaciones registradas</p>
        {% endif %}
    </div>

</div>
{% endblock %}
