{% extends 'base.html.twig' %}

{% block title %}Editar liquidación #{{ expense.sequence }}{% endblock %}
{% block page_title %}Editar liquidación #{{ expense.sequence }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('expense_oe_show', {id: expense.id}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="w-full max-w-2xl mx-auto">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Editar liquidación</h2>
            </div>

            {% if errors|length > 0 %}
                <div class="m-6 bg-red-50 border border-red-200 rounded-xl px-5 py-4">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">{{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('expense_oe_update', {id: expense.id}) }}" class="px-6 py-5 space-y-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Motivo</label>
                    <textarea name="reason" required rows="3"
                              class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-400/30">{{ expense.reason }}</textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Fecha inicio</label>
                        <input type="date" name="startDate" value="{{ expense.startDate }}" required
                               class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-400/30">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Fecha fin</label>
                        <input type="date" name="endDate" value="{{ expense.endDate }}" required
                               class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-400/30">
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-6 py-2.5 rounded-lg shadow-sm transition-all"
                            style="background: #1e3585;"
                            onmouseover="this.style.background='#152970'"
                            onmouseout="this.style.background='#1e3585'">
                        Guardar cambios
                    </button>
                    <a href="{{ path('expense_oe_show', {id: expense.id}) }}" class="text-sm text-gray-500 hover:text-gray-700">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
