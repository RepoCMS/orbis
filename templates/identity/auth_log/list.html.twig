{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Registros de autenticación{% endblock %}
{% block page_title %}Registros de autenticación{% endblock %}

{% block header_actions %}
    <a href="{{ path('app_dashboard') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    {% if logs is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-gray-600">No hay registros de autenticación.</p>
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200">
            <form method="GET" action="{{ path('auth_log_list') }}" class="border-b border-slate-100 px-4 py-3 bg-slate-50/60">
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Usuario ID</label>
                        <input type="text" name="userId" value="{{ filters.userId }}" placeholder="Filtrar por usuario..."
                               class="text-sm rounded-lg border border-slate-200 px-3 py-1.5 bg-white w-44 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Desde</label>
                        <input type="date" name="dateFrom" value="{{ filters.dateFrom }}"
                               class="text-sm rounded-lg border border-slate-200 px-3 py-1.5 bg-white w-40 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Hasta</label>
                        <input type="date" name="dateTo" value="{{ filters.dateTo }}"
                               class="text-sm rounded-lg border border-slate-200 px-3 py-1.5 bg-white w-40 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                    </div>
                    <button type="submit"
                            class="text-sm font-medium px-4 py-1.5 rounded-lg text-white transition-colors"
                            style="background: #1e3585;"
                            onmouseover="this.style.background='#152970'"
                            onmouseout="this.style.background='#1e3585'">
                        Filtrar
                    </button>
                    {% if filters.userId or filters.dateFrom or filters.dateTo %}
                        <a href="{{ path('auth_log_list') }}" class="text-sm text-gray-500 hover:text-gray-700 hover:underline">Limpiar</a>
                    {% endif %}
                </div>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                        <tr>
                            <th class="px-6 py-3.5 text-left font-semibold">Usuario</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Evento</th>
                            <th class="px-6 py-3.5 text-left font-semibold">IP</th>
                            <th class="px-6 py-3.5 text-left font-semibold">User-Agent</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Ocurrió</th>
                            <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for log in logs %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs text-gray-900">{{ log.userId }}</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                        {% if log.event == 'login_success' %}bg-green-100 text-green-700
                                        {% elseif log.event == 'login_failed' %}bg-red-100 text-red-700
                                        {% elseif log.event == 'logout' %}bg-gray-100 text-gray-600
                                        {% elseif log.event == 'mfa_challenge' %}bg-yellow-100 text-yellow-700
                                        {% else %}bg-blue-100 text-blue-700{% endif %}">
                                        {{ log.event|replace({'_': ' '})|capitalize }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-gray-600">{{ log.ipAddress }}</td>
                                <td class="px-6 py-4 text-xs text-gray-500 max-w-xs truncate" title="{{ log.userAgent }}">{{ log.userAgent|slice(0, 60) ~ (log.userAgent|length > 60 ? '...' : '') }}</td>
                                <td class="px-6 py-4 text-gray-600 text-xs">{{ log.occurredAt|date('d/m/Y H:i:s') }}</td>
                                <td class="px-6 py-4 text-right">{{ ui.btn_view(path('auth_log_show', {id: log.id})) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total > limit %}
                <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
                    <span>Página {{ page }} de {{ (total / limit)|round(0, 'ceil') }} ({{ total }} registros)</span>
                    <div class="flex gap-2">
                        {% if page > 1 %}
                            <a href="{{ path('auth_log_list', {page: page - 1, userId: filters.userId, dateFrom: filters.dateFrom, dateTo: filters.dateTo}) }}"
                               class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50 transition-colors">Anterior</a>
                        {% endif %}
                        {% if page * limit < total %}
                            <a href="{{ path('auth_log_list', {page: page + 1, userId: filters.userId, dateFrom: filters.dateFrom, dateTo: filters.dateTo}) }}"
                               class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50 transition-colors">Siguiente</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
