{% extends 'base.html.twig' %}

{% block title %}Nuevo Usuario{% endblock %}

{% block page_title %}Crear Usuario{% endblock %}

{% block header_actions %}
    <a href="{{ path('user_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-lg">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('user_create') }}" novalidate>

                <div class="space-y-5">

                    <div>
                        <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
                            Nombre de usuario
                        </label>
                        <input type="text" id="username" name="username"
                               value="{{ input.username ?? '' }}"
                               maxlength="15"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none" style="transition: border-color .15s; --tw-ring-color: #1e3585;" onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''" 
                               placeholder="ej: jmartinez"
                               required autocomplete="off">
                        <p class="mt-1 text-xs text-gray-400">3–15 caracteres, solo letras, números y guión bajo.</p>
                    </div>

                    <div>
                        <label for="role_id" class="block text-sm font-medium text-gray-700 mb-1">
                            Rol
                        </label>
                        <select id="role_id" name="role_id"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none" onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''" style="transition: border-color .15s;"
                                required>
                            <option value="">— Seleccione un rol —</option>
                            {% for role in roles %}
                                {% if role.status == 'active' %}
                                    <option value="{{ role.id }}"
                                        {{ (input.roleId ?? '') == role.id ? 'selected' : '' }}>
                                        {{ role.name }}
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                            Contraseña
                        </label>
                        <input type="password" id="password" name="password"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none" onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''" style="transition: border-color .15s;"
                               required autocomplete="new-password">
                        <p class="mt-1 text-xs text-gray-400">Mínimo 8 caracteres, mayúsculas, minúsculas y número.</p>
                    </div>

                    <div>
                        <label for="password_confirm" class="block text-sm font-medium text-gray-700 mb-1">
                            Confirmar contraseña
                        </label>
                        <input type="password" id="password_confirm" name="password_confirm"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none" onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''" style="transition: border-color .15s;"
                               required autocomplete="new-password">
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                            Correo electrónico <span class="text-gray-400 font-normal">(opcional)</span>
                        </label>
                        <input type="email" id="email" name="email"
                               value="{{ input.email ?? '' }}"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none" onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''" style="transition: border-color .15s;"
                               placeholder="ej: usuario@empresa.com" autocomplete="off">
                        <p class="mt-1 text-xs text-gray-400">Si se indica, se enviará un email de verificación de cuenta.</p>
                    </div>

                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-all shadow-sm hover:shadow-md"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        Crear usuario
                    </button>
                    <a href="{{ path('user_list') }}" class="text-sm text-gray-500 hover:text-gray-700">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
{% endblock %}
