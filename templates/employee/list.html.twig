{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Empleados{% endblock %}
{% block page_title %}Gestión de Empleados{% endblock %}

{% block header_actions %}
    <a href="{{ path('employee_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nuevo empleado
    </a>
{% endblock %}

{% block body %}
    {% if employees is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-gray-600">No hay empleados registrados.</p>
            <a href="{{ path('employee_new') }}"
               class="mt-4 inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg"
               style="background: #1e3585;">Registrar empleado</a>
        </div>
    {% else %}

        <div class="bg-white rounded-xl shadow-sm border border-gray-200"
             data-controller="table-filter">

            {# -- Toolbar --------------------------------------- #}
            {{ include('components/_table_toolbar.html.twig', {placeholder: 'Buscar empleado...'}) }}

            {# -- Panel de filtros (client-side) --------------- #}
            <div data-table-filter-target="panel"
                 class="hidden bg-gray-50/60 border-b border-gray-100 px-4 py-3">
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Estado</label>
                        <select data-table-filter-target="filterSelect"
                                data-col="6"
                                data-match="exact"
                                data-action="change->table-filter#filterRows"
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white w-40 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                            <option value="">Todos</option>
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                            <option value="Vacaciones">Vacaciones</option>
                        </select>
                    </div>
                </div>
            </div>

            {# -- Tabla ----------------------------------------- #}
            <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                    <tr>
                        <th class="px-6 py-3.5 text-left font-semibold">Empleado</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Cédula</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Acceso</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Email</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Teléfono</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Ingreso</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Estado</th>
                        <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for employee in employees %}
                        <tr class="hover:bg-gray-50 transition-colors"
                            data-table-filter-target="row">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    {{ ui.avatar_initials(employee.firstName, employee.lastName) }}
                                    <span class="font-medium text-gray-900">{{ employee.fullName }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 font-mono text-xs text-gray-600">{{ employee.identificationNumber }}</td>
                            <td class="px-6 py-4 text-gray-600">
                                {% if usernameByEmployee[employee.id] is defined %}
                                    <span class="inline-flex items-center gap-1" title="Tiene acceso al sistema">
                                        <span class="w-2 h-2 rounded-full bg-green-500"></span>
                                        <span class="text-green-700 text-xs font-medium">Con acceso</span>
                                    </span>
                                {% else %}
                                    <a href="{{ path('employee_show', {id: employee.id, setup: '1'}) }}"
                                       class="inline-flex items-center gap-1 group" title="Crear usuario de acceso">
                                        <span class="w-2 h-2 rounded-full bg-red-400"></span>
                                        <span class="text-red-500 text-xs group-hover:underline">Sin acceso</span>
                                    </a>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-gray-600">{{ employee.email }}</td>
                            <td class="px-6 py-4 text-gray-600">{{ employee.phoneNumber }}</td>
                            <td class="px-6 py-4 text-gray-500">{{ employee.hiredAt }}</td>
                            <td class="px-6 py-4">{{ ui.status_badge(employee.status) }}</td>
                            <td class="px-6 py-4 text-right">{{ ui.btn_view(path('employee_show', {id: employee.id})) }}</td>
                        </tr>
                    {% endfor %}
                    <tr data-table-filter-target="noResults" class="hidden">
                        <td colspan="8" class="px-6 py-12 text-center text-sm text-gray-400">
                            No se encontraron empleados con los filtros aplicados.
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>

        </div>
    {% endif %}
{% endblock %}