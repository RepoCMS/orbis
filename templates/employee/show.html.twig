{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ employee.fullName }}{% endblock %}
{% block page_title %}{{ employee.fullName }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('employee_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Errors ───────────────────────────────────────────── #}
        {% if errors is defined and errors|length > 0 %}
            <div class="bg-red-50 border border-red-200 rounded-xl px-5 py-4">
                {% for error in errors %}
                    <p class="text-sm text-red-700">{{ error }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {# ── Alerta: empleado sin acceso al sistema ─────────── #}
        {% if linkedUser is null and employee.status != 'inactive' %}
            <div class="bg-amber-50 border border-amber-200 rounded-xl px-5 py-4 flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
                <div class="flex-1">
                    <p class="text-sm font-medium text-amber-800">
                        Este empleado no tiene acceso al sistema.
                    </p>
                    <p class="text-xs text-amber-700 mt-1">
                        Para activarlo, cree un usuario de acceso desde la pestaña
                        <a href="#" onclick="switchTab('access'); return false;" class="underline font-medium hover:text-amber-900">Acceso al sistema</a>.
                    </p>
                </div>
            </div>
        {% endif %}

        {# ── Profile header ───────────────────────────────────── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    {{ ui.avatar_initials(employee.firstName, employee.lastName) }}
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">{{ employee.fullName }}</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            <span class="font-mono">{{ employee.identificationNumber }}</span>
                            <span class="text-gray-300">|</span>
                            <span>{{ employee.profile | capitalize }}</span>
                            <span class="text-gray-300">|</span>
                            {% if employee.status == 'active' %}
                                <span class="inline-flex items-center gap-1 text-green-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                    Activo
                                </span>
                            {% elseif employee.status == 'on_vacation' %}
                                <span class="inline-flex items-center gap-1 text-sky-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                    Vacaciones
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1 text-gray-500">
                                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                    Inactivo
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    {% if employee.status == 'active' and is_granted('employee.update') and linkedUser is not null and linkedUser.status == 'active' %}
                        <button type="button" onclick="openModal('modal-confirm-deactivate')"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                            Desactivar
                        </button>
                        <button type="button" onclick="openModal('modal-vacation')"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-sky-700 bg-sky-50 border-sky-200 hover:bg-sky-100 transition-colors">
                            Vacaciones
                        </button>
                        {% if canStandby is defined and canStandby %}
                            <button type="button" onclick="openModal('modal-standby')"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-violet-700 bg-violet-50 border-violet-200 hover:bg-violet-100 transition-colors">
                                Standby
                            </button>
                        {% endif %}
                    {% elseif employee.status == 'on_vacation' and is_granted('employee.update') %}
                        {% if activeVacationPeriod %}
                            <button type="button" onclick="openModal('modal-confirm-cancel-vacation')"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                                Cancelar vacaciones
                            </button>
                        {% endif %}
                        <button type="button" onclick="openModal('modal-confirm-deactivate')"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                            Desactivar
                        </button>
                    {% elseif employee.status != 'active' and is_granted('employee.update') %}
                        {% if linkedUser is not null and employee.status == 'inactive' %}
                            <form method="POST" action="{{ path('employee_reactivate', {id: employee.id}) }}">
                                <button type="submit"
                                        class="text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                                    Reactivar
                                </button>
                            </form>
                        {% elseif linkedUser is null %}
                            <button type="button" onclick="switchTab('access')"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                                Crear acceso para activar
                            </button>
                        {% endif %}
                    {% endif %}
                    {% if is_granted('employee.delete') %}
                        <button type="button" onclick="openModal('modal-confirm-delete')"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                            Eliminar
                        </button>
                    {% endif %}
                </div>
            </div>

            {# ── Tabs ─────────────────────────────────────────── #}
            <div class="border-t border-gray-100">
                <nav class="flex px-6" role="tablist">
                    <button type="button" role="tab" data-tab="info"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all"
                            onclick="switchTab('info')">
                        Información
                    </button>
                    <button type="button" role="tab" data-tab="access"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all"
                            onclick="switchTab('access')">
                        Acceso al sistema
                    </button>
                    <button type="button" role="tab" data-tab="periods"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all"
                            onclick="switchTab('periods')">
                        Períodos especiales
                    </button>
                </nav>
            </div>
        </div>

        {# ── Tab: Información ─────────────────────────────────── #}
        <div id="tab-info" class="tab-content bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-gray-700">Datos generales</h2>
                {% if is_granted('employee.update') %}
                <button type="button" id="toggle-edit-employee"
                        class="text-xs text-blue-600 hover:underline font-medium">Editar</button>
                {% endif %}
            </div>
            <div id="view-employee">
                <dl class="divide-y divide-gray-100">
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">ID</dt>
                        <dd class="text-gray-800 font-mono text-xs">{{ employee.id }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Cédula / RUC</dt>
                        <dd class="text-gray-900 font-mono">{{ employee.identificationNumber }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Nombre completo</dt>
                        <dd class="text-gray-900 font-medium">{{ employee.fullName }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Perfil</dt>
                        <dd class="text-gray-800">{{ employee.profile | capitalize }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Email</dt>
                        <dd class="text-gray-800">{{ employee.email }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Teléfono</dt>
                        <dd class="text-gray-800">{{ employee.phoneNumber }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Fecha de ingreso</dt>
                        <dd class="text-gray-800">{{ employee.hiredAt }}</dd>
                    </div>
                </dl>
            </div>

            {# ── Edit form ── #}
            <form id="form-edit-employee" method="POST" action="{{ path('employee_edit', {id: employee.id}) }}"
                  class="{{ editMode is defined and editMode ? '' : 'hidden' }} px-6 py-5 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Nombre</label>
                        <input type="text" name="first_name"
                               value="{{ (editInput.first_name is defined) ? editInput.first_name : employee.firstName }}"
                               class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Apellido</label>
                        <input type="text" name="last_name"
                               value="{{ (editInput.last_name is defined) ? editInput.last_name : employee.lastName }}"
                               class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" name="email"
                           value="{{ (editInput.email is defined) ? editInput.email : employee.email }}"
                           class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Teléfono</label>
                    <input type="text" name="phone_number"
                           value="{{ (editInput.phone_number is defined) ? editInput.phone_number : employee.phoneNumber }}"
                           class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="flex items-center gap-3 pt-2">
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
                            style="background: #1e3585;"
                            onmouseover="this.style.background='#152970'"
                            onmouseout="this.style.background='#1e3585'">
                        Guardar cambios
                    </button>
                    <button type="button" id="cancel-edit-employee" class="text-sm text-gray-500 hover:text-gray-700">Cancelar</button>
                </div>
            </form>
        </div>

        {# ── Tab: Acceso al sistema ──────────────────────────── #}
        <div id="tab-access" class="tab-content hidden bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-gray-700">Acceso al sistema</h2>
                {% if linkedUser %}
                    <div class="flex items-center gap-3">
                        <a href="{{ path('user_show', {id: linkedUser.id}) }}"
                           class="text-xs text-blue-600 hover:underline">Ver usuario →</a>
                        <div data-controller="modal">
                            <button type="button"
                                    data-action="modal#open"
                                    class="text-xs text-red-600 hover:text-red-800 font-medium hover:underline">
                                Desvincular
                            </button>

                            <div data-modal-target="backdrop"
                                 class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
                                 data-action="click->modal#closeBackdrop">
                                <div data-modal-target="content"
                                     class="hidden bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
                                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Desvincular usuario</h3>
                                    <p class="text-sm text-gray-600 mb-5">¿Desvincular usuario de este empleado? El empleado perderá acceso al sistema.</p>
                                    <form method="POST" action="{{ path('employee_unlink_user', {id: employee.id}) }}">
                                        <div class="flex justify-end gap-3">
                                            <button type="button"
                                                    data-action="modal#close"
                                                    class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                                                Volver
                                            </button>
                                            <button type="submit"
                                                    class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700">
                                                Desvincular
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            {% if linkedUser %}
                <dl class="divide-y divide-gray-100">
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Usuario</dt>
                        <dd class="text-gray-900 font-medium">{{ linkedUser.username }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Rol</dt>
                        <dd class="text-gray-800">{{ rolesById[linkedUser.roleId] ?? linkedUser.roleId }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Estado de cuenta</dt>
                        <dd>
                            {% if linkedUser.status == 'active' %}
                                {{ ui.status_badge('active') }}
                            {% elseif linkedUser.status == 'unverified' %}
                                {{ ui.status_badge('unverified') }}
                            {% elseif linkedUser.status == 'inactive' %}
                                {{ ui.status_badge('inactive') }}
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            {% else %}
                <div class="px-6 py-5 border-b border-gray-100">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <p class="text-sm font-medium text-gray-700">Crear acceso al sistema</p>
                            <p class="text-xs text-gray-400 mt-0.5">El correo del empleado ({{ employee.email }}) se usará para notificaciones de cuenta.</p>
                        </div>
                        <button type="button" id="toggle-create-user"
                                class="text-xs font-medium px-3 py-1.5 rounded-lg border border-blue-300 text-blue-700 hover:bg-blue-50 transition-colors">
                            {{ createUserMode is defined and createUserMode ? 'Ocultar' : 'Crear acceso' }}
                        </button>
                    </div>

                    <form id="form-create-user" method="POST" action="{{ path('employee_create_user', {id: employee.id}) }}"
                          class="{{ createUserMode is defined and createUserMode ? '' : 'hidden' }} space-y-4">
                        {% if errors is defined and errors|length > 0 and createUserMode is defined and createUserMode %}
                            <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3">
                                {% for error in errors %}
                                    <p class="text-sm text-red-700">{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Username</label>
                                <input type="text" name="username"
                                       value="{{ createUserInput.username ?? '' }}"
                                       maxlength="15" autocomplete="off"
                                       placeholder="ej: jperez"
                                       class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <p class="mt-1 text-xs text-gray-400">3–15 caracteres, letras, números y _</p>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Rol</label>
                                <select name="role_id" class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="">— Seleccione —</option>
                                    {% for roleId, roleName in employeeRoles %}
                                        <option value="{{ roleId }}" {{ (createUserInput.roleId ?? '') == roleId ? 'selected' : '' }}>{{ roleName }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Contraseña</label>
                                <input type="password" name="password" autocomplete="new-password"
                                       class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Confirmar contraseña</label>
                                <input type="password" name="password_confirm" autocomplete="new-password"
                                       class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>
                        <div class="flex items-center gap-3 pt-1">
                            <button type="submit"
                                    class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
                                    style="background: #1e3585;"
                                    onmouseover="this.style.background='#152970'"
                                    onmouseout="this.style.background='#1e3585'">
                                Crear acceso
                            </button>
                        </div>
                    </form>
                </div>

                {% if availableUsers is not empty %}
                    <div class="px-6 py-4">
                        <button type="button" id="toggle-link-user"
                                class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                            </svg>
                            Vincular usuario existente
                        </button>
                        <form id="form-link-user" method="POST" action="{{ path('employee_link_user', {id: employee.id}) }}"
                              class="hidden mt-3 flex items-end gap-3">
                            <div class="flex-1">
                                <select name="user_id" id="link-user-select" required
                                        class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="">— Selecciona un usuario —</option>
                                    {% for user in availableUsers %}
                                        <option value="{{ user.id }}">{{ user.username }}{% if rolesById[user.roleId] is defined %} ({{ rolesById[user.roleId] }}){% endif %}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="button"
                                    onclick="openLinkUserModal()"
                                    class="inline-flex items-center text-white text-sm font-medium px-4 py-2 rounded-lg"
                                    style="background: #6b7280;"
                                    onmouseover="this.style.background='#4b5563'"
                                    onmouseout="this.style.background='#6b7280'">
                                Vincular
                            </button>
                        </form>
                    </div>

                    <div id="modal-link-user" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40" onclick="if(event.target===this)this.classList.add('hidden')">
                        <div class="bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
                            <h3 class="text-lg font-semibold text-gray-800 mb-2">Vincular usuario</h3>
                            <p class="text-sm text-gray-600 mb-5">
                                ¿Vincular usuario <strong id="link-user-name-display"></strong> a este empleado?
                            </p>
                            <div class="flex justify-end gap-3">
                                <button type="button"
                                        onclick="closeModal('modal-link-user')"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                                    Volver
                                </button>
                                <button type="button"
                                        onclick="submitLinkUser()"
                                        class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                                    Vincular
                                </button>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>

        {# ── Tab: Períodos especiales ────────────────────────── #}
        <div id="tab-periods" class="tab-content hidden bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Períodos especiales</h2>
                <p class="text-xs text-gray-400 mt-0.5">Vacaciones y standby registrados.</p>
            </div>
            {% if specialPeriods is empty %}
                <p class="px-6 py-8 text-sm text-center text-gray-400">Sin períodos registrados.</p>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                            <tr>
                                <th class="px-5 py-3 text-left font-semibold">Tipo</th>
                                <th class="px-5 py-3 text-left font-semibold">Estado</th>
                                <th class="px-5 py-3 text-left font-semibold">Inicio</th>
                                <th class="px-5 py-3 text-left font-semibold">Fin</th>
                                <th class="px-5 py-3 text-center font-semibold">Días</th>
                                <th class="px-5 py-3 text-left font-semibold">Notas</th>
                                <th class="px-5 py-3 text-center font-semibold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for period in specialPeriods %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-5 py-3">
                                        {% if period.type == 'vacation' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-700">Vacaciones</span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-violet-100 text-violet-700">Standby</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-5 py-3">
                                        {% if period.status == 'scheduled' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700">Programado</span>
                                        {% elseif period.status == 'in_progress' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">En curso</span>
                                        {% elseif period.status == 'completed' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Completado</span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Cancelado</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-5 py-3 text-gray-700">{{ period.startedAt }}</td>
                                    <td class="px-5 py-3 text-gray-700">{{ period.endedAt }}</td>
                                    <td class="px-5 py-3 text-center text-gray-600">{{ period.days }}</td>
                                    <td class="px-5 py-3 text-gray-500 text-xs">{{ period.notes ?? '—' }}</td>
                                    <td class="px-5 py-3 text-center">
                                        {% if period.isActive and is_granted('employee.update') %}
                                            <button type="button"
                                                    class="text-xs text-red-600 hover:text-red-800 font-medium"
                                                    onclick="confirmCancelPeriod('{{ path('employee_period_cancel', {id: employee.id, periodId: period.id}) }}')">
                                                Cancelar
                                            </button>
                                        {% else %}
                                            <span class="text-gray-300">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

    </div>

    {# ── Modals ───────────────────────────────────────────────── #}
    <div id="modal-vacation" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 p-6 space-y-4">
            <h3 class="text-base font-semibold text-gray-800">Programar vacaciones</h3>
            <p class="text-sm text-gray-500">El estado del empleado cambiará a "En vacaciones" automáticamente cuando comience el período.</p>
            <form method="POST" action="{{ path('employee_vacation_schedule', {id: employee.id}) }}" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Fecha inicio</label>
                        <input type="date" name="started_at" required
                               class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-400/40 focus:border-sky-400 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Fecha fin</label>
                        <input type="date" name="ended_at" required
                               class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-400/40 focus:border-sky-400 transition-colors">
                    </div>
                </div>
                <div class="flex justify-end gap-3 pt-1">
                    <button type="button" onclick="closeModal('modal-vacation')"
                            class="text-sm px-4 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="text-sm px-4 py-2 rounded-lg text-white font-medium transition-colors"
                            style="background:#0369a1;" onmouseover="this.style.background='#0c4a6e'" onmouseout="this.style.background='#0369a1'">
                        Programar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="modal-standby" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 p-6 space-y-4">
            <h3 class="text-base font-semibold text-gray-800">Programar standby</h3>
            <p class="text-sm text-gray-500">El empleado trabajará fuera de su horario habitual. El estado del empleado no cambia.</p>
            <form method="POST" action="{{ path('employee_standby_schedule', {id: employee.id}) }}" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Fecha inicio</label>
                        <input type="date" name="started_at" required
                               class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-violet-400/40 focus:border-violet-400 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Fecha fin</label>
                        <input type="date" name="ended_at" required
                               class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-violet-400/40 focus:border-violet-400 transition-colors">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Notas (opcional)</label>
                    <textarea name="notes" rows="2"
                              class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-violet-400/40 focus:border-violet-400 transition-colors resize-none"
                              placeholder="Ej: Mantenimiento preventivo cajeros zona norte..."></textarea>
                </div>
                <div class="flex justify-end gap-3 pt-1">
                    <button type="button" onclick="closeModal('modal-standby')"
                            class="text-sm px-4 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="text-sm px-4 py-2 rounded-lg text-white font-medium transition-colors"
                            style="background:#6d28d9;" onmouseover="this.style.background='#5b21b6'" onmouseout="this.style.background='#6d28d9'">
                        Programar
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── Confirmation modals ────────────────────────────── #}
    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-deactivate',
        title: 'Desactivar empleado',
        message: '¿Está seguro de desactivar a ' ~ employee.fullName ~ '? El empleado no podrá acceder al sistema hasta que sea reactivado.',
        action: path('employee_deactivate', {id: employee.id}),
        confirmText: 'Desactivar',
        confirmStyle: 'amber',
    } %}

    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-delete',
        title: 'Eliminar empleado',
        message: '¿Está seguro de eliminar a ' ~ employee.fullName ~ '? Esta acción es reversible (eliminación lógica).',
        action: path('employee_delete', {id: employee.id}),
        confirmText: 'Eliminar',
        confirmStyle: 'red',
    } %}

    {% if activeVacationPeriod %}
    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-cancel-vacation',
        title: 'Cancelar vacaciones',
        message: '¿Está seguro de cancelar el período de vacaciones en curso? El empleado volverá a estado activo.',
        action: path('employee_period_cancel', {id: employee.id, periodId: activeVacationPeriod.id}),
        confirmText: 'Cancelar período',
        confirmStyle: 'amber',
    } %}
    {% endif %}

    {# Modal genérico para cancelar períodos desde la tabla #}
    <div id="modal-confirm-cancel-period" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40" onclick="if(event.target===this)closeModal('modal-confirm-cancel-period')">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800">Cancelar período</h3>
                <button type="button" onclick="closeModal('modal-confirm-cancel-period')" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <form id="form-cancel-period" method="POST" action="" class="space-y-4">
                <p class="text-sm text-gray-600">¿Está seguro de cancelar este período?</p>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Motivo <span class="text-red-500">*</span></label>
                    <textarea name="reason" rows="2" required placeholder="Indique el motivo de la cancelación..."
                              class="w-full text-sm rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400/40 focus:border-blue-400 transition-colors resize-none"></textarea>
                </div>
                <div class="flex justify-end gap-3 pt-1">
                    <button type="button" onclick="closeModal('modal-confirm-cancel-period')"
                            class="text-sm px-4 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50">Volver</button>
                    <button type="submit"
                            class="text-sm px-4 py-2 rounded-lg text-white font-medium transition-colors"
                            style="background:#d97706;">Cancelar período</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function confirmCancelPeriod(actionUrl) {
            document.getElementById('form-cancel-period').action = actionUrl;
            openModal('modal-confirm-cancel-period');
        }

        function switchTab(name) {
            document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.add('hidden'); });
            document.querySelectorAll('.tab-btn').forEach(function(el) {
                el.classList.remove('text-blue-600', 'border-blue-600', 'text-gray-900');
                el.classList.add('text-gray-500', 'border-transparent');
            });
            var content = document.getElementById('tab-' + name);
            if (content) content.classList.remove('hidden');
            var btn = document.querySelector('[data-tab="' + name + '"]');
            if (btn) {
                btn.classList.remove('text-gray-500', 'border-transparent');
                btn.classList.add('text-blue-600', 'border-blue-600');
            }
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function openLinkUserModal() {
            var select = document.getElementById('link-user-select');
            if (!select || !select.value) return;
            var display = document.getElementById('link-user-name-display');
            if (display) display.textContent = select.options[select.selectedIndex].text;
            openModal('modal-link-user');
        }

        function submitLinkUser() {
            var form = document.getElementById('form-link-user');
            if (form) form.submit();
        }

        function initEmployeeShow() {
            var toggle = document.getElementById('toggle-edit-employee');
            var view   = document.getElementById('view-employee');
            var form   = document.getElementById('form-edit-employee');
            var cancel = document.getElementById('cancel-edit-employee');
            if (form && !form.classList.contains('hidden')) {
                toggle && toggle.classList.add('hidden');
            }
            toggle && toggle.addEventListener('click', function() {
                view.classList.add('hidden');
                form.classList.remove('hidden');
                toggle.classList.add('hidden');
            });
            cancel && cancel.addEventListener('click', function() {
                view.classList.remove('hidden');
                form.classList.add('hidden');
                toggle.classList.remove('hidden');
            });

            var btnCreate = document.getElementById('toggle-create-user');
            var formCreate = document.getElementById('form-create-user');
            var autoSetup = new URLSearchParams(window.location.search).get('setup') === '1';
            if (autoSetup && formCreate) {
                formCreate.classList.remove('hidden');
                btnCreate && (btnCreate.textContent = 'Ocultar');
                switchTab('access');
            }
            btnCreate && btnCreate.addEventListener('click', function() {
                if (formCreate.classList.contains('hidden')) {
                    formCreate.classList.remove('hidden');
                    btnCreate.textContent = 'Ocultar';
                } else {
                    formCreate.classList.add('hidden');
                    btnCreate.textContent = 'Crear acceso';
                }
            });

            var btnLink = document.getElementById('toggle-link-user');
            var formLink = document.getElementById('form-link-user');
            btnLink && btnLink.addEventListener('click', function() {
                formLink.classList.toggle('hidden');
            });

            switchTab('info');
        }

        document.addEventListener('turbo:load', initEmployeeShow);
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initEmployeeShow);
        } else {
            initEmployeeShow();
        }
    </script>
{% endblock %}