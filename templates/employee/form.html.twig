{% extends 'base.html.twig' %}

{% block title %}Nuevo Empleado{% endblock %}
{% block page_title %}Registrar Empleado{% endblock %}

{% block header_actions %}
    <a href="{{ path('employee_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-lg">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('employee_create') }}" novalidate>

                <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Datos del empleado</p>
                <div class="space-y-5">

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Nombre <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="first_name" name="first_name"
                                   value="{{ input.firstName ?? '' }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;"
                                   required>
                        </div>
                        <div>
                            <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Apellido <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="last_name" name="last_name"
                                   value="{{ input.lastName ?? '' }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;"
                                   required>
                        </div>
                    </div>

                    <div>
                        <label for="identification_number" class="block text-sm font-medium text-gray-700 mb-1">
                            Cédula RUC <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="identification_number" name="identification_number"
                               value="{{ input.identificationNumber ?? '' }}"
                               maxlength="13"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none font-mono"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="0000000000"
                               required>
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                            Email <span class="text-red-500">*</span>
                        </label>
                        <input type="email" id="email" name="email"
                               value="{{ input.email ?? '' }}"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               required>
                    </div>

                    <div>
                        <label for="phone_number" class="block text-sm font-medium text-gray-700 mb-1">
                            Teléfono <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="phone_number" name="phone_number"
                               value="{{ input.phoneNumber ?? '' }}"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="0999999999"
                               required>
                    </div>

                    <div>
                        <label for="hired_at" class="block text-sm font-medium text-gray-700 mb-1">
                            Fecha de contratación <span class="text-red-500">*</span>
                        </label>
                        <input type="date" id="hired_at" name="hired_at"
                               value="{{ input.hiredAt ?? 'now'|date('Y-m-d') }}"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               required>
                    </div>

                    <div>
                        <label for="profile" class="block text-sm font-medium text-gray-700 mb-1">
                            Perfil <span class="text-red-500">*</span>
                        </label>
                        <select id="profile" name="profile"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                style="transition: border-color .15s;">
                            {% for profile in profiles %}
                                <option value="{{ profile.value }}" {{ (input.profile ?? 'administrative') == profile.value ? 'selected' }}>{{ profile.label() }}</option>
                            {% endfor %}
                        </select>
                    </div>

                </div>

                {# Sección colapsable: crear usuario de acceso #}
                <div class="mt-6 border border-blue-200 rounded-lg overflow-hidden">
                    <button type="button" id="toggle-create-user-form"
                            class="w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-blue-800 bg-blue-50 hover:bg-blue-100 transition-colors">
                        <span class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                            </svg>
                            Crear usuario de acceso
                        </span>
                        <svg class="w-4 h-4 transform transition-transform" id="toggle-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div id="create-user-section" class="hidden p-4 space-y-4 border-t border-blue-200">
                        <p class="text-xs text-gray-500">
                            Si no completa estos datos, el empleado se creará como <strong>INACTIVE</strong>.
                            Podrá activarlo después creando un usuario de acceso desde el detalle del empleado.
                        </p>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="form-username" class="block text-xs font-medium text-gray-700 mb-1">Username</label>
                                <input type="text" id="form-username" name="username"
                                       value="{{ input.username ?? '' }}"
                                       maxlength="15" autocomplete="off"
                                       placeholder="ej: jperez"
                                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                       onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                       style="transition: border-color .15s;">
                                <p class="mt-1 text-xs text-gray-400">3–15 caracteres, letras, números y _</p>
                            </div>
                            <div>
                                <label for="form-role-id" class="block text-xs font-medium text-gray-700 mb-1">Rol</label>
                                <select id="form-role-id" name="role_id"
                                        class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                        onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                        style="transition: border-color .15s;">
                                    <option value="">— Seleccione —</option>
                                    {% for roleId, roleName in employeeRoles %}
                                        <option value="{{ roleId }}" {{ (input.roleId ?? '') == roleId ? 'selected' }}>{{ roleName }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="form-password" class="block text-xs font-medium text-gray-700 mb-1">Contraseña</label>
                                <input type="password" id="form-password" name="password"
                                       autocomplete="new-password"
                                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                       onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                       style="transition: border-color .15s;">
                            </div>
                            <div>
                                <label for="form-password-confirm" class="block text-xs font-medium text-gray-700 mb-1">Confirmar contraseña</label>
                                <input type="password" id="form-password-confirm" name="password_confirm"
                                       autocomplete="new-password"
                                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                                       onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                       style="transition: border-color .15s;">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="text-white text-sm font-medium px-5 py-2.5 rounded-lg shadow-sm transition-all hover:shadow-md"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        Registrar empleado
                    </button>
                    <a href="{{ path('employee_list') }}" class="text-sm text-gray-500 hover:text-gray-700">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtn = document.getElementById('toggle-create-user-form');
            var section = document.getElementById('create-user-section');
            var icon = document.getElementById('toggle-icon');

            if (toggleBtn && section) {
                toggleBtn.addEventListener('click', function() {
                    section.classList.toggle('hidden');
                    if (icon) {
                        icon.style.transform = section.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                    }
                });
            }
        });
    </script>
{% endblock %}
