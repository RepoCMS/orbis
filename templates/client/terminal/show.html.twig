{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Terminal {{ terminal.serial }}{% endblock %}
{% block page_title %}Terminal {{ terminal.serial }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_terminal_list', {clientId: clientId}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <p class="text-sm text-green-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
            <p class="text-sm text-red-700">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Profile header ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shrink-0"
                         style="background: #1e3585;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">Terminal {{ terminal.serial }}</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            <span>{{ ui.status_badge(terminal.status) }}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if terminal.status == 'active' and is_granted('terminal.update') %}
                        <form method="POST" action="{{ path('client_terminal_deactivate', {clientId: clientId, id: terminal.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                                Desactivar
                            </button>
                        </form>
                    {% elseif terminal.status != 'active' and is_granted('terminal.update') %}
                        <form method="POST" action="{{ path('client_terminal_reactivate', {clientId: clientId, id: terminal.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                                Reactivar
                            </button>
                        </form>
                    {% endif %}
                    {% if is_granted('terminal.delete') %}
                        <form method="POST" action="{{ path('client_terminal_delete', {clientId: clientId, id: terminal.id}) }}"
                              onsubmit="return confirm('¿Está seguro de eliminar este terminal?');">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                                Eliminar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Details ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Detalles del terminal</h2>
            </div>
            <dl class="divide-y divide-gray-100">
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">ID</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ terminal.id }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Serial</dt>
                    <dd class="text-gray-900 font-mono font-medium">{{ terminal.serial }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Fabricante</dt>
                    <dd class="text-gray-800">
                        {% if terminal.vendor == 'hyosung' %}
                            Hyosung
                        {% elseif terminal.vendor == 'diebold' %}
                            Diebold Nixdorf
                        {% elseif terminal.vendor == 'ncr' %}
                            NCR
                        {% elseif terminal.vendor == 'grg' %}
                            GRG
                        {% else %}
                            {{ terminal.vendor }}
                        {% endif %}
                    </dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Funcionalidad</dt>
                    <dd class="text-gray-800">
                        {% if terminal.funcionality == 'dispenser' %}
                            Dispensador
                        {% elseif terminal.funcionality == 'recycler' %}
                            Reciclador
                        {% elseif terminal.funcionality == 'multinfunction' %}
                            Multifunción
                        {% elseif terminal.funcionality == 'counter' %}
                            Contador (TCR)
                        {% else %}
                            {{ terminal.funcionality }}
                        {% endif %}
                    </dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Tipo</dt>
                    <dd class="text-gray-800">
                        {% if terminal.type == 'lobby' %}
                            ATM Lobby
                        {% elseif terminal.type == 'ttw' %}
                            ATM TTW
                        {% else %}
                            {{ terminal.type }}
                        {% endif %}
                    </dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Estado</dt>
                    <dd>{{ ui.status_badge(terminal.status) }}</dd>
                </div>
            </dl>
        </div>

        {# ── Enlace a garantías ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-semibold text-gray-700">Garantías</h3>
                    <p class="text-xs text-gray-500 mt-1">Gestiona las garantías asociadas a este terminal.</p>
                </div>
                <a href="{{ path('client_terminal_warranty_list', {clientId: clientId, terminalId: terminal.id}) }}"
                   class="inline-flex items-center gap-1 text-sm font-medium px-4 py-2 rounded-lg text-white"
                   style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                    Ver garantías
                </a>
            </div>
        </div>

    </div>
{% endblock %}
