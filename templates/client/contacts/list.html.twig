{% extends 'base.html.twig' %}

{% block title %}Clientes{% endblock %}
{% block page_title %}Gestión de Clientes{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nuevo cliente
    </a>
{% endblock %}

{% block body %}
    {% if clients is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-gray-600">No hay clientes registrados.</p>
            <a href="{{ path('client_new') }}"
               class="mt-4 inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg"
               style="background: #1e3585;">Registrar cliente</a>
        </div>
    {% else %}
        <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200">
            <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                    <tr>
                        <th class="px-6 py-3.5 text-left font-semibold">Nombre</th>
                        <th class="px-6 py-3.5 text-left font-semibold">RUC</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Estado</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Dirección</th>
                        <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for client in clients %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">{{ client.name }}</td>
                            <td class="px-6 py-4 font-mono text-gray-600 text-xs">{{ client.ruc }}</td>
                            <td class="px-6 py-4">
                                {% if client.status == 'active' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" style="background: #e6f7f1; color: #00a86b;">Activo</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactivo</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-gray-500 max-w-xs truncate">{{ client.address ?? '—' }}</td>
                            <td class="px-6 py-4 text-right">
                                <a href="{{ path('client_show', {id: client.id}) }}"
                                   class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-md transition-colors"
                                   style="color: #1e3585; background: #eef1f9;"
                                   onmouseover="this.style.background='#d8dff0'" onmouseout="this.style.background='#eef1f9'">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                    Ver
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
