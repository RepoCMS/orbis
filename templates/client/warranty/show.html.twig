{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Garantía{% endblock %}
{% block page_title %}Detalles de la Garantía{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_terminal_warranty_list', {clientId: clientId, terminalId: terminalId}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <p class="text-sm text-green-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
            <p class="text-sm text-red-700">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Profile header ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shrink-0"
                         style="background: #1e3585;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">Garantía {{ warranty.type }}</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            {% if warranty.isExpired %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">Vencida</span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Vigente</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Details ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Información de la garantía</h2>
            </div>
            <dl class="divide-y divide-gray-100">
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">ID</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ warranty.id }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Tipo</dt>
                    <dd class="text-gray-900 font-medium">{{ warranty.type }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Fecha de inicio</dt>
                    <dd class="text-gray-800">{{ warranty.startDate }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Fecha de fin</dt>
                    <dd class="text-gray-800">{{ warranty.endDate }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Vencida</dt>
                    <dd>
                        {% if warranty.isExpired %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">Sí</span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">No</span>
                        {% endif %}
                    </dd>
                </div>
            </dl>
        </div>

        {# ── Terms ── #}
        {% if warranty.terms %}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                    <h2 class="text-sm font-semibold text-gray-700">Términos de la garantía</h2>
                </div>
                <div class="px-6 py-5">
                    <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ warranty.terms }}</p>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
