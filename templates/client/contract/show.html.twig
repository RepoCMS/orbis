{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Contrato{% endblock %}
{% block page_title %}Detalles del Contrato{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_contract_list', {clientId: clientId}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <p class="text-sm text-green-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
            <p class="text-sm text-red-700">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Profile header ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shrink-0"
                         style="background: #1e3585;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">Contrato</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            <span>{{ ui.status_badge(contract.status) }}</span>
                            <span class="text-gray-300">|</span>
                            <span class="font-mono">ID: {{ contract.id }}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if contract.status == 'active' and is_granted('client.update') %}
                        <form method="POST" action="{{ path('client_contract_cancel', {clientId: clientId, id: contract.id}) }}"
                              onsubmit="return confirm('¿Está seguro de cancelar este contrato?');">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                                Cancelar contrato
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Details ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Información del contrato</h2>
            </div>
            <dl class="divide-y divide-gray-100">
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">ID</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ contract.id }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Cliente</dt>
                    <dd class="text-gray-800 font-medium">{{ contract.clientId }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Fecha de inicio</dt>
                    <dd class="text-gray-900 font-medium">{{ contract.startDate }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Fecha de fin</dt>
                    <dd class="text-gray-800">{{ contract.endDate ?? '—' }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Alcance</dt>
                    <dd class="text-gray-800 max-w-md text-right">{{ contract.scope ?? '—' }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Estado</dt>
                    <dd>{{ ui.status_badge(contract.status) }}</dd>
                </div>
            </dl>
        </div>

        {# ── Terms ── #}
        {% if contract.terms %}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                    <h2 class="text-sm font-semibold text-gray-700">Términos del contrato</h2>
                </div>
                <div class="px-6 py-5">
                    <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ contract.terms }}</p>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
