{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Contratos{% endblock %}
{% block page_title %}Contratos del Cliente{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_contract_new', {clientId: clientId}) }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nuevo contrato
    </a>
    <a href="{{ path('client_show', {id: clientId}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1 ml-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver al cliente
    </a>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <p class="text-sm text-green-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
            <p class="text-sm text-red-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="mb-4 bg-amber-50 border border-amber-200 rounded-xl px-5 py-3">
            <p class="text-sm text-amber-700">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        {% if contracts is empty %}
            <div class="flex flex-col items-center justify-center py-20 text-gray-400">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                    <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-600">No hay contratos registrados para este cliente.</p>
                <a href="{{ path('client_contract_new', {clientId: clientId}) }}"
                   class="mt-4 inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg"
                   style="background: #1e3585;">Registrar contrato</a>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                        <tr>
                            <th class="px-6 py-3.5 text-left font-semibold">ID</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Inicio</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Fin</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Alcance</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Estado</th>
                            <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for contract in contracts %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs text-gray-600">{{ contract.id }}</td>
                                <td class="px-6 py-4 text-gray-800">{{ contract.startDate }}</td>
                                <td class="px-6 py-4 text-gray-600">{{ contract.endDate ?? '—' }}</td>
                                <td class="px-6 py-4 text-gray-500 max-w-xs truncate">{{ contract.scope ?? '—' }}</td>
                                <td class="px-6 py-4">{{ ui.status_badge(contract.status) }}</td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        {{ ui.btn_view(path('client_contract_show', {clientId: clientId, id: contract.id})) }}
                                        {% if contract.status == 'active' and is_granted('client.update') %}
                                            <form method="POST" action="{{ path('client_contract_cancel', {clientId: clientId, id: contract.id}) }}"
                                                  onsubmit="return confirm('¿Está seguro de cancelar este contrato?');">
                                                <button type="submit"
                                                        class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-md border border-red-200 text-red-700 bg-red-50 hover:bg-red-100 transition-colors">
                                                    Cancelar
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
