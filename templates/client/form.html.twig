{% extends 'base.html.twig' %}

{% block title %}Nuevo Cliente{% endblock %}
{% block page_title %}Registrar Cliente{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="max-w-lg">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

            {% if errors is not empty %}
                <div class="mb-5 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in errors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('client_create') }}" novalidate>

                <div class="space-y-5">

                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                            Razón social / Nombre <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="name" name="name"
                               value="{{ input.name ?? '' }}"
                               maxlength="200"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="ej: Banco del Pacífico S.A."
                               required autocomplete="off">
                    </div>

                    <div>
                        <label for="ruc" class="block text-sm font-medium text-gray-700 mb-1">
                            RUC <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="ruc" name="ruc"
                               value="{{ input.ruc ?? '' }}"
                               maxlength="13" minlength="13" pattern="[0-9]{13}"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none font-mono"
                               onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                               style="transition: border-color .15s;"
                               placeholder="0000000000001"
                               required autocomplete="off">
                        <p class="mt-1 text-xs text-gray-400">13 dígitos numéricos. RUC ecuatoriano con validación.</p>
                    </div>

                    <div>
                        <label for="address" class="block text-sm font-medium text-gray-700 mb-1">
                            Dirección <span class="text-gray-400 font-normal">(opcional)</span>
                        </label>
                        <textarea id="address" name="address" rows="2"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm outline-none resize-none"
                                  onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                  style="transition: border-color .15s;"
                                  placeholder="Av. Principal 123, Ciudad">{{ input.address ?? '' }}</textarea>
                    </div>

                </div>

                <div class="mt-6 flex items-center gap-3">
                    <button type="submit"
                            class="text-white text-sm font-medium px-5 py-2.5 rounded-lg shadow-sm transition-all hover:shadow-md"
                            style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                        Registrar cliente
                    </button>
                    <a href="{{ path('client_list') }}" class="text-sm text-gray-500 hover:text-gray-700">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
{% endblock %}
