{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Clientes{% endblock %}
{% block page_title %}Gestión de Clientes{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nuevo cliente
    </a>
{% endblock %}

{% block body %}
    {% set activeCount = (filters.name ? 1 : 0) + (filters.ruc ? 1 : 0) + (filters.status ? 1 : 0) %}

    {% if clients is empty and activeCount == 0 %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-gray-600">No hay clientes registrados.</p>
            <a href="{{ path('client_new') }}"
               class="mt-4 inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg"
               style="background: #1e3585;">Registrar cliente</a>
        </div>
    {% else %}

        <div class="bg-white rounded-xl shadow-sm border border-gray-200"
             data-controller="table-filter"
             data-active-filters-count="{{ activeCount }}">

            {# -- Toolbar (server-side search) ------------------- #}
            <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-3">

                <form method="GET" action="{{ path('client_list') }}" class="flex-1 max-w-xs">
                    <input type="hidden" name="ruc"    value="{{ filters.ruc }}">
                    <input type="hidden" name="status" value="{{ filters.status }}">
                    <div class="relative">
                        <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </span>
                        <input type="text" name="name" value="{{ filters.name }}"
                               placeholder="Buscar por nombre..."
                               class="w-full pl-9 pr-3 py-2 text-sm rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 bg-gray-50/50 transition-colors">
                    </div>
                </form>

                <div class="ml-auto">
                    <button type="button"
                            data-action="click->table-filter#toggle"
                            class="relative inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border transition-colors {{ activeCount > 0 ? 'border-blue-300 text-blue-700 bg-blue-50' : 'border-gray-200 text-gray-600 hover:bg-gray-50' }}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"/>
                        </svg>
                        Filtros
                        <span data-table-filter-target="badge"
                              class="{{ activeCount == 0 ? 'hidden' : '' }} absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] flex items-center justify-center text-[10px] font-bold text-white rounded-full px-0.5"
                              style="background: #1e3585;">{{ activeCount }}</span>
                    </button>
                </div>
            </div>

            {# -- Panel de filtros (server-side) ---------------- #}
            <div data-table-filter-target="panel"
                 class="{{ activeCount > 0 ? '' : 'hidden' }} bg-gray-50/60 border-b border-gray-100 px-4 py-3">
                <form method="GET" action="{{ path('client_list') }}" class="flex flex-wrap items-end gap-3">
                    <input type="hidden" name="name" value="{{ filters.name }}">

                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">RUC</label>
                        <input type="text" name="ruc" value="{{ filters.ruc }}"
                               placeholder="Filtrar por RUC..."
                               class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 bg-white w-44 transition-colors">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Estado</label>
                        <select name="status"
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white w-36 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                            <option value="">Todos</option>
                            <option value="active"   {% if filters.status == 'active' %}selected{% endif %}>Activo</option>
                            <option value="inactive" {% if filters.status == 'inactive' %}selected{% endif %}>Inactivo</option>
                        </select>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="submit"
                                class="text-sm font-medium px-4 py-1.5 rounded-lg text-white transition-colors"
                                style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                            Aplicar
                        </button>
                        {% if activeCount > 0 %}
                            <a href="{{ path('client_list') }}"
                               class="text-sm font-medium px-3 py-1.5 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 transition-colors">
                                Limpiar
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {# -- Tabla / sin resultados ------------------------- #}
            {% if clients is empty %}
                <div class="py-14 flex flex-col items-center text-gray-400">
                    <svg class="w-10 h-10 mb-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <p class="text-sm font-medium text-gray-500">Sin resultados para los filtros aplicados.</p>
                    <a href="{{ path('client_list') }}"
                       class="mt-3 text-sm font-medium px-3 py-1.5 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 transition-colors">
                        Limpiar filtros
                    </a>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                        <tr>
                            <th class="px-6 py-3.5 text-left font-semibold">Nombre</th>
                            <th class="px-6 py-3.5 text-left font-semibold">RUC</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Estado</th>
                            <th class="px-6 py-3.5 text-left font-semibold">Dirección</th>
                            <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for client in clients %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 font-medium text-gray-900">{{ client.name }}</td>
                                <td class="px-6 py-4 font-mono text-gray-600 text-xs">{{ client.ruc }}</td>
                                <td class="px-6 py-4">{{ ui.status_badge(client.status) }}</td>
                                <td class="px-6 py-4 text-gray-500 max-w-xs truncate">{{ client.address ?? '—' }}</td>
                                <td class="px-6 py-4 text-right">{{ ui.btn_view(path('client_show', {id: client.id})) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            {% endif %}

        </div>
    {% endif %}
{% endblock %}