{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Asignación {{ assignment.name }}{% endblock %}
{% block page_title %}Asignación: {{ assignment.name }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_terminal_assignment_list', {clientId: clientId}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <p class="text-sm text-green-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
            <p class="text-sm text-red-700">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Profile header ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shrink-0"
                         style="background: #1e3585;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">{{ assignment.name }}</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            <span>{{ ui.status_badge(assignment.status) }}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if assignment.status == 'active' and is_granted('terminal.manage') %}
                        <form method="POST" action="{{ path('client_terminal_assignment_deactivate', {clientId: clientId, id: assignment.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                                Desactivar
                            </button>
                        </form>
                    {% elseif assignment.status != 'active' and is_granted('terminal.manage') %}
                        <form method="POST" action="{{ path('client_terminal_assignment_reactivate', {clientId: clientId, id: assignment.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                                Reactivar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {# ── Tabs ── #}
            <div class="border-t border-gray-100">
                <nav class="flex px-6 overflow-x-auto" role="tablist">
                    <button type="button" role="tab" data-tab="info"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                            onclick="switchTab('info')">
                        Información
                    </button>
                </nav>
            </div>
        </div>

        {# ── Tab: Información ── #}
        <div id="tab-info" class="tab-content bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Detalles de la asignación</h2>
            </div>
            <dl class="divide-y divide-gray-100">
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">ID</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ assignment.id }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Nombre</dt>
                    <dd class="text-gray-900 font-medium">{{ assignment.name }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Terminal</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ assignment.terminalId }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">ID asignado por el cliente</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ assignment.idAssignedByClient }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Ubicación</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ assignment.locationId }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Estado</dt>
                    <dd>{{ ui.status_badge(assignment.status) }}</dd>
                </div>
            </dl>
        </div>

    </div>

    <script>
        function switchTab(name) {
            document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.add('hidden'); });
            document.querySelectorAll('.tab-btn').forEach(function(el) {
                el.classList.remove('text-blue-600', 'border-blue-600', 'text-gray-900');
                el.classList.add('text-gray-500', 'border-transparent');
            });
            var content = document.getElementById('tab-' + name);
            if (content) content.classList.remove('hidden');
            var btn = document.querySelector('[data-tab="' + name + '"]');
            if (btn) {
                btn.classList.remove('text-gray-500', 'border-transparent');
                btn.classList.add('text-blue-600', 'border-blue-600');
            }
        }

        (function() {
            switchTab('info');
        })();
    </script>
{% endblock %}
