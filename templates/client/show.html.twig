{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ client.name }}{% endblock %}
{% block page_title %}{{ client.name }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Errors ───────────────────────────────────────────── #}
        {% if errors is defined and errors|length > 0 %}
            <div class="bg-red-50 border border-red-200 rounded-xl px-5 py-4">
                {% for error in errors %}
                    <p class="text-sm text-red-700">{{ error }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {# ── Profile header ───────────────────────────────────── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shrink-0"
                         style="background: #1e3585;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">{{ client.name }}</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            <span class="font-mono">RUC: {{ client.ruc }}</span>
                            <span class="text-gray-300">|</span>
                            <span>{{ ui.status_badge(client.status) }}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if client.status == 'active' and is_granted('client.update') %}
                        <button type="button" id="toggle-edit-client"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                            Editar
                        </button>
                        <button type="button" onclick="openModal('modal-confirm-deactivate-client')"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                            Desactivar
                        </button>
                    {% elseif client.status != 'active' %}
                        <form method="POST" action="{{ path('client_activate', {id: client.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                                Activar
                            </button>
                        </form>
                    {% endif %}
                    {% if is_granted('client.delete') %}
                        <button type="button" onclick="openModal('modal-confirm-delete-client')"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                            Eliminar
                        </button>
                    {% endif %}
                </div>
            </div>

            {# ── Tabs ─────────────────────────────────────────── #}
            <div class="border-t border-gray-100">
                <nav class="flex px-6 overflow-x-auto" role="tablist">
                    <button type="button" role="tab" data-tab="info"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                            onclick="switchTab('info')">
                        Información
                    </button>
                    <button type="button" role="tab" data-tab="contacts"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                            onclick="switchTab('contacts')">
                        Contactos
                        <span class="ml-1.5 text-xs text-gray-400">({{ contacts|length }})</span>
                    </button>
                    <button type="button" role="tab" data-tab="terminals"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                            onclick="switchTab('terminals')">
                        Terminales
                        <span class="ml-1.5 text-xs text-gray-400">({{ terminals|default([])|length }})</span>
                    </button>
                    <button type="button" role="tab" data-tab="assignments"
                            class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                            onclick="switchTab('assignments')">
                        Asignaciones
                    </button>
                    <a href="{{ path('client_contract_list', {clientId: client.id}) }}"
                       class="px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap no-underline inline-flex items-center gap-1">
                        Contratos
                    </a>

                </nav>
            </div>
        </div>

        {# ── Tab: Información ─────────────────────────────────── #}
        <div id="tab-info" class="tab-content bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-gray-700">Datos generales</h2>
                {% if is_granted('client.update') %}
                <button type="button" id="toggle-edit-client-tab"
                        class="text-xs text-blue-600 hover:underline font-medium">Editar</button>
                {% endif %}
            </div>
            <div id="view-client">
                <dl class="divide-y divide-gray-100">
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">ID</dt>
                        <dd class="text-gray-800 font-mono text-xs">{{ client.id }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">RUC</dt>
                        <dd class="text-gray-900 font-mono">{{ client.ruc }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Razón social</dt>
                        <dd class="text-gray-900 font-medium">{{ client.name }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Dirección</dt>
                        <dd class="text-gray-800">{{ client.address ?? '—' }}</dd>
                    </div>
                    <div class="px-6 py-4 flex justify-between text-sm">
                        <dt class="text-gray-500">Estado</dt>
                        <dd>{{ ui.status_badge(client.status) }}</dd>
                    </div>
                </dl>
            </div>

            {# Edit form #}
            <form id="form-edit-client" method="POST" action="{{ path('client_edit', {id: client.id}) }}"
                  class="{{ editMode is defined and editMode ? '' : 'hidden' }} px-6 py-5 space-y-4 border-t border-gray-100">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Nombre</label>
                    <input type="text" name="name"
                           value="{{ (editInput.name is defined) ? editInput.name : client.name }}"
                           class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Dirección <span class="text-gray-400">(opcional)</span></label>
                    <input type="text" name="address"
                           value="{{ (editInput.address is defined) ? editInput.address : client.address }}"
                           class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="flex items-center gap-3 pt-2">
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
                            style="background: #1e3585;"
                            onmouseover="this.style.background='#152970'"
                            onmouseout="this.style.background='#1e3585'">
                        Guardar cambios
                    </button>
                    <button type="button" id="cancel-edit-client" class="text-sm text-gray-500 hover:text-gray-700">Cancelar</button>
                </div>
            </form>
        </div>

        {# Tab: Contactos #}
        <div id="tab-contacts" class="tab-content hidden">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                <h3 class="text-sm font-semibold" style="color: #1e3585;">
                    Contactos
                    <span class="ml-2 text-xs font-normal text-gray-400">{{ contacts|length }} registrado{{ contacts|length != 1 ? 's' : '' }}</span>
                </h3>
            </div>

            {# Formulario nuevo contacto #}
            <div class="px-6 py-4 border-b border-gray-100" style="background: #f8f9fc;">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Agregar contacto</p>
                <form method="POST" action="{{ path('contact_create', {clientId: client.id}) }}" novalidate>
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <input type="text" name="first_name" placeholder="Nombre *"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;" required>
                        </div>
                        <div>
                            <input type="text" name="last_name" placeholder="Apellido *"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;" required>
                        </div>
                        <div>
                            <input type="email" name="email" placeholder="Email *"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;" required>
                        </div>
                        <div>
                            <input type="text" name="phone_number" placeholder="Teléfono *"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;" required>
                        </div>
                        <div class="col-span-2">
                            <input type="text" name="role" placeholder="Cargo / Rol en la empresa *"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;" required>
                        </div>
                    </div>
                    <button type="submit"
                            class="text-white text-xs font-medium px-4 py-2 rounded-lg"
                            style="background: #00a86b;" onmouseover="this.style.background='#007a4f'" onmouseout="this.style.background='#00a86b'">
                        Agregar contacto
                    </button>
                </form>
            </div>

            {# Lista de contactos #}
            {% if contacts is empty %}
                <div class="px-6 py-8 text-center text-sm text-gray-400">
                    No hay contactos registrados para este cliente.
                </div>
            {% else %}
                <div class="divide-y divide-gray-100">
                    {% for contact in contacts %}
                        {% set linkedUser = linkedUsersByContactId[contact.id] ?? null %}
                        {% set autoOpenAccess = app.request.query.get('contactAccess') == contact.id %}
                        {% set autoOpenMode = app.request.query.get('contactMode') %}
                        <div class="px-6 py-4 space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                                     style="background: #1e3585;">
                                    {{ contact.firstName|slice(0,1) }}{{ contact.lastName|slice(0,1) }}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900">{{ contact.firstName }} {{ contact.lastName }}</p>
                                    <p class="text-xs text-gray-500">{{ contact.role }}</p>
                                </div>
                                <div class="text-right text-xs text-gray-400 shrink-0">
                                    <p>{{ contact.email }}</p>
                                    <p>{{ contact.phoneNumber }}</p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    {% if contact.status == 'active' %}
                                        <span class="text-xs px-2 py-0.5 rounded-full font-medium shrink-0" style="background: #e6f7f1; color: #00a86b;">Activo</span>
                                        {% if is_granted('contact.update') %}
                                        <form method="POST" action="{{ path('contact_deactivate', {clientId: client.id, contactId: contact.id}) }}">
                                            <button type="submit" class="text-xs px-2.5 py-1 rounded-md border border-amber-200 text-amber-700 bg-amber-50 hover:bg-amber-100">
                                                Desactivar
                                            </button>
                                        </form>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-xs px-2 py-0.5 rounded-full font-medium bg-gray-100 text-gray-500 shrink-0">Inactivo</span>
                                        {% if is_granted('contact.update') %}
                                        <form method="POST" action="{{ path('contact_reactivate', {clientId: client.id, contactId: contact.id}) }}">
                                            <button type="submit" class="text-xs px-2.5 py-1 rounded-md border border-emerald-200 text-emerald-700 bg-emerald-50 hover:bg-emerald-100">
                                                Reactivar
                                            </button>
                                        </form>
                                        {% endif %}
                                    {% endif %}
                                    {% if is_granted('contact.delete') %}
                                    <button type="button"
                                            class="text-xs px-2.5 py-1 rounded-md border border-red-200 text-red-700 bg-red-50 hover:bg-red-100"
                                            onclick="confirmDeleteContact('{{ path('contact_delete', {clientId: client.id, contactId: contact.id}) }}')">
                                        Eliminar
                                    </button>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="rounded-xl border border-gray-200 bg-gray-50/70 overflow-hidden">
                                <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between gap-3">
                                    <div>
                                        <p class="text-sm font-semibold text-gray-700">Acceso al sistema</p>
                                        <p class="text-xs text-gray-500">Gestiona el usuario del portal para este contacto.</p>
                                    </div>
                                    {% if linkedUser and is_granted('user.view') %}
                                        <a href="{{ path('user_show', {id: linkedUser.id}) }}" class="text-xs text-blue-600 hover:underline">Ver usuario</a>
                                    {% endif %}
                                </div>

                                {% if linkedUser %}
                                    <dl class="divide-y divide-gray-200 bg-white">
                                        <div class="px-4 py-3 flex justify-between text-sm gap-4">
                                            <dt class="text-gray-500">Usuario</dt>
                                            <dd class="text-gray-900 font-medium text-right">{{ linkedUser.username }}</dd>
                                        </div>
                                        <div class="px-4 py-3 flex justify-between text-sm gap-4">
                                            <dt class="text-gray-500">Rol</dt>
                                            <dd class="text-gray-800 text-right">{{ rolesById[linkedUser.roleId] ?? linkedUser.roleId }}</dd>
                                        </div>
                                        <div class="px-4 py-3 flex justify-between text-sm gap-4">
                                            <dt class="text-gray-500">Estado de cuenta</dt>
                                            <dd class="text-right">
                                                {% if linkedUser.status == 'active' %}
                                                    {{ ui.status_badge('active') }}
                                                {% elseif linkedUser.status == 'unverified' %}
                                                    {{ ui.status_badge('unverified') }}
                                                {% elseif linkedUser.status == 'inactive' %}
                                                    {{ ui.status_badge('inactive') }}
                                                {% else %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">{{ linkedUser.status }}</span>
                                                {% endif %}
                                            </dd>
                                        </div>
                                    </dl>
                                {% else %}
                                    <div class="bg-white divide-y divide-gray-200">
                                        {% if is_granted('user.create') %}
                                            <div class="px-4 py-4">
                                                <div class="flex items-center justify-between gap-3 mb-3">
                                                    <div>
                                                        <p class="text-sm font-medium text-gray-700">Crear acceso nuevo</p>
                                                        <p class="text-xs text-gray-500">Se usará {{ contact.email }} como correo de la cuenta.</p>
                                                    </div>
                                                    <button type="button"
                                                            data-toggle-target="contact-create-user-{{ contact.id }}"
                                                            data-open-label="Crear acceso"
                                                            data-close-label="Ocultar"
                                                            class="text-xs font-medium px-3 py-1.5 rounded-lg border border-blue-300 text-blue-700 hover:bg-blue-50">
                                                        {{ autoOpenAccess and autoOpenMode == 'create' ? 'Ocultar' : 'Crear acceso' }}
                                                    </button>
                                                </div>

                                                <form id="contact-create-user-{{ contact.id }}"
                                                      method="POST"
                                                      action="{{ path('contact_create_user', {clientId: client.id, contactId: contact.id}) }}"
                                                      class="{{ autoOpenAccess and autoOpenMode == 'create' ? '' : 'hidden' }} space-y-3">
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                        <div>
                                                            <label class="block text-xs font-medium text-gray-700 mb-1">Username</label>
                                                            <input type="text" name="username" maxlength="15" autocomplete="off"
                                                                   placeholder="ej: contacto.portal"
                                                                   class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                        </div>
                                                        <div>
                                                            <label class="block text-xs font-medium text-gray-700 mb-1">Rol</label>
                                                            <select name="role_id" class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                                <option value="">— Seleccione —</option>
                                                                {% for roleId, roleName in rolesById %}
                                                                    <option value="{{ roleId }}">{{ roleName }}</option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                        <div>
                                                            <label class="block text-xs font-medium text-gray-700 mb-1">Contraseña</label>
                                                            <input type="password" name="password" autocomplete="new-password"
                                                                   class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                        </div>
                                                        <div>
                                                            <label class="block text-xs font-medium text-gray-700 mb-1">Confirmar contraseña</label>
                                                            <input type="password" name="password_confirm" autocomplete="new-password"
                                                                   class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                        </div>
                                                    </div>
                                                    <button type="submit"
                                                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
                                                            style="background: #1e3585;"
                                                            onmouseover="this.style.background='#152970'"
                                                            onmouseout="this.style.background='#1e3585'">
                                                        Crear acceso
                                                    </button>
                                                </form>
                                            </div>
                                        {% endif %}

                                        {% if is_granted('contact.update') and availableUsers is not empty %}
                                            <div class="px-4 py-4">
                                                <button type="button"
                                                        data-toggle-target="contact-link-user-{{ contact.id }}"
                                                        data-open-label="Vincular usuario existente"
                                                        data-close-label="Ocultar vinculación"
                                                        class="text-xs text-gray-500 hover:text-gray-700 flex items-center gap-1">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                                                    </svg>
                                                    {{ autoOpenAccess and autoOpenMode == 'link' ? 'Ocultar vinculación' : 'Vincular usuario existente' }}
                                                </button>
                                                <form id="contact-link-user-{{ contact.id }}"
                                                      method="POST"
                                                      action="{{ path('contact_link_user', {clientId: client.id, contactId: contact.id}) }}"
                                                      class="{{ autoOpenAccess and autoOpenMode == 'link' ? '' : 'hidden' }} mt-3 flex flex-col md:flex-row md:items-end gap-3">
                                                    <div class="flex-1">
                                                        <select name="user_id" required
                                                                class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                            <option value="">— Selecciona un usuario —</option>
                                                            {% for user in availableUsers %}
                                                                <option value="{{ user.id }}">
                                                                    {{ user.username }}{% if rolesById[user.roleId] is defined %} ({{ rolesById[user.roleId] }}){% endif %}
                                                                </option>
                                                            {% endfor %}
                                                        </select>
                                                    </div>
                                                    <button type="submit"
                                                            class="inline-flex items-center text-white text-sm font-medium px-4 py-2 rounded-lg"
                                                            style="background: #6b7280;"
                                                            onmouseover="this.style.background='#4b5563'"
                                                            onmouseout="this.style.background='#6b7280'">
                                                        Vincular
                                                    </button>
                                                </form>
                                            </div>
                                        {% endif %}

                                        {% if not is_granted('user.create') and not is_granted('contact.update') %}
                                            <div class="px-4 py-4 text-sm text-gray-500">
                                                No tienes permisos para gestionar el acceso al sistema de este contacto.
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </div>

    {# Tab: Terminales #}
    <div id="tab-terminals" class="tab-content hidden">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                <h3 class="text-sm font-semibold" style="color: #1e3585;">
                    Terminales
                    <span class="ml-2 text-xs font-normal text-gray-400">{{ terminals|default([])|length }} registrado{{ terminals|default([])|length != 1 ? 's' : '' }}</span>
                </h3>
            </div>

            {# Formulario nuevo terminal #}
            <div class="px-6 py-4 border-b border-gray-100" style="background: #f8f9fc;">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Registrar terminal</p>
                <form method="POST" action="{{ path('client_terminal_create', {clientId: client.id}) }}" novalidate>
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <input type="text" name="serial" placeholder="Número de serie *"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none"
                                   onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                   style="transition: border-color .15s;" required>
                        </div>
                        <div>
                            <select name="vendor" required
                                    class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none bg-white"
                                    onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                    style="transition: border-color .15s;">
                                <option value="">— Fabricante * —</option>
                                <option value="hyosung">Hyosung</option>
                                <option value="diebold">Diebold Nixdorf</option>
                                <option value="ncr">NCR</option>
                                <option value="grg">GRG</option>
                            </select>
                        </div>
                        <div>
                            <select name="funcionality" required
                                    class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none bg-white"
                                    onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                    style="transition: border-color .15s;">
                                <option value="">— Funcionalidad * —</option>
                                <option value="dispenser">Dispensador</option>
                                <option value="recycler">Reciclador</option>
                                <option value="multinfunction">Multifunción</option>
                                <option value="counter">Contador (TCR)</option>
                            </select>
                        </div>
                        <div>
                            <select name="type" required
                                    class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none bg-white"
                                    onfocus="this.style.borderColor='#1e3585'" onblur="this.style.borderColor=''"
                                    style="transition: border-color .15s;">
                                <option value="">— Tipo * —</option>
                                <option value="lobby">ATM Lobby</option>
                                <option value="ttw">ATM TTW</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit"
                            class="text-white text-xs font-medium px-4 py-2 rounded-lg"
                            style="background: #00a86b;" onmouseover="this.style.background='#007a4f'" onmouseout="this.style.background='#00a86b'">
                        Registrar terminal
                    </button>
                </form>
            </div>

            {# Lista de terminales #}
            {% if terminals is defined and terminals is not empty %}
                <div class="px-6 py-8 text-center text-sm text-gray-400">
                    No hay terminales registrados para este cliente.
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                            <tr>
                                <th class="px-6 py-3.5 text-left font-semibold">Serial</th>
                                <th class="px-6 py-3.5 text-left font-semibold">Tipo</th>
                                <th class="px-6 py-3.5 text-left font-semibold">Fabricante</th>
                                <th class="px-6 py-3.5 text-left font-semibold">Funcionalidad</th>
                                <th class="px-6 py-3.5 text-left font-semibold">Estado</th>
                                <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for terminal in terminals %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4">
                                        <a href="{{ path('client_terminal_show', {clientId: client.id, id: terminal.id}) }}"
                                           class="font-mono font-medium text-blue-700 hover:text-blue-900 hover:underline">
                                            {{ terminal.serial }}
                                        </a>
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        {% if terminal.type == 'lobby' %}
                                            ATM Lobby
                                        {% elseif terminal.type == 'ttw' %}
                                            ATM TTW
                                        {% else %}
                                            {{ terminal.type }}
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        {% if terminal.vendor == 'hyosung' %}
                                            Hyosung
                                        {% elseif terminal.vendor == 'diebold' %}
                                            Diebold Nixdorf
                                        {% elseif terminal.vendor == 'ncr' %}
                                            NCR
                                        {% elseif terminal.vendor == 'grg' %}
                                            GRG
                                        {% else %}
                                            {{ terminal.vendor }}
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        {% if terminal.funcionality == 'dispenser' %}
                                            Dispensador
                                        {% elseif terminal.funcionality == 'recycler' %}
                                            Reciclador
                                        {% elseif terminal.funcionality == 'multinfunction' %}
                                            Multifunción
                                        {% elseif terminal.funcionality == 'counter' %}
                                            Contador (TCR)
                                        {% else %}
                                            {{ terminal.funcionality }}
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4">{{ ui.status_badge(terminal.status) }}</td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="{{ path('client_terminal_show', {clientId: client.id, id: terminal.id}) }}"
                                               class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-md border border-blue-200 text-blue-700 bg-blue-50 hover:bg-blue-100 transition-colors">
                                                Ver
                                            </a>
                                            {% if is_granted('terminal.delete') and terminal.status == 'active' %}
                                                <form method="POST" action="{{ path('client_terminal_delete', {clientId: client.id, id: terminal.id}) }}"
                                                      onsubmit="return confirm('¿Está seguro de eliminar este terminal?');">
                                                    <button type="submit"
                                                            class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-md border border-red-200 text-red-700 bg-red-50 hover:bg-red-100 transition-colors">
                                                        Eliminar
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    </div>

    {# Tab: Asignaciones #}
    <div id="tab-assignments" class="tab-content hidden">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                <h3 class="text-sm font-semibold" style="color: #1e3585;">
                    Asignaciones de terminales
                </h3>
                {% if is_granted('terminal.create') %}
                    <a href="{{ path('client_terminal_assignment_new', {clientId: client.id}) }}"
                       class="inline-flex items-center gap-2 text-white text-xs font-medium px-4 py-2 rounded-lg"
                       style="background: #00a86b;" onmouseover="this.style.background='#007a4f'" onmouseout="this.style.background='#00a86b'">
                        Nueva asignación
                    </a>
                {% endif %}
            </div>
            <div class="px-6 py-8 text-center text-sm text-gray-400">
                <p>Gestiona las asignaciones de terminales desde la
                    <a href="{{ path('client_terminal_assignment_list', {clientId: client.id}) }}"
                       class="text-blue-600 hover:underline font-medium">página de asignaciones</a>.
                </p>
            </div>
        </div>
    </div>

    {# Modales de confirmación #}

    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-deactivate-client',
        title: 'Desactivar cliente',
        message: '¿Está seguro de desactivar el cliente ' ~ client.name ~ '?',
        action: path('client_deactivate', {id: client.id}),
        confirmText: 'Desactivar',
        confirmStyle: 'amber',
    } %}

    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-delete-client',
        title: 'Eliminar cliente',
        message: '¿Está seguro de eliminar lógicamente el cliente ' ~ client.name ~ '?',
        action: path('client_delete', {id: client.id}),
        confirmText: 'Eliminar',
        confirmStyle: 'red',
    } %}

    
    {% include 'components/_confirm_modal.html.twig' with {
        id: 'modal-confirm-delete-contact',
        title: 'Eliminar contacto',
        message: '¿Está seguro de eliminar este contacto?',
        action: '',
        confirmText: 'Eliminar',
        confirmStyle: 'red',
    } %}

        <script>
        function switchTab(name) {
            document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.add('hidden'); });
            document.querySelectorAll('.tab-btn').forEach(function(el) {
                el.classList.remove('text-blue-600', 'border-blue-600', 'text-gray-900');
                el.classList.add('text-gray-500', 'border-transparent');
            });
            var content = document.getElementById('tab-' + name);
            if (content) content.classList.remove('hidden');
            var btn = document.querySelector('[data-tab="' + name + '"]');
            if (btn) {
                btn.classList.remove('text-gray-500', 'border-transparent');
                btn.classList.add('text-blue-600', 'border-blue-600');
            }
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function confirmDeleteContact(actionUrl) {
            var form = document.querySelector('#modal-confirm-delete-contact form');
            if (form) form.action = actionUrl;
            openModal('modal-confirm-delete-contact');
        }

        (function() {
            var toggle = document.getElementById('toggle-edit-client-tab') || document.getElementById('toggle-edit-client');
            var view   = document.getElementById('view-client');
            var form   = document.getElementById('form-edit-client');
            var cancel = document.getElementById('cancel-edit-client');
            if (form && !form.classList.contains('hidden')) {
                toggle && toggle.classList.add('hidden');
            }
            toggle && toggle.addEventListener('click', function() {
                view.classList.add('hidden');
                form.classList.remove('hidden');
                toggle.classList.add('hidden');
            });
            cancel && cancel.addEventListener('click', function() {
                view.classList.remove('hidden');
                form.classList.add('hidden');
                toggle.classList.remove('hidden');
            });

            document.querySelectorAll('[data-toggle-target]').forEach(function(button) {
                var targetId = button.getAttribute('data-toggle-target');
                var target = document.getElementById(targetId);
                var openLabel = button.getAttribute('data-open-label') || 'Mostrar';
                var closeLabel = button.getAttribute('data-close-label') || 'Ocultar';
                if (!target) return;
                if (!target.classList.contains('hidden')) {
                    button.textContent = closeLabel;
                }
                button.addEventListener('click', function() {
                    target.classList.toggle('hidden');
                    button.textContent = target.classList.contains('hidden') ? openLabel : closeLabel;
                });
            });

            switchTab('info');
        })();
    </script>
{% endblock %}


