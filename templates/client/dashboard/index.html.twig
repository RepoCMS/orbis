{% extends 'base.html.twig' %}

{% block title %}Dashboard Clientes{% endblock %}
{% block page_title %}Dashboard Clientes{% endblock %}

{% block header_actions %}
    {% include 'components/_export_buttons.html.twig' with {
        export_excel_url: '#',
        export_pdf_url: '#',
        label: 'Clientes',
        show_date_range: true,
    } %}
{% endblock %}

{% block body %}
<div data-controller="dashboard"
     data-dashboard-current-range-value="{{ range ?? 'today' }}">

    {# ── Barra de filtros ── #}
    <div class="mb-4">
        {% include 'components/_date_filter.html.twig' with {
            current_range: range ?? 'today',
            date_from: date_from ?? '',
            date_to: date_to ?? '',
        } %}
    </div>

    <turbo-frame id="dashboard-content" data-dashboard-target="contentFrame">
    <div class="space-y-6">

        {# ════════════════════════════════════════════════════
           ROW 1 — KPI Cards (4 columns)
           ════════════════════════════════════════════════════ #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {% for card in kpiCards %}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 flex flex-col gap-1">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">{{ card.label }}</p>
                    <svg class="w-4 h-4 shrink-0" style="color: {{ card.color }};" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="{{ card.icon }}"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold mt-1" style="color: {{ card.color }}">{{ card.value|orbis_format_number }}</p>
            </div>
            {% endfor %}
        </div>

        {# ════════════════════════════════════════════════════
           ROW 2 — Terminals by status + Clients by status
           ════════════════════════════════════════════════════ #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            {# Left: Terminals by status bars #}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-gray-700 mb-4">Terminales por estado</h3>
                {% if terminalsByStatus is empty %}
                    {% include 'components/_empty_state.html.twig' with {
                        icon: 'chart',
                        title: 'Sin terminales',
                        message: 'No hay terminales registrados.',
                    } %}
                {% else %}
                <div class="space-y-4">
                    {% for row in terminalsByStatus %}
                    {% set pct = maxBreakdown > 0 ? ((row.count / maxBreakdown) * 100)|round : 0 %}
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-gray-600 font-medium">{{ row.label }}</span>
                            <span class="font-bold text-gray-700">{{ row.count|orbis_format_number }}</span>
                        </div>
                        <div class="bg-gray-100 rounded-full h-3 overflow-hidden">
                            <div class="h-full rounded-full transition-all" style="width:{{ pct }}%; background:{{ row.color }};"></div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
                    <span>Total terminales: <strong class="text-gray-700">{{ summary.totalTerminals|orbis_format_number }}</strong></span>
                    <span>Sin asignación: <strong class="text-gray-700">{{ summary.unassignedTerminals|orbis_format_number }}</strong></span>
                </div>
            </div>

            {# Right: Clients by status bars #}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-gray-700 mb-4">Clientes por estado</h3>
                {% if clientsByStatus is empty %}
                    {% include 'components/_empty_state.html.twig' with {
                        icon: 'users',
                        title: 'Sin clientes',
                        message: 'No hay clientes registrados.',
                    } %}
                {% else %}
                <div class="space-y-4">
                    {% for row in clientsByStatus %}
                    {% set pct = maxClientsBreakdown > 0 ? ((row.count / maxClientsBreakdown) * 100)|round : 0 %}
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-gray-600 font-medium">{{ row.label }}</span>
                            <span class="font-bold text-gray-700">{{ row.count|orbis_format_number }}</span>
                        </div>
                        <div class="bg-gray-100 rounded-full h-3 overflow-hidden">
                            <div class="h-full rounded-full transition-all" style="width:{{ pct }}%; background:{{ row.color }};"></div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
                    <span>Total clientes: <strong class="text-gray-700">{{ summary.totalClients|orbis_format_number }}</strong></span>
                    <span>Contactos activos: <strong class="text-gray-700">{{ summary.activeContacts|orbis_format_number }}</strong></span>
                </div>
            </div>
        </div>

        {# ════════════════════════════════════════════════════
           ROW 3 — Contacts by status + Contracts expiring
           ════════════════════════════════════════════════════ #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            {# Left: Contacts by status #}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-gray-700 mb-4">Contactos por estado</h3>
                {% if contactsByStatus is empty %}
                    {% include 'components/_empty_state.html.twig' with {
                        icon: 'users',
                        title: 'Sin contactos',
                        message: 'No hay contactos registrados.',
                    } %}
                {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                <th class="px-4 py-3 text-left">Estado</th>
                                <th class="px-4 py-3 text-right">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            {% for row in contactsByStatus %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 font-medium text-gray-700">{{ row.label }}</td>
                                <td class="px-4 py-3 text-right font-bold text-gray-800">{{ row.count|orbis_format_number }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>

            {# Right: Contracts expiring #}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-gray-700 mb-4">Contratos por vencer</h3>
                {% if contractsExpiring is empty %}
                    {% include 'components/_empty_state.html.twig' with {
                        icon: 'document',
                        title: 'Sin contratos próximos a vencer',
                        message: 'No hay contratos activos próximos a vencer.',
                    } %}
                {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                <th class="px-4 py-3 text-left">Período</th>
                                <th class="px-4 py-3 text-right">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            {% for row in contractsExpiring %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 font-medium text-gray-700">{{ row.label }}</td>
                                <td class="px-4 py-3 text-right font-bold text-gray-800">{{ row.count|orbis_format_number }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>

        {# ════════════════════════════════════════════════════
           ROW 4 — Top clients by terminals + Quick actions
           ════════════════════════════════════════════════════ #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            {# Left: Top clients #}
            <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-gray-700 mb-4">Top clientes por terminales</h3>
                {% if topClientsByTerminals is empty %}
                    {% include 'components/_empty_state.html.twig' with {
                        icon: 'chart',
                        title: 'Sin datos',
                        message: 'No hay clientes con terminales registrados.',
                    } %}
                {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                                <th class="px-4 py-3 text-left">#</th>
                                <th class="px-4 py-3 text-left">Cliente</th>
                                <th class="px-4 py-3 text-right">Terminales</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            {% for row in topClientsByTerminals %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-xs text-gray-400">{{ loop.index }}</td>
                                <td class="px-4 py-3 font-medium text-gray-800">
                                    <a href="{{ path('client_show', {id: row.clientId}) }}" class="text-blue-600 hover:underline">{{ row.clientName }}</a>
                                </td>
                                <td class="px-4 py-3 text-right font-bold text-gray-800">{{ row.terminalCount|orbis_format_number }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>

            {# Right: Quick actions #}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-gray-700 mb-4">Acceso rápido</h3>
                <div class="space-y-3">
                    <a href="{{ path('client_list') }}"
                       class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition-all">
                        <svg class="w-5 h-5 shrink-0" style="color:#1e3585;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-gray-700">Ver clientes</p>
                            <p class="text-xs text-gray-400">Listado completo con filtros</p>
                        </div>
                    </a>
                    {% if is_granted('client.create') %}
                    <a href="{{ path('client_new') }}"
                       class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition-all">
                        <svg class="w-5 h-5 shrink-0" style="color:#1e3585;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-gray-700">Nuevo cliente</p>
                            <p class="text-xs text-gray-400">Registrar un nuevo cliente</p>
                        </div>
                    </a>
                    {% endif %}
                    <a href="{{ path('client_import') }}"
                       class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition-all">
                        <svg class="w-5 h-5 shrink-0" style="color:#1e3585;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
                        </svg>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-gray-700">Importar datos</p>
                            <p class="text-xs text-gray-400">Carga masiva de clientes y terminales</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        {# ════════════════════════════════════════════════════
           ROW 5 — Monthly client growth chart
           ════════════════════════════════════════════════════ #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Crecimiento mensual de clientes (últimos 12 meses)</h3>
            {% if monthlyGrowth is empty %}
                {% include 'components/_empty_state.html.twig' with {
                    icon: 'chart',
                    title: 'Sin datos',
                    message: 'No hay datos de crecimiento mensual disponibles.',
                } %}
            {% else %}
            {% set maxGrowth = 1 %}
            {% for row in monthlyGrowth %}
                {% if row.count > maxGrowth %}
                    {% set maxGrowth = row.count %}
                {% endif %}
            {% endfor %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                            <th class="px-4 py-3 text-left">Mes</th>
                            <th class="px-4 py-3 text-right">Nuevos clientes</th>
                            <th class="px-4 py-3 w-1/2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {% for row in monthlyGrowth %}
                        {% set barPct = ((row.count / maxGrowth) * 100)|round %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-2.5 font-medium text-gray-700">{{ row.month }}</td>
                            <td class="px-4 py-2.5 text-right font-bold text-gray-800">{{ row.count|orbis_format_number }}</td>
                            <td class="px-4 py-2.5">
                                <div class="bg-blue-100 rounded-full h-3 overflow-hidden" style="width: {{ barPct }}%; min-width: 4px;">
                                    <div class="h-full rounded-full bg-blue-600" style="width: 100%;"></div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

        {# ════════════════════════════════════════════════════
           ROW 3 — Recent clients table
           ════════════════════════════════════════════════════ #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-sm font-semibold text-gray-700">Clientes recientes</h3>
                <a href="{{ path('client_list') }}" class="text-xs text-blue-600 hover:underline font-medium">
                    Ver todos →
                </a>
            </div>

            {% if recentClients is empty %}
                {% include 'components/_empty_state.html.twig' with {
                    icon: 'users',
                    title: 'Sin clientes',
                    message: 'No hay clientes registrados.',
                    action_url: is_granted('client.create') ? path('client_new') : null,
                    action_label: is_granted('client.create') ? 'Registrar cliente' : null,
                } %}
            {% else %}
            {% set statusBadge = {
                'active':   'bg-green-100 text-green-700',
                'inactive': 'bg-gray-100 text-gray-500',
            } %}
            {% set statusLabels = {
                'active':   'Activo',
                'inactive': 'Inactivo',
            } %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                            <th class="px-5 py-3 text-left">Nombre</th>
                            <th class="px-5 py-3 text-left">RUC</th>
                            <th class="px-5 py-3 text-center">Estado</th>
                            <th class="px-5 py-3 text-right">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {% for client in recentClients %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-5 py-3 font-medium text-gray-800">{{ client.name }}</td>
                            <td class="px-5 py-3 font-mono text-xs text-gray-500">{{ client.ruc }}</td>
                            <td class="px-5 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium {{ statusBadge[client.status] ?? 'bg-gray-100 text-gray-600' }}">
                                    {{ statusLabels[client.status] ?? client.status }}
                                </span>
                            </td>
                            <td class="px-5 py-3 text-right">
                                <a href="{{ path('client_show', {id: client.id}) }}"
                                   class="inline-flex items-center gap-1 text-xs text-blue-600 hover:underline font-medium">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

    </div>
    </turbo-frame>
</div>
{% endblock %}
