<div data-controller="modal" id="{{ id }}">
    <div data-modal-target="backdrop"
         class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
         data-action="click->modal#closeBackdrop">
        <div data-modal-target="content"
             class="hidden bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">{{ title }}</h3>
            <p class="text-sm text-gray-600 mb-5">{{ message }}</p>
            <form method="POST" action="{{ action }}">
                <div class="flex justify-end gap-3">
                    <button type="button"
                            data-action="modal#close"
                            class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                        Volver
                    </button>
                    <button type="submit"
                            class="px-4 py-2 rounded-lg text-sm font-medium text-white {% if confirmStyle == 'red' %}bg-red-600 hover:bg-red-700{% elseif confirmStyle == 'amber' %}bg-amber-600 hover:bg-amber-700{% else %}bg-blue-600 hover:bg-blue-700{% endif %}">
                        {{ confirmText }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
