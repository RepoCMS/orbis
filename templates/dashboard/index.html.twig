{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard Operacional{% endblock %}

{% block body %}

{# ════════════════════════════════════════════════════
   ROW 1 — Top KPI cards
   ════════════════════════════════════════════════════ #}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

    {# Tickets abiertos #}
    <div class="bg-white rounded-xl shadow-sm p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wide text-blue-600">Tickets abiertos</span>
            <span class="w-8 h-8 flex items-center justify-center rounded-full" style="background:rgba(30,53,133,0.08)">
                <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a3 3 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                </svg>
            </span>
        </div>
        <span class="text-4xl font-bold text-gray-800">{{ metrics.ticketsOpenTotal }}</span>
        <span class="text-xs text-gray-400">en curso actualmente</span>
    </div>

    {# Tickets agendados hoy #}
    <div class="bg-white rounded-xl shadow-sm p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Agendados hoy</span>
            {% set diff = metrics.ticketsTodayVsYesterdayDiff() %}
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full
                         {{ diff > 0 ? 'bg-red-50 text-red-600' : (diff < 0 ? 'bg-green-50 text-green-600' : 'bg-gray-100 text-gray-400') }}">
                {{ diff > 0 ? '+' : '' }}{{ diff }} vs ayer
            </span>
        </div>
        <span class="text-4xl font-bold text-gray-800">{{ metrics.ticketsCreatedToday }}</span>
        <span class="text-xs text-gray-400">ayer: {{ metrics.ticketsCreatedYesterday }}</span>
    </div>

    {# Reparaciones en curso #}
    <div class="bg-white rounded-xl shadow-sm p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wide text-amber-600">Reparaciones</span>
            {% set rdiff = metrics.repairsVsYesterdayDiff() %}
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full
                         {{ rdiff > 0 ? 'bg-green-50 text-green-600' : (rdiff < 0 ? 'bg-red-50 text-red-600' : 'bg-gray-100 text-gray-400') }}">
                {{ rdiff > 0 ? '+' : '' }}{{ rdiff }} vs ayer
            </span>
        </div>
        <span class="text-4xl font-bold text-gray-800">{{ metrics.repairsInProgress }}</span>
        <span class="text-xs text-gray-400">completadas hoy: {{ metrics.repairsCompletedToday }}</span>
    </div>

    {# Movimientos de stock hoy #}
    <div class="bg-white rounded-xl shadow-sm p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wide text-teal-600">Movim. de stock</span>
            {% set mdiff = metrics.movementsVsYesterdayDiff() %}
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full
                         {{ mdiff > 0 ? 'bg-green-50 text-green-600' : (mdiff < 0 ? 'bg-gray-100 text-gray-400' : 'bg-gray-100 text-gray-400') }}">
                {{ mdiff > 0 ? '+' : '' }}{{ mdiff }} vs ayer
            </span>
        </div>
        <span class="text-4xl font-bold text-gray-800">{{ metrics.stockMovementsToday }}</span>
        <span class="text-xs text-gray-400">ayer: {{ metrics.stockMovementsYesterday }}</span>
    </div>

</div>

{# ════════════════════════════════════════════════════
   ROW 2 — Breakdown + Alerts
   ════════════════════════════════════════════════════ #}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">

    {# Tickets by service type — bar chart #}
    <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Tickets abiertos por tipo de servicio</h3>
        {% if metrics.ticketsByServiceType is empty %}
            <p class="text-sm text-gray-400 py-6 text-center">No hay tickets abiertos.</p>
        {% else %}
            {% set maxVal = 0 %}
            {% for row in metrics.ticketsByServiceType %}
                {% if row.total > maxVal %}{% set maxVal = row.total %}{% endif %}
            {% endfor %}
            {% set serviceLabels = {
                'preventive':  'Preventivo',
                'corrective':  'Correctivo',
                'installation': 'Instalación',
                'removal':     'Retiro',
                'emergency':   'Emergencia',
                'visit':       'Visita',
                'audit':       'Auditoría'
            } %}
            <div class="space-y-3">
                {% for row in metrics.ticketsByServiceType %}
                {% set pct = maxVal > 0 ? ((row.total / maxVal) * 100)|round : 0 %}
                <div class="flex items-center gap-3">
                    <span class="w-28 text-xs text-gray-600 truncate text-right shrink-0">
                        {{ serviceLabels[row.service_type] ?? row.service_type }}
                    </span>
                    <div class="flex-1 bg-gray-100 rounded-full h-5 relative overflow-hidden">
                        <div class="h-full rounded-full transition-all" style="width:{{ pct }}%; background:#1e3585;"></div>
                    </div>
                    <span class="w-6 text-xs font-bold text-gray-700 shrink-0">{{ row.total }}</span>
                </div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="mt-4 pt-3 border-t border-gray-50 text-xs text-gray-400">
            Cerrados este mes: <span class="font-semibold text-gray-600">{{ metrics.ticketsClosedThisMonth }}</span>
        </div>
    </div>

    {# Stock alerts #}
    <div class="bg-white rounded-xl shadow-sm p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
            </svg>
            Alertas de stock mínimo
        </h3>
        {% if metrics.stockAlerts is empty %}
            <div class="flex flex-col items-center justify-center py-8 text-gray-300">
                <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="text-sm">Sin alertas activas</p>
            </div>
        {% else %}
            <ul class="space-y-3">
                {% for alert in metrics.stockAlerts %}
                <li class="border-l-4 border-amber-400 bg-amber-50 rounded-r-lg px-3 py-2">
                    <p class="text-xs font-semibold text-gray-800 truncate">{{ alert.productName }}</p>
                    <p class="text-xs text-gray-500">{{ alert.locationName }}</p>
                    <p class="text-xs mt-0.5">
                        <span class="font-bold text-red-600">{{ alert.current }}</span>
                        <span class="text-gray-400"> / mín. {{ alert.alert_threshold }}</span>
                    </p>
                </li>
                {% endfor %}
            </ul>
            <a href="{{ path('inventory_stock_overview') }}"
               class="block mt-3 text-xs text-center text-blue-600 hover:underline">
                Ver todo el stock →
            </a>
        {% endif %}
    </div>

</div>

{# ════════════════════════════════════════════════════
   ROW 3 — Recent tickets table
   ════════════════════════════════════════════════════ #}
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-700">Tickets recientes</h3>
        {# TODO: link to ticket list when Support presentation layer is done #}
    </div>
    {% if metrics.recentTickets is empty %}
        <p class="text-sm text-gray-400 px-5 py-8 text-center">No hay tickets registrados.</p>
    {% else %}
        {% set statusLabels = {
            'created':          'Creado',
            'assigned':         'Asignado',
            'in_transit_out':   'En ruta (salida)',
            'waiting':          'En espera',
            'in_assistance':    'En asistencia',
            'paused':           'Pausado',
            'in_transit_back':  'En ruta (regreso)',
            'pending_closure':  'Pend. cierre',
            'closed':           'Cerrado',
            'cancelled':        'Cancelado'
        } %}
        {% set statusColors = {
            'created':          'bg-gray-100 text-gray-600',
            'assigned':         'bg-blue-100 text-blue-700',
            'in_transit_out':   'bg-indigo-100 text-indigo-700',
            'waiting':          'bg-yellow-100 text-yellow-700',
            'in_assistance':    'bg-green-100 text-green-700',
            'paused':           'bg-orange-100 text-orange-700',
            'in_transit_back':  'bg-purple-100 text-purple-700',
            'pending_closure':  'bg-teal-100 text-teal-700',
            'closed':           'bg-slate-100 text-slate-500',
            'cancelled':        'bg-red-100 text-red-600'
        } %}
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                        <th class="px-4 py-3 text-left">N° Ticket</th>
                        <th class="px-4 py-3 text-left">Tipo servicio</th>
                        <th class="px-4 py-3 text-left">Agendado</th>
                        <th class="px-4 py-3 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    {% for t in metrics.recentTickets %}
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 font-mono text-xs font-semibold text-gray-700">{{ t.ticketNumber }}</td>
                        <td class="px-4 py-3 text-gray-600">{{ serviceLabels[t.serviceType] ?? t.serviceType }}</td>
                        <td class="px-4 py-3 text-gray-500 text-xs">
                            {{ t.scheduledAt ? t.scheduledAt|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full {{ statusColors[t.status] ?? 'bg-gray-100 text-gray-500' }}">
                                {{ statusLabels[t.status] ?? t.status }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% endblock %}
