{% extends 'base.html.twig' %}

{% block title %}Dashboard Organización{% endblock %}
{% block page_title %}Dashboard Organización{% endblock %}

{% block body %}
<div class="space-y-6">

    {# ════════════════════════════════════════════════════
       ROW 1 — KPI Cards
       ════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total empleados</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ metrics.totalEmployees|orbis_format_number }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Activos</p>
            <p class="text-2xl font-bold text-green-700 mt-1">{{ metrics.active|orbis_format_number }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">De guardia</p>
            <p class="text-2xl font-bold text-blue-700 mt-1">{{ metrics.onDuty|orbis_format_number }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Vacaciones</p>
            <p class="text-2xl font-bold text-amber-600 mt-1">{{ metrics.onVacation|orbis_format_number }}</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Técnicos disponibles</p>
            <p class="text-2xl font-bold text-indigo-700 mt-1">{{ metrics.availableTechnicians|orbis_format_number }}
                <span class="text-sm font-medium text-gray-400">/ {{ metrics.totalTechnicians|orbis_format_number }}</span>
            </p>
        </div>
    </div>

    {# ════════════════════════════════════════════════════
       ROW 2 — Employees by status + Employees by zone
       ════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {# Left: Employees by status bars #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Empleados por estado</h3>
            {% set statusData = [
                { label: 'Activos', count: metrics.active, color: '#16a34a' },
                { label: 'Vacaciones', count: metrics.onVacation, color: '#f59e0b' },
                { label: 'Inactivos', count: metrics.inactive, color: '#9ca3af' },
            ] %}
            {% set maxStatus = [metrics.active, metrics.onVacation, metrics.inactive]|reduce((max, v) => max > v ? max : v, 0) %}
            <div class="space-y-4">
                {% for row in statusData %}
                {% set pct = maxStatus > 0 ? ((row.count / maxStatus) * 100)|round : 0 %}
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-600 font-medium">{{ row.label }}</span>
                        <span class="font-bold text-gray-700">{{ row.count|orbis_format_number }}</span>
                    </div>
                    <div class="bg-gray-100 rounded-full h-3 overflow-hidden">
                        <div class="h-full rounded-full transition-all" style="width:{{ pct }}%; background:{{ row.color }};"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# Right: Employees by zone #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Empleados por zona</h3>
            {% if metrics.employeesByZone is empty %}
                {% include 'components/_empty_state.html.twig' with {
                    icon: 'map',
                    title: 'Sin datos',
                    message: 'No hay empleados asignados a zonas.',
                } %}
            {% else %}
            {% set maxZone = metrics.employeesByZone|reduce((max, v) => max > v ? max : v, 0) %}
            <div class="space-y-4">
                {% for zoneId, count in metrics.employeesByZone %}
                {% set pct = maxZone > 0 ? ((count / maxZone) * 100)|round : 0 %}
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-600 font-medium">{{ zoneNames[zoneId] ?? zoneId }}</span>
                        <span class="font-bold text-gray-700">{{ count|orbis_format_number }}</span>
                    </div>
                    <div class="bg-gray-100 rounded-full h-3 overflow-hidden">
                        <div class="h-full rounded-full transition-all" style="width:{{ pct }}%; background:#3b82f6;"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
                <span>Zonas activas: <strong class="text-gray-700">{{ metrics.totalZones|orbis_format_number }}</strong></span>
            </div>
            {% endif %}
        </div>
    </div>

    {# ════════════════════════════════════════════════════
       ROW 3 — Overtime by employee + Avg tenure by profile
       ════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {# Left: Overtime by employee #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Horas extras del mes (aprobadas)</h3>
            {% if metrics.overtimeByEmployee is empty %}
                {% include 'components/_empty_state.html.twig' with {
                    icon: 'clock',
                    title: 'Sin registros',
                    message: 'No hay horas extras aprobadas este mes.',
                } %}
            {% else %}
            {% set maxHours = 1 %}
            {% for row in metrics.overtimeByEmployee %}
                {% if row.totalHours > maxHours %}
                    {% set maxHours = row.totalHours %}
                {% endif %}
            {% endfor %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                            <th class="px-4 py-3 text-left">Empleado</th>
                            <th class="px-4 py-3 text-right">Registros</th>
                            <th class="px-4 py-3 text-right">Horas</th>
                            <th class="px-4 py-3 w-1/3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {% for row in metrics.overtimeByEmployee %}
                        {% set barPct = ((row.totalHours / maxHours) * 100)|round %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-2.5 font-medium text-gray-700">{{ row.firstName }} {{ row.lastName }}</td>
                            <td class="px-4 py-2.5 text-right text-gray-600">{{ row.records|orbis_format_number }}</td>
                            <td class="px-4 py-2.5 text-right font-bold text-gray-800">{{ row.totalHours|number_format(1) }}</td>
                            <td class="px-4 py-2.5">
                                <div class="bg-amber-100 rounded-full h-3 overflow-hidden" style="width: {{ barPct }}%; min-width: 4px;">
                                    <div class="h-full rounded-full bg-amber-500" style="width: 100%;"></div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

        {# Right: Average tenure by profile #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Antigüedad promedio por perfil</h3>
            {% if metrics.avgTenureByProfile is empty %}
                {% include 'components/_empty_state.html.twig' with {
                    icon: 'users',
                    title: 'Sin datos',
                    message: 'No hay empleados registrados.',
                } %}
            {% else %}
            {% set maxTenure = 1 %}
            {% for row in metrics.avgTenureByProfile %}
                {% if row.avgDays > maxTenure %}
                    {% set maxTenure = row.avgDays %}
                {% endif %}
            {% endfor %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                            <th class="px-4 py-3 text-left">Perfil</th>
                            <th class="px-4 py-3 text-right">Empleados</th>
                            <th class="px-4 py-3 text-right">Antigüedad</th>
                            <th class="px-4 py-3 w-1/3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {% for row in metrics.avgTenureByProfile %}
                        {% set barPct = ((row.avgDays / maxTenure) * 100)|round %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-2.5 font-medium text-gray-700">{{ row.label }}</td>
                            <td class="px-4 py-2.5 text-right text-gray-600">{{ row.total|orbis_format_number }}</td>
                            <td class="px-4 py-2.5 text-right font-bold text-gray-800">{{ row.avgYears|number_format(1) }} años</td>
                            <td class="px-4 py-2.5">
                                <div class="bg-blue-100 rounded-full h-3 overflow-hidden" style="width: {{ barPct }}%; min-width: 4px;">
                                    <div class="h-full rounded-full bg-blue-600" style="width: 100%;"></div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>

    {# ════════════════════════════════════════════════════
       ROW 4 — Upcoming vacations
       ════════════════════════════════════════════════════ #}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Vacaciones programadas (próximos 30 días)</h3>
        {% if metrics.upcomingVacations is empty %}
            {% include 'components/_empty_state.html.twig' with {
                icon: 'calendar',
                title: 'Sin vacaciones programadas',
                message: 'No hay solicitudes de vacaciones aprobadas para los próximos 30 días.',
            } %}
        {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
                        <th class="px-4 py-3 text-left">Empleado</th>
                        <th class="px-4 py-3 text-left">Inicio</th>
                        <th class="px-4 py-3 text-left">Fin</th>
                        <th class="px-4 py-3 text-right">Días</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    {% for row in metrics.upcomingVacations %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-2.5 font-medium text-gray-700">{{ row.firstName }} {{ row.lastName }}</td>
                        <td class="px-4 py-2.5 text-gray-600">{{ row.startDate }}</td>
                        <td class="px-4 py-2.5 text-gray-600">{{ row.endDate }}</td>
                        <td class="px-4 py-2.5 text-right font-bold text-gray-800">{{ row.durationDays|orbis_format_number }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    {# ════════════════════════════════════════════════════
       ROW 5 — Quick actions
       ════════════════════════════════════════════════════ #}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Acceso rápido</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            <a href="{{ path('employee_list') }}"
               class="p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50 transition-colors text-sm font-medium text-gray-700 text-center">
                Empleados
            </a>
            <a href="{{ path('service_zone_list') }}"
               class="p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50 transition-colors text-sm font-medium text-gray-700 text-center">
                Zonas de servicio
            </a>
            <a href="{{ path('employee_new') }}"
               class="p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50 transition-colors text-sm font-medium text-gray-700 text-center">
                Nuevo empleado
            </a>
            {% if is_granted('organization.import') %}
            <a href="{{ path('organization_import') }}"
               class="p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50 transition-colors text-sm font-medium text-gray-700 text-center">
                Importar
            </a>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}
