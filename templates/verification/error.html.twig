{% extends 'base.html.twig' %}
{% block title %}Enlace inválido{% endblock %}
{% block page_title %}Error de verificación{% endblock %}
{% block body %}
    <div class="max-w-md mx-auto text-center py-16">
        <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-6 bg-red-50">
            <svg class="w-8 h-8" fill="none" stroke="#dc2626" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-800 mb-2">Enlace inválido</h2>
        <p class="text-gray-500 text-sm">{{ message }}</p>
        <p class="text-gray-400 text-xs mt-3">Solicita al administrador que reenvíe el correo de verificación.</p>
    </div>
{% endblock %}
