{% extends 'base.html.twig' %}
{% block title %}Cuenta verificada{% endblock %}
{% block page_title %}Verificación de cuenta{% endblock %}
{% block body %}
    <div class="max-w-md mx-auto text-center py-16">
        <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-6" style="background: #e6f7f1;">
            <svg class="w-8 h-8" fill="none" stroke="#00a86b" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-800 mb-2">¡Cuenta activada!</h2>
        <p class="text-gray-500 text-sm mb-8">Tu cuenta ha sido verificada y activada correctamente. Ya puedes iniciar sesión.</p>
    </div>
{% endblock %}
