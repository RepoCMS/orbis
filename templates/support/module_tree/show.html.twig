{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ node.label }} — Árbol de Módulos{% endblock %}
{% block page_title %}{{ node.label }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('support_module_tree_list', {model: model.value}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver al árbol
    </a>
{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto space-y-6">

    {# ── Breadcrumb ─────────────────────────────────────────────── #}
    <div class="flex items-center gap-2 text-xs text-gray-400">
        <a href="{{ path('support_module_tree_list') }}" class="hover:text-gray-600 transition-colors">Módulos</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="text-gray-600 font-medium">{{ model.label() }}</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
        <span>{{ node.code }}</span>
    </div>

    {# ── Node detail card ───────────────────────────────────────── #}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-gray-700">Información del Módulo</h2>
            <div class="flex items-center gap-2">
                <a href="{{ path('support_module_tree_edit', {code: node.code, model: model.value}) }}"
                   class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                    </svg>
                    Editar
                </a>
                <div data-controller="modal">
                    <button type="button"
                            data-action="modal#open"
                            class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        Eliminar
                    </button>

                    <div data-modal-target="backdrop"
                         class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
                         data-action="click->modal#closeBackdrop">
                        <div data-modal-target="content"
                             class="hidden bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4">
                            <h3 class="text-lg font-semibold text-gray-800 mb-2">Eliminar nodo</h3>
                            <p class="text-sm text-gray-600 mb-5">
                                ¿Eliminar <strong>{{ node.label }}</strong> ({{ node.code }}) y todos sus hijos?
                            </p>
                            <form method="POST" action="{{ path('support_module_tree_delete', {code: node.code, model: model.value}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-module-node') }}">
                                <div class="flex justify-end gap-3">
                                    <button type="button"
                                            data-action="modal#close"
                                            class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">
                                        Cancelar
                                    </button>
                                    <button type="submit"
                                            class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 shadow-sm">
                                        Eliminar
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <dl class="divide-y divide-gray-100">
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Nombre</dt>
                <dd class="text-gray-900 font-medium">{{ node.label }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Código</dt>
                <dd class="text-gray-800 font-mono font-semibold">{{ node.code }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Modelo</dt>
                <dd class="text-gray-800">{{ model.label() }}</dd>
            </div>
            {% if parent %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Módulo padre</dt>
                <dd>
                    <a href="{{ path('support_module_tree_show', {code: parent.code, model: model.value}) }}"
                       class="text-blue-700 hover:text-blue-900 font-medium">
                        {{ parent.label }}
                    </a>
                </dd>
            </div>
            {% endif %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Hijos</dt>
                <dd class="text-gray-800">{{ node.children|length }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Componentes</dt>
                <dd class="text-gray-800">{{ node.components|length }}</dd>
            </div>
        </dl>
    </div>

    {# ── Children ────────────────────────────────────────────────── #}
    {% if node.children is not empty %}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-gray-700">
                Sub-módulos
                <span class="ml-1.5 text-xs font-normal text-gray-400">({{ node.children|length }})</span>
            </h2>
            <a href="{{ path('support_module_tree_add_child', {code: node.code, model: model.value}) }}"
               class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-lg text-white transition-colors shadow-sm"
               style="background:#1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                Añadir hijo
            </a>
        </div>
        <div class="p-4">
            <div class="grid gap-3 sm:grid-cols-2">
                {% for child in node.children %}
                    <a href="{{ path('support_module_tree_show', {code: child.code, model: model.value}) }}"
                       class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all group">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-blue-50 text-blue-700 group-hover:bg-blue-100 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6z"/>
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate group-hover:text-blue-700 transition-colors">{{ child.label }}</p>
                            <p class="text-xs text-gray-400 font-mono">{{ child.code }} — {{ child.children|length + child.components|length }} elementos</p>
                        </div>
                        <svg class="w-4 h-4 ml-auto shrink-0 text-gray-300 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                        </svg>
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Components ─────────────────────────────────────────────── #}
    {% if node.components is not empty %}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h2 class="text-sm font-semibold text-gray-700">
                Componentes
                <span class="ml-1.5 text-xs font-normal text-gray-400">({{ node.components|length }})</span>
            </h2>
        </div>
        <div class="p-4">
            <div class="flex flex-wrap gap-2">
                {% for component in node.components %}
                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-medium bg-gray-100 text-gray-700 border border-gray-200">
                        {{ component }}
                    </span>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
