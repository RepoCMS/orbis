{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Editar' : 'Añadir' }} Nodo — Árbol de Módulos{% endblock %}
{% block page_title %}{{ isEdit ? 'Editar' : 'Añadir' }} Nodo{% endblock %}

{% block header_actions %}
    <a href="{{ isEdit ? path('support_module_tree_show', {code: node.code, model: model.value}) : path('support_module_tree_list', {model: model.value}) }}"
       class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
<div class="w-full max-w-2xl mx-auto space-y-6">

    {# ── Breadcrumb ─────────────────────────────────────────────── #}
    <div class="flex items-center gap-2 text-xs text-gray-400">
        <a href="{{ path('support_module_tree_list') }}" class="hover:text-gray-600 transition-colors">Módulos</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="text-gray-600">{{ model.label() }}</span>
        {% if parentCode or (node.code is defined and node.code is not empty) %}
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
        <span>{{ node.code }}</span>
        {% endif %}
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
        <span class="text-gray-600 font-medium">{{ isEdit ? 'Editar' : 'Añadir hijo' }}</span>
    </div>

    {# ── Form ───────────────────────────────────────────────────── #}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <form method="post" action="{{ isEdit
            ? path('support_module_tree_edit', {code: node.code, model: model.value})
            : path('support_module_tree_add_child', {code: parentCode, model: model.value})
        }}" class="space-y-5">

            {# Name #}
            <div>
                <label for="label" class="block text-sm font-medium text-gray-700 mb-1">
                    Nombre <span class="text-red-500">*</span>
                </label>
                <input type="text" id="label" name="label"
                       value="{{ isEdit ? node.label : '' }}"
                       placeholder="Ej: Bill Recycler Module"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                <p class="text-xs text-gray-400 mt-1">Nombre descriptivo del módulo.</p>
            </div>

            {# Code #}
            <div>
                <label for="code" class="block text-sm font-medium text-gray-700 mb-1">
                    Código <span class="text-red-500">*</span>
                </label>
                <input type="text" id="code" name="code"
                       value="{{ isEdit ? node.code : '' }}"
                       placeholder="Ej: BRM"
                       {{ isEdit ? 'readonly' : '' }}
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors {{ isEdit ? 'bg-gray-50 text-gray-500' : '' }}">
                <p class="text-xs text-gray-400 mt-1">Código único del módulo (ej: CE, BRM, CDU).{{ isEdit ? ' No se puede modificar.' : '' }}</p>
            </div>

            {# Components #}
            <div>
                <label for="components" class="block text-sm font-medium text-gray-700 mb-1">
                    Componentes
                </label>
                <textarea id="components" name="components" rows="4"
                          placeholder="Cada componente en una línea separada&#10;Ej: Main Board&#10;CPU&#10;RAM"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors font-mono">{% if isEdit %}{{ node.components|join("\n") }}{% endif %}</textarea>
                <p class="text-xs text-gray-400 mt-1">Un componente por línea. Son los elementos seleccionables al registrar un hallazgo.</p>
            </div>

            {# Model #}
            <div>
                <label for="model-select" class="block text-sm font-medium text-gray-700 mb-1">Modelo</label>
                <input type="text" id="model-select" readonly
                       value="{{ model.label() }}"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-gray-50 text-gray-500">
            </div>

            {# Actions #}
            <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
                <a href="{{ isEdit
                    ? path('support_module_tree_show', {code: node.code, model: model.value})
                    : path('support_module_tree_list', {model: model.value})
                }}"
                   class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit"
                        class="px-5 py-2 text-sm text-white rounded-lg font-medium shadow transition-colors"
                        style="background:#1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                    {{ isEdit ? 'Guardar cambios' : 'Crear nodo' }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
