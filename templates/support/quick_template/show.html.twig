{% extends 'base.html.twig' %}

{% block title %}{{ template.name }}{% endblock %}
{% block page_title %}{{ template.name }}{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Nombre</dt>
                    <dd class="mt-1 text-sm font-medium text-gray-900">{{ template.name }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Modelo</dt>
                    <dd class="mt-1 text-sm text-gray-700">{{ template.modelId|slice(0,8)~'…' }}</dd>
                </div>
                {% if template.description %}
                <div class="md:col-span-2">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Descripci&oacute;n</dt>
                    <dd class="mt-1 text-sm text-gray-700">{{ template.description }}</dd>
                </div>
                {% endif %}
            </dl>
        </div>

        <div class="mt-6 flex items-center gap-3">
            <a href="{{ path('support_quick_template_edit', {id: template.id}) }}"
               class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
               style="background: #1e3585;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                </svg>
                Editar
            </a>
            <form method="post" action="{{ path('support_quick_template_delete', {id: template.id}) }}" class="inline"
                  onsubmit="return confirm('¿Eliminar esta plantilla?')">
                <button type="submit"
                        class="inline-flex items-center gap-2 text-red-600 bg-red-50 text-sm font-medium px-4 py-2 rounded-lg hover:bg-red-100 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                    </svg>
                    Eliminar
                </button>
            </form>
            <a href="{{ path('support_quick_template_list') }}" class="text-sm text-gray-500 hover:underline ml-auto">Volver</a>
        </div>
    </div>
{% endblock %}
