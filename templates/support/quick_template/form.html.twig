{% extends 'base.html.twig' %}

{% block title %}{{ template ? 'Editar' : 'Nueva' }} plantilla r&aacute;pida{% endblock %}
{% block page_title %}{{ template ? 'Editar' : 'Nueva' }} plantilla r&aacute;pida{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <form method="post" action="{{ template ? path('support_quick_template_update', {id: template.id}) : path('support_quick_template_create') }}">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                        <input type="text" name="name" value="{{ template.name ?? '' }}" required maxlength="100"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Modelo</label>
                        <select name="modelId" {{ template ? 'disabled' : 'required' }}
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Seleccione un modelo</option>
                            {% for model in models %}
                            <option value="{{ model.id }}" {{ template and template.modelId == model.id ? 'selected' : '' }}>{{ model.name ?? model.id|slice(0,8) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Descripci&oacute;n</label>
                        <textarea name="description" rows="3" maxlength="500"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">{{ template.description ?? '' }}</textarea>
                    </div>
                    {% if template %}
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="isActive" id="isActive" value="1"
                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                               {{ template.isActive ? 'checked' : '' }} />
                        <label for="isActive" class="text-sm text-gray-600">Activa</label>
                    </div>
                    {% endif %}
                    <div class="flex items-center gap-3 pt-2">
                        <button type="submit"
                                class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
                                style="background: #1e3585;">
                            {{ template ? 'Actualizar' : 'Crear' }} plantilla
                        </button>
                        <a href="{{ path('support_quick_template_list') }}" class="text-sm text-gray-500 hover:underline">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
