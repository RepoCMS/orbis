<div data-finding-id="{{ finding.id }}"
     class="flex items-start gap-4 p-4 rounded-lg border border-gray-200 bg-white hover:shadow-sm transition-shadow">

    {# ── Type badge ────────────────────────────────────────────────── #}
    {% set typeColors = {
        'ok':       'bg-green-50 text-green-700 border-green-200',
        'faulty':   'bg-red-50 text-red-700 border-red-200',
        'replaced': 'bg-blue-50 text-blue-700 border-blue-200',
        'pending':  'bg-amber-50 text-amber-700 border-amber-200',
    } %}
    {% set typeLabels = {
        'ok':       'OK',
        'faulty':   'Falla',
        'replaced': 'Reemplazado',
        'pending':  'Pendiente',
    } %}

    <span class="shrink-0 px-2.5 py-1 rounded text-xs font-semibold border {{ typeColors[finding.findingType]|default('bg-gray-50 text-gray-600 border-gray-200') }}">
        {{ typeLabels[finding.findingType]|default(finding.findingType) }}
    </span>

    {# ── Content ───────────────────────────────────────────────────── #}
    <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 text-sm">
            <span class="font-mono text-xs text-gray-400">{{ finding.modulePath }}</span>
            <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
            <span class="font-medium text-gray-900">{{ finding.componentName }}</span>
        </div>
        {% if finding.notes %}
            <p class="text-xs text-gray-500 mt-1">{{ finding.notes }}</p>
        {% endif %}
        <p class="text-xs text-gray-400 mt-1">
            Registrado por <span class="font-medium">{{ finding.registeredBy }}</span>
            — {{ finding.registeredAt|date('d/m/Y H:i') }}
        </p>

        {% if finding.evidences is defined and finding.evidences|length > 0 %}
            <div class="mt-2 flex flex-wrap gap-1.5">
                {% for evidence in finding.evidences %}
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13"/>
                        </svg>
                        {{ evidence.filename|default('Evidencia') }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ── Actions ───────────────────────────────────────────────────── #}
    <div class="flex items-center gap-1 shrink-0">
        <button type="button" onclick="deleteModuleFinding('{{ finding.id }}')"
                class="w-7 h-7 flex items-center justify-center rounded text-gray-400 hover:text-red-700 hover:bg-red-50 transition-colors"
                title="Eliminar">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
</div>
