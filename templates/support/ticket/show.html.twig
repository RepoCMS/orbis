{% include 'support/ticket/_module_findings_form.html.twig' with {
    ticketId: ticket.id,
} %}

{% block javascripts %}
{{ parent() }}
<script>
function switchTab(name) {
    document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.add('hidden'); });
    document.querySelectorAll('.tab-btn').forEach(function(el) {
        el.classList.remove('text-blue-600', 'border-blue-600', 'text-gray-900');
        el.classList.add('text-gray-500', 'border-transparent');
    });
    var content = document.getElementById('tab-' + name);
    if (content) content.classList.remove('hidden');
    var btn = document.querySelector('[data-tab="' + name + '"]');
    if (btn) {
        btn.classList.remove('text-gray-500', 'border-transparent');
        btn.classList.add('text-blue-600', 'border-blue-600');
    }
}

function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
}

function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
}

function deleteModuleFinding(findingId) {
    if (!confirm('¿Eliminar este hallazgo de módulo?')) return;
    fetch('/api/v1/support/tickets/{{ ticket.id }}/module-findings/' + findingId, {
        method: 'DELETE',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(function (r) {
        if (r.ok) {
            var card = document.querySelector('[data-finding-id="' + findingId + '"]');
            if (card) card.remove();
        } else {
            alert('Error al eliminar');
        }
    });
}

// ── Init ──────────────────────────────────────────────────────────
function initTicketShow() {
    switchTab('info');
}

document.addEventListener('turbo:load', initTicketShow);
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTicketShow);
} else {
    initTicketShow();
}
</script>
{% endblock %}
{% endblock %}
