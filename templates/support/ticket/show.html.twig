{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Ticket {{ ticket.ticketNumber }}{% endblock %}
{% block page_title %}Ticket {{ ticket.ticketNumber }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('support_ticket_list') }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver
    </a>
{% endblock %}

{% block body %}
{% set statusColor = {
    'created':         'bg-gray-100 text-gray-700',
    'assigned':        'bg-blue-100 text-blue-700',
    'in_transit_out':  'bg-indigo-100 text-indigo-700',
    'waiting':         'bg-yellow-100 text-yellow-700',
    'in_assistance':   'bg-orange-100 text-orange-700',
    'paused':          'bg-red-100 text-red-700',
    'in_transit_back': 'bg-purple-100 text-purple-700',
    'pending_closure': 'bg-amber-100 text-amber-700',
    'reopened':        'bg-sky-100 text-sky-700',
    'closed':          'bg-green-100 text-green-700',
    'cancelled':       'bg-gray-200 text-gray-500',
} %}

{% set isTerminal = ticket.status in ['closed', 'cancelled'] %}

<div class="w-full max-w-5xl mx-auto space-y-6">

    {# ── Profile header ─────────────────────────────────────────── #}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                     style="background: #1e3585;">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a3 3 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-semibold text-gray-900">{{ ticket.ticketNumber }}</h1>
                    <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ statusColor[ticket.status] ?? 'bg-gray-100 text-gray-600' }}">
                            {{ ticket.statusLabel }}
                        </span>
                        <span class="text-gray-300">|</span>
                        <span>{{ ticket.serviceTypeLabel }}</span>
                        {% if ticket.interventionTypeLabel and ticket.interventionTypeLabel != ticket.serviceTypeLabel %}
                            <span class="text-gray-300">|</span>
                            <span>{{ ticket.interventionTypeLabel }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Header action buttons ─────────────────────────── #}
            <div class="flex flex-wrap items-center gap-2">
                {% if ticket.status in ['created', 'assigned', 'waiting'] and is_granted('ticket.update') %}
                    <a href="{{ path('support_ticket_edit', {id: ticket.id}) }}"
                       class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-gray-700 bg-gray-50 border-gray-200 hover:bg-gray-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                        </svg>
                        Editar
                    </a>
                {% endif %}

                {% if ticket.status == 'created' and is_granted('ticket.assign') %}
                    <button type="button" onclick="openModal('modal-assign')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        Asignar
                    </button>
                {% endif %}

                {% if ticket.status == 'assigned' %}
                    <button type="button" onclick="openModal('modal-reassign')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/>
                        </svg>
                        Reasignar
                    </button>
                    <form method="post" action="{{ path('support_ticket_start_journey', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-indigo-700 bg-indigo-50 border-indigo-200 hover:bg-indigo-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                            </svg>
                            Iniciar viaje
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status == 'in_transit_out' %}
                    <form method="post" action="{{ path('support_ticket_arrive_site', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-indigo-700 bg-indigo-50 border-indigo-200 hover:bg-indigo-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                            </svg>
                            Llegar al sitio
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status == 'waiting' %}
                    <form method="post" action="{{ path('support_ticket_start_assistance', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-orange-700 bg-orange-50 border-orange-200 hover:bg-orange-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z"/>
                            </svg>
                            Iniciar asistencia
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status == 'in_assistance' %}
                    <button type="button" onclick="openModal('modal-evidence')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
                        </svg>
                        Evidencia
                    </button>
                    <button type="button" onclick="openModal('modal-finding')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                        </svg>
                        Hallazgo
                    </button>
                    <button type="button" onclick="openModal('modal-module-finding')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                        </svg>
                        Módulo
                    </button>
                    <button type="button" onclick="openModal('modal-pause')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5"/>
                        </svg>
                        Pausar
                    </button>
                    <form method="post" action="{{ path('support_ticket_complete_assistance', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Completar
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status == 'paused' %}
                    <form method="post" action="{{ path('support_ticket_resume', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-orange-700 bg-orange-50 border-orange-200 hover:bg-orange-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"/>
                            </svg>
                            Reanudar
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status == 'pending_closure' and is_granted('ticket.approve') %}
                    <form method="post" action="{{ path('support_ticket_approve', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Aprobar y cerrar
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status == 'in_transit_back' %}
                    <form method="post" action="{{ path('support_ticket_arrive_base', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-indigo-700 bg-indigo-50 border-indigo-200 hover:bg-indigo-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                            </svg>
                            Llegar a base
                        </button>
                    </form>
                {% endif %}

                {% if ticket.status in ['closed', 'cancelled'] %}
                    <button type="button" onclick="openModal('modal-request-reopen')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-sky-700 bg-sky-50 border-sky-200 hover:bg-sky-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/>
                        </svg>
                        Solicitar reapertura
                    </button>
                {% endif %}

                {% if ticket.reopenRequestedReason and not ticket.reopenedAt and is_granted('ticket.approve') %}
                    <form method="post" action="{{ path('support_ticket_approve_reopen', {id: ticket.id}) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Aprobar reapertura
                        </button>
                    </form>
                {% endif %}

                {% if not isTerminal and ticket.status not in ['in_assistance', 'paused', 'pending_closure', 'in_transit_back'] %}
                    <button type="button" onclick="openModal('modal-cancel')"
                            class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-red-700 bg-red-50 border-red-200 hover:bg-red-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Cancelar
                    </button>
                {% endif %}

                {% if is_granted('ticket.update') %}
                    <form method="post" action="{{ path('support_ticket_delete', {id: ticket.id}) }}"
                          onsubmit="return confirm('¿Eliminar este ticket? Se marcará como eliminado pero los datos se conservarán.')">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border text-gray-500 bg-white border-gray-200 hover:bg-gray-50 hover:text-red-600 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                            </svg>
                            Eliminar
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        {# ── Tabs ─────────────────────────────────────────────── #}
        <div class="border-t border-gray-100">
            <nav class="flex px-6 overflow-x-auto" role="tablist">
                <button type="button" role="tab" data-tab="info"
                        class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                        onclick="switchTab('info')">
                    Información
                </button>
                <button type="button" role="tab" data-tab="findings"
                        class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                        onclick="switchTab('findings')">
                    Hallazgos
                    {% if ticket.finding %}<span class="ml-1.5 w-2 h-2 rounded-full bg-green-500 inline-block"></span>{% endif %}
                </button>
                <button type="button" role="tab" data-tab="modules"
                        class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                        onclick="switchTab('modules')">
                    Módulos
                    {% if ticket.moduleFindings|length > 0 %}<span class="ml-1.5 w-2 h-2 rounded-full bg-blue-500 inline-block"></span>{% endif %}
                </button>
                <button type="button" role="tab" data-tab="spareparts"
                        class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                        onclick="switchTab('spareparts')">
                    Repuestos
                    {% if ticket.finding and (ticket.finding.spareParts|length > 0 or ticket.finding.pendingSpareParts|length > 0) %}
                        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 text-[10px] font-bold text-white rounded-full" style="background: #1e3585;">{{ (ticket.finding.spareParts|length) + (ticket.finding.pendingSpareParts|length) }}</span>
                    {% endif %}
                </button>
                <button type="button" role="tab" data-tab="timeline"
                        class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 transition-all whitespace-nowrap"
                        onclick="switchTab('timeline')">
                    Línea de tiempo
                </button>
            </nav>
        </div>
    </div>

    {# ── Tab: Información ───────────────────────────────────────── #}
    <div id="tab-info" class="tab-content bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h2 class="text-sm font-semibold text-gray-700">Información del Ticket</h2>
        </div>
        <dl class="divide-y divide-gray-100">
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">N° Ticket</dt>
                <dd class="text-gray-900 font-mono font-semibold">{{ ticket.ticketNumber }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Tipo de servicio</dt>
                <dd class="text-gray-900 font-medium">{{ ticket.serviceTypeLabel }}</dd>
            </div>
            {% if ticket.interventionTypeLabel and ticket.interventionTypeLabel != ticket.serviceTypeLabel %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Tipo de intervención</dt>
                <dd class="text-gray-900">{{ ticket.interventionTypeLabel }}</dd>
            </div>
            {% endif %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Estado</dt>
                <dd>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ statusColor[ticket.status] ?? 'bg-gray-100 text-gray-600' }}">
                        {{ ticket.statusLabel }}
                    </span>
                </dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Cliente ID</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.clientId }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Terminal</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.terminalAssignmentId }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Agendado</dt>
                <dd class="text-gray-800">{{ ticket.scheduledAt ?? '—' }}</dd>
            </div>
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">SLA máximo</dt>
                <dd class="text-gray-800 {{ ticket.slaDeadlineAt and ticket.slaDeadlineAt < date().format('Y-m-d H:i') ? 'text-red-600 font-medium' : '' }}">
                    {{ ticket.slaDeadlineAt ?? '—' }}
                    {% if ticket.slaDeadlineAt and ticket.slaDeadlineAt < date().format('Y-m-d H:i') %}
                        <span class="ml-1 text-xs text-red-500">(Vencido)</span>
                    {% endif %}
                </dd>
            </div>
            {% if ticket.catCode %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Código CAT</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.catCode }}</dd>
            </div>
            {% endif %}
            {% if ticket.createdBy %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Creado por</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.createdBy }}</dd>
            </div>
            {% endif %}
            {% if ticket.slaDeadlineAt %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Asistencia iniciada</dt>
                <dd class="text-gray-800">{{ ticket.assistanceStartAt ?? '—' }}</dd>
            </div>
            {% endif %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Cerrado</dt>
                <dd class="text-gray-800">{{ ticket.closedAt ?? '—' }}</dd>
            </div>
            {% if ticket.cancelledAt %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Cancelado</dt>
                <dd class="text-red-600 font-medium">{{ ticket.cancelledAt }}</dd>
            </div>
            {% endif %}
            {% if ticket.cancelledBy %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Cancelado por</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.cancelledBy }}</dd>
            </div>
            {% endif %}
            {% if ticket.cancellationReason %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Motivo de cancelación</dt>
                <dd class="text-gray-800 max-w-md text-right">{{ ticket.cancellationReason }}</dd>
            </div>
            {% endif %}
            {% if ticket.reopenedAt %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Reabierto</dt>
                <dd class="text-sky-600 font-medium">{{ ticket.reopenedAt }}</dd>
            </div>
            {% endif %}
            {% if ticket.reopenRequestedReason %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Solicitud de reapertura</dt>
                <dd class="text-gray-800 max-w-md text-right">{{ ticket.reopenRequestedReason }}</dd>
            </div>
            {% endif %}
            {% if ticket.isRouteAttendance %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Asistencia en ruta</dt>
                <dd>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">Sí</span>
                </dd>
            </div>
            {% endif %}
            {% if ticket.parentTicketId %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Ticket padre</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.parentTicketId }}</dd>
            </div>
            {% endif %}
            {% if ticket.routeGroupId %}
            <div class="px-6 py-4 flex justify-between text-sm">
                <dt class="text-gray-500">Grupo de ruta</dt>
                <dd class="text-gray-800 font-mono text-xs">{{ ticket.routeGroupId }}</dd>
            </div>
            {% endif %}
            <div class="px-6 py-4">
                <dt class="text-gray-500 text-sm mb-2">Descripción</dt>
                <dd class="text-gray-700 text-sm bg-gray-50 rounded-lg p-4 border border-gray-100">{{ ticket.description }}</dd>
            </div>
        </dl>
    </div>

    {# ── Tab: Hallazgos ─────────────────────────────────────────── #}
    <div id="tab-findings" class="tab-content hidden bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        {% if ticket.finding %}
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Hallazgo registrado</h2>
            </div>
            <dl class="divide-y divide-gray-100">
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Tipo de problema</dt>
                    <dd class="text-gray-900 font-medium max-w-lg text-right">{{ ticket.finding.problemTypeFound }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Detalle</dt>
                    <dd class="text-gray-800 max-w-lg text-right">{{ ticket.finding.problemDetail }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Solución aplicada</dt>
                    <dd class="text-emerald-800 max-w-lg text-right">{{ ticket.finding.solution }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Voltaje de batería</dt>
                    <dd>
                        {% if ticket.finding.batteryVoltageOk %}
                            <span class="inline-flex items-center gap-1 text-emerald-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                OK
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1 text-red-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                                No OK
                            </span>
                        {% endif %}
                    </dd>
                </div>
                {% if ticket.finding.physicalDocNumber %}
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">N° Documento físico</dt>
                    <dd class="text-gray-800 font-mono">{{ ticket.finding.physicalDocNumber }}</dd>
                </div>
                {% endif %}
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Registrado por</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ ticket.finding.registeredBy }}</dd>
                </div>
                {% if ticket.finding.spareParts|length > 0 %}
                <div class="px-6 py-4">
                    <dt class="text-gray-500 text-sm mb-3">Componentes utilizados (repuestos)</dt>
                    <dd>
                        <div class="overflow-x-auto rounded-lg border border-gray-200">
                            <table class="w-full text-sm">
                                <thead class="text-xs uppercase tracking-wide text-gray-500 bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2.5 text-left font-semibold">Código</th>
                                        <th class="px-4 py-2.5 text-left font-semibold">Serial</th>
                                        <th class="px-4 py-2.5 text-center font-semibold">Cant.</th>
                                        <th class="px-4 py-2.5 text-center font-semibold">Tipo</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    {% for sp in ticket.finding.spareParts %}
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-2.5 font-mono text-xs text-gray-800">{{ sp.productCode }}</td>
                                        <td class="px-4 py-2.5 font-mono text-xs text-gray-600">{{ sp.serialNumber ?? '—' }}</td>
                                        <td class="px-4 py-2.5 text-center text-gray-800">{{ sp.quantity }}</td>
                                        <td class="px-4 py-2.5 text-center">
                                            {% if sp.isIncoming %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700">Entrante</span>
                                            {% else %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">Saliente</span>
                                            {% endif %}
                                            {% if sp.autoMarkedDamaged %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-600 ml-1">Dañado</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </dd>
                </div>
                {% endif %}
                {% if ticket.finding.pendingSpareParts|length > 0 %}
                <div class="px-6 py-4">
                    <dt class="text-gray-500 text-sm mb-3">Repuestos pendientes</dt>
                    <dd>
                        <div class="overflow-x-auto rounded-lg border border-gray-200">
                            <table class="w-full text-sm">
                                <thead class="text-xs uppercase tracking-wide text-gray-500 bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2.5 text-left font-semibold">Código</th>
                                        <th class="px-4 py-2.5 text-center font-semibold">Cant.</th>
                                        <th class="px-4 py-2.5 text-left font-semibold">Notas</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    {% for psp in ticket.finding.pendingSpareParts %}
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-2.5 font-mono text-xs text-gray-800">{{ psp.productCode }}</td>
                                        <td class="px-4 py-2.5 text-center text-gray-800">{{ psp.quantity }}</td>
                                        <td class="px-4 py-2.5 text-gray-500 text-xs">{{ psp.notes ?? '—' }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </dd>
                </div>
                {% endif %}
            </dl>
        {% else %}
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <div class="w-14 h-14 rounded-full flex items-center justify-center mb-4 bg-gray-100">
                    <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-500">No se ha registrado ningún hallazgo.</p>
                <p class="text-xs text-gray-400 mt-1">Los hallazgos se registran durante la asistencia.</p>
            </div>
        {% endif %}
    </div>

    {# ── Tab: Módulos (Module Findings) ─────────────────────────── #}
    <div id="tab-modules" class="tab-content hidden bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-gray-700">Hallazgos en Módulos</h2>
            {% if ticket.status == 'in_assistance' and is_granted('ticket.assistance') %}
            <button type="button" onclick="openModal('modal-module-finding')"
                    class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1.5 rounded-lg text-white transition-colors shadow-sm"
                    style="background:#1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                Nuevo hallazgo
            </button>
            {% endif %}
        </div>
        <div class="p-6">
            {% if ticket.moduleFindings|length > 0 %}
                <div class="space-y-4">
                    {% for finding in ticket.moduleFindings %}
                        {% include 'support/ticket/_module_finding_card.html.twig' with {finding: finding} %}
                        {% include 'support/ticket/_finding_evidence_upload.html.twig' with {
                            findingId: finding.id,
                            ticketId: ticket.id,
                        } %}
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-10">
                    <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                    </svg>
                    <p class="mt-3 text-sm text-gray-400">No hay hallazgos de módulos registrados</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Tab: Repuestos ─────────────────────────────────────────── #}
    <div id="tab-spareparts" class="tab-content hidden bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        {% if ticket.finding and (ticket.finding.spareParts|length > 0 or ticket.finding.pendingSpareParts|length > 0) %}
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Repuestos</h2>
                <p class="text-xs text-gray-400 mt-0.5">Componentes utilizados y pendientes asociados a este ticket.</p>
            </div>

            {% if ticket.finding.spareParts|length > 0 %}
            <div class="px-6 py-4 border-b border-gray-100">
                <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-3">Repuestos instalados</h3>
                <div class="overflow-x-auto rounded-lg border border-gray-200">
                    <table class="w-full text-sm">
                        <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                            <tr>
                                <th class="px-4 py-2.5 text-left font-semibold">Código producto</th>
                                <th class="px-4 py-2.5 text-left font-semibold">Serial</th>
                                <th class="px-4 py-2.5 text-center font-semibold">Cantidad</th>
                                <th class="px-4 py-2.5 text-center font-semibold">Flujo</th>
                                <th class="px-4 py-2.5 text-center font-semibold">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for sp in ticket.finding.spareParts %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 font-mono text-sm font-medium text-gray-800">{{ sp.productCode }}</td>
                                <td class="px-4 py-3 font-mono text-xs text-gray-600">{{ sp.serialNumber ?? '—' }}</td>
                                <td class="px-4 py-3 text-center text-gray-800 font-medium">{{ sp.quantity }}</td>
                                <td class="px-4 py-3 text-center">
                                    {% if sp.isIncoming %}
                                        <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            Entrante
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1 text-xs font-medium text-amber-700">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                                            </svg>
                                            Saliente
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-center">
                                    {% if sp.autoMarkedDamaged %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-600">Dañado</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">OK</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            {% if ticket.finding.pendingSpareParts|length > 0 %}
            <div class="px-6 py-4">
                <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-3">Repuestos pendientes</h3>
                <div class="overflow-x-auto rounded-lg border border-gray-200 border-dashed">
                    <table class="w-full text-sm">
                        <thead class="text-xs uppercase tracking-wide text-gray-500 bg-amber-50">
                            <tr>
                                <th class="px-4 py-2.5 text-left font-semibold">Código producto</th>
                                <th class="px-4 py-2.5 text-center font-semibold">Cantidad</th>
                                <th class="px-4 py-2.5 text-left font-semibold">Notas</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for psp in ticket.finding.pendingSpareParts %}
                            <tr class="hover:bg-amber-50/30 transition-colors">
                                <td class="px-4 py-3 font-mono text-sm font-medium text-gray-800">{{ psp.productCode }}</td>
                                <td class="px-4 py-3 text-center text-gray-800 font-medium">{{ psp.quantity }}</td>
                                <td class="px-4 py-3 text-gray-500 text-xs">{{ psp.notes ?? '—' }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
        {% else %}
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <div class="w-14 h-14 rounded-full flex items-center justify-center mb-4 bg-gray-100">
                    <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-500">No hay repuestos registrados.</p>
                <p class="text-xs text-gray-400 mt-1">Los repuestos se asocian al registrar un hallazgo.</p>
            </div>
        {% endif %}
    </div>

    {# ── Tab: Línea de tiempo ───────────────────────────────────── #}
    <div id="tab-timeline" class="tab-content hidden bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h2 class="text-sm font-semibold text-gray-700">Línea de tiempo</h2>
            <p class="text-xs text-gray-400 mt-0.5">Secuencia de eventos del ticket.</p>
        </div>

        {% set timelineEvents = [] %}

        {# Status milestones from ticket timestamps #}
        {% if ticket.scheduledAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.scheduledAt,
                type: 'schedule',
                label: 'Agendado',
                description: 'Fecha programada para la asistencia.',
            }]) %}
        {% endif %}

        {% if ticket.inTransitOutAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.inTransitOutAt,
                type: 'journey_out',
                label: 'Viaje de ida iniciado',
                description: 'Técnico en tránsito hacia el sitio.',
            }]) %}
        {% endif %}

        {% if ticket.waitingStartAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.waitingStartAt,
                type: 'waiting',
                label: 'En espera en sitio',
                description: 'Técnico llegó al sitio, esperando para iniciar asistencia.',
            }]) %}
        {% endif %}

        {% if ticket.assistanceStartAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.assistanceStartAt,
                type: 'assistance',
                label: 'Asistencia iniciada',
                description: 'Técnico comenzó la asistencia en sitio.',
            }]) %}
        {% endif %}

        {% if ticket.inTransitBackAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.inTransitBackAt,
                type: 'journey_back',
                label: 'Viaje de regreso iniciado',
                description: 'Técnico en tránsito de vuelta a base.',
            }]) %}
        {% endif %}

        {% if ticket.closedAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.closedAt,
                type: 'closed',
                label: 'Cerrado',
                description: 'Ticket cerrado y aprobado.',
            }]) %}
        {% endif %}

        {% if ticket.cancelledAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.cancelledAt,
                type: 'cancelled',
                label: 'Cancelado',
                description: ticket.cancellationReason ?? 'Sin motivo registrado.',
            }]) %}
        {% endif %}

        {% if ticket.reopenedAt %}
            {% set timelineEvents = timelineEvents|merge([{
                at: ticket.reopenedAt,
                type: 'reopened',
                label: 'Reabierto',
                description: ticket.reopenedReason ?? '',
            }]) %}
        {% endif %}

        {# Journey events #}
        {% for journey in ticket.journeys %}
            {% set timelineEvents = timelineEvents|merge([{
                at: journey.startedAt,
                type: 'journey_start',
                label: 'Viaje iniciado: ' ~ journey.typeLabel,
                description: journey.notes ?? '',
            }]) %}
            {% if journey.arrivedAt %}
                {% set timelineEvents = timelineEvents|merge([{
                    at: journey.arrivedAt,
                    type: 'journey_arrive',
                    label: 'Destino alcanzado: ' ~ journey.typeLabel,
                    description: '',
                }]) %}
            {% endif %}
        {% endfor %}

        {# Pause events #}
        {% for pause in ticket.pauses %}
            {% set timelineEvents = timelineEvents|merge([{
                at: pause.pausedAt,
                type: 'paused',
                label: 'Pausado',
                description: pause.pauseReason,
            }]) %}
            {% if pause.resumedAt %}
                {% set timelineEvents = timelineEvents|merge([{
                    at: pause.resumedAt,
                    type: 'resumed',
                    label: 'Reanudado',
                    description: '',
                }]) %}
            {% endif %}
        {% endfor %}

        {# Reschedule events #}
        {% for reschedule in ticket.reschedules %}
            {% set timelineEvents = timelineEvents|merge([{
                at: reschedule.rescheduledAt,
                type: 'reschedule',
                label: 'Reprogramado',
                description: reschedule.reason ~ ' (de ' ~ reschedule.previousScheduledAt ~ ' a ' ~ reschedule.newScheduledAt ~ ')',
            }]) %}
        {% endfor %}

        {# Assignment events #}
        {% for assignment in ticket.assignments %}
            {% if assignment.assignedAt %}
                {% set timelineEvents = timelineEvents|merge([{
                    at: assignment.assignedAt,
                    type: 'assignment',
                    label: 'Asignado' ~ (assignment.isInCharge ? ' (Responsable)' : ''),
                    description: 'Empleado ID: ' ~ assignment.employeeId,
                }]) %}
            {% endif %}
        {% endfor %}

        {# Sort by date ascending #}
        {% set timelineEvents = timelineEvents|sort((a, b) => a.at <=> b.at) %}

        {% if timelineEvents|length > 0 %}
            <div class="px-6 py-6">
                <div class="relative pl-8 ml-2 border-l-2 border-gray-200 space-y-6">
                    {% for event in timelineEvents %}
                        {% set dotColor = {
                            'schedule':     'bg-blue-500',
                            'journey_out':  'bg-indigo-500',
                            'journey_back': 'bg-purple-500',
                            'journey_start': 'bg-indigo-400',
                            'journey_arrive': 'bg-indigo-600',
                            'waiting':      'bg-yellow-500',
                            'assistance':   'bg-orange-500',
                            'paused':       'bg-red-500',
                            'resumed':      'bg-green-500',
                            'closed':       'bg-emerald-500',
                            'cancelled':    'bg-gray-500',
                            'reopened':     'bg-sky-500',
                            'assignment':   'bg-blue-400',
                            'reschedule':   'bg-amber-500',
                        } %}
                        {% set eventDot = dotColor[event.type] ?? 'bg-gray-400' %}
                        <div class="relative">
                            <div class="absolute -left-[29px] w-4 h-4 rounded-full border-2 border-white shadow-sm {{ eventDot }}"></div>
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900">{{ event.label }}</p>
                                    {% if event.description %}
                                        <p class="text-xs text-gray-500 mt-0.5">{{ event.description }}</p>
                                    {% endif %}
                                </div>
                                <div class="shrink-0 text-xs text-gray-400 font-mono whitespace-nowrap pt-0.5">{{ event.at }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <div class="w-14 h-14 rounded-full flex items-center justify-center mb-4 bg-gray-100">
                    <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-500">Sin eventos registrados.</p>
            </div>
        {% endif %}
    </div>

</div>

