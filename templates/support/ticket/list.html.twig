{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Tickets de Soporte{% endblock %}
{% block page_title %}Tickets de Soporte{% endblock %}

{% block header_actions %}
    {% if is_granted('ticket.create') %}
        <a href="{{ path('support_ticket_new') }}"
           class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
           style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Nuevo ticket
        </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% set statusColor = {
        'created':         'bg-gray-100 text-gray-700',
        'assigned':        'bg-blue-100 text-blue-700',
        'in_transit_out':  'bg-indigo-100 text-indigo-700',
        'waiting':         'bg-yellow-100 text-yellow-700',
        'in_assistance':   'bg-orange-100 text-orange-700',
        'paused':          'bg-red-100 text-red-700',
        'in_transit_back': 'bg-purple-100 text-purple-700',
        'pending_closure': 'bg-amber-100 text-amber-700',
        'reopened':        'bg-sky-100 text-sky-700',
        'closed':          'bg-green-100 text-green-700',
        'cancelled':       'bg-gray-200 text-gray-500',
    } %}

    {% set clientMap = {} %}
    {% for client in clients %}
        {% set clientMap = clientMap|merge({(client.id): client.name}) %}
    {% endfor %}

    {% if tickets is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a3 3 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-gray-600">No hay tickets registrados.</p>
            <p class="text-xs text-gray-400 mt-1">Cree un nuevo ticket para comenzar.</p>
            {% if is_granted('ticket.create') %}
                <a href="{{ path('support_ticket_new') }}"
                   class="mt-4 inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all"
                   style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
                    Crear primer ticket
                </a>
            {% endif %}
        </div>
    {% else %}

        <div class="bg-white rounded-xl shadow-sm border border-gray-200"
             data-controller="table-filter">

            {# -- Toolbar ------------------------------------------- #}
            {{ include('components/_table_toolbar.html.twig', {placeholder: 'Buscar ticket por #, cliente o tipo de servicio...'}) }}

            {# -- Panel de filtros (client-side) -------------------- #}
            <div data-table-filter-target="panel"
                 class="hidden bg-gray-50/60 border-b border-gray-100 px-4 py-3">
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Cliente</label>
                        <select name="clientFilter"
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white w-44 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors"
                                data-table-filter-target="filterSelect"
                                data-col="1"
                                data-match="exact">
                            <option value="">Todos</option>
                            {% for client in clients %}
                                <option value="{{ client.name }}">{{ client.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Estado</label>
                        <select data-table-filter-target="filterSelect"
                                data-col="3"
                                data-match="exact"
                                data-action="change->table-filter#filterRows"
                                class="text-sm rounded-lg border border-gray-200 px-3 py-1.5 bg-white w-40 focus:outline-none focus:ring-2 focus:ring-blue-400/30 focus:border-blue-400 transition-colors">
                            <option value="">Todos</option>
                            {% for s in statuses %}
                                <option value="{{ s.label() }}">{{ s.label() }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            {# -- Tabla --------------------------------------------- #}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                        <tr>
                            <th class="px-5 py-3.5 text-left font-semibold">Ticket #</th>
                            <th class="px-5 py-3.5 text-left font-semibold">Cliente</th>
                            <th class="px-5 py-3.5 text-left font-semibold">Tipo servicio</th>
                            <th class="px-5 py-3.5 text-left font-semibold">Estado</th>
                            <th class="px-5 py-3.5 text-left font-semibold">Agendado</th>
                            <th class="px-5 py-3.5 text-left font-semibold">SLA</th>
                            <th class="px-5 py-3.5 text-right font-semibold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for ticket in tickets %}
                            <tr class="hover:bg-gray-50 transition-colors"
                                data-table-filter-target="row">
                                <td class="px-5 py-4">
                                    <span class="font-mono font-semibold text-gray-900 text-xs">{{ ticket.ticketNumber }}</span>
                                </td>
                                <td class="px-5 py-4 text-gray-700">
                                    {{ clientMap[ticket.clientId] ?? '—' }}
                                </td>
                                <td class="px-5 py-4">
                                    <span class="text-gray-600">{{ ticket.serviceTypeLabel }}</span>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ statusColor[ticket.status] ?? 'bg-gray-100 text-gray-600' }}">
                                        {{ ticket.statusLabel }}
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-gray-500 text-xs">{{ ticket.scheduledAt ?? '—' }}</td>
                                <td class="px-5 py-4">
                                    {% if ticket.slaDeadlineAt %}
                                        <span class="text-xs {{ ticket.slaDeadlineAt < date().format('Y-m-d H:i') ? 'text-red-600 font-medium' : 'text-gray-500' }}">
                                            {{ ticket.slaDeadlineAt }}
                                        </span>
                                    {% else %}
                                        <span class="text-gray-300">—</span>
                                    {% endif %}
                                </td>
                                <td class="px-5 py-4 text-right">{{ ui.btn_view(path('support_ticket_show', {id: ticket.id})) }}</td>
                            </tr>
                        {% endfor %}
                        <tr data-table-filter-target="noResults" class="hidden">
                            <td colspan="7" class="px-6 py-12 text-center text-sm text-gray-400">
                                No se encontraron tickets con los filtros aplicados.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    {% endif %}
{% endblock %}
