{% extends 'base.html.twig' %}

{% block title %}Tickets de Soporte{% endblock %}

{% block body %}
<div class="p-6 space-y-4">

    {# Header #}
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-800">Tickets de Soporte</h1>
        {% if is_granted('ticket.create') %}
            <a href="{{ path('support_ticket_new') }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm font-medium shadow"
               style="background:#1e3585">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Nuevo Ticket
            </a>
        {% endif %}
    </div>

    {# Flash messages #}
    {% for msg in app.flashes('success') %}
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 text-sm">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm">{{ msg }}</div>
    {% endfor %}

    {# Filters #}
    <form method="get" class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-wrap gap-3 items-end">
        <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-gray-500">Cliente</label>
            <select name="clientId" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2" style="--tw-ring-color:#1e3585">
                <option value="">Todos</option>
                {% for client in clients %}
                    <option value="{{ client.id }}" {% if filters.clientId == client.id %}selected{% endif %}>
                        {{ client.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-gray-500">Estado</label>
            <select name="status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2">
                <option value="">Todos</option>
                {% for s in statuses %}
                    <option value="{{ s.value }}" {% if filters.status == s.value %}selected{% endif %}>
                        {{ s.label() }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <button type="submit"
                class="px-4 py-2 rounded-lg text-white text-sm font-medium"
                style="background:#1e3585">
            Filtrar
        </button>
        <a href="{{ path('support_ticket_list') }}" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-600 text-sm hover:bg-gray-50">
            Limpiar
        </a>
    </form>

    {# Table #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-100 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide bg-gray-50">
                    <th class="px-4 py-3"># Ticket</th>
                    <th class="px-4 py-3">Tipo servicio</th>
                    <th class="px-4 py-3">Estado</th>
                    <th class="px-4 py-3">Agendado</th>
                    <th class="px-4 py-3">SLA</th>
                    <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% if tickets is empty %}
                    <tr>
                        <td colspan="6" class="px-4 py-10 text-center text-gray-400">No hay tickets con los filtros seleccionados.</td>
                    </tr>
                {% endif %}
                {% for ticket in tickets %}
                    {% set statusColor = {
                        'CREATED':         'bg-gray-100 text-gray-700',
                        'ASSIGNED':        'bg-blue-100 text-blue-700',
                        'IN_TRANSIT_OUT':  'bg-indigo-100 text-indigo-700',
                        'WAITING':         'bg-yellow-100 text-yellow-700',
                        'IN_ASSISTANCE':   'bg-orange-100 text-orange-700',
                        'PAUSED':          'bg-red-100 text-red-700',
                        'IN_TRANSIT_BACK': 'bg-purple-100 text-purple-700',
                        'PENDING_CLOSURE': 'bg-amber-100 text-amber-700',
                        'CLOSED':          'bg-green-100 text-green-700',
                        'CANCELLED':       'bg-gray-200 text-gray-500',
                    } %}
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 font-mono font-semibold text-gray-800">{{ ticket.ticketNumber }}</td>
                        <td class="px-4 py-3 text-gray-600">{{ ticket.serviceTypeLabel }}</td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium {{ statusColor[ticket.status] ?? 'bg-gray-100 text-gray-600' }}">
                                {{ ticket.statusLabel }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-gray-500">{{ ticket.scheduledAt ?? '—' }}</td>
                        <td class="px-4 py-3 text-gray-500">{{ ticket.slaDeadlineAt ?? '—' }}</td>
                        <td class="px-4 py-3 text-right">
                            <a href="{{ path('support_ticket_show', {id: ticket.id}) }}"
                               class="inline-flex items-center gap-1 text-xs text-blue-600 hover:underline font-medium">
                                Ver detalle
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Count #}
    {% if tickets is not empty %}
        <p class="text-xs text-gray-400">{{ tickets|length }} ticket(s) mostrado(s)</p>
    {% endif %}

</div>
{% endblock %}
