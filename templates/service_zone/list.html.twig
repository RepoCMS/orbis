{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Zonas de Servicio{% endblock %}
{% block page_title %}Gestión de Zonas de Servicio{% endblock %}

{% block header_actions %}
    {% if is_granted('service_zone.create') %}
    <a href="{{ path('service_zone_new') }}"
       class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all hover:shadow-md"
       style="background: #1e3585;" onmouseover="this.style.background='#152970'" onmouseout="this.style.background='#1e3585'">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Nueva zona
    </a>
    {% endif %}
{% endblock %}

{% block body %}
    {% if zones is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: #eef1f9;">
                <svg class="w-8 h-8" fill="none" stroke="#1e3585" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
                </svg>
            </div>
            <p class="text-sm font-medium text-gray-600">No hay zonas de servicio registradas.</p>
            {% if is_granted('service_zone.create') %}
            <a href="{{ path('service_zone_new') }}"
               class="mt-4 inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg"
               style="background: #1e3585;">Crear zona</a>
            {% endif %}
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200"
             data-controller="table-filter">

            {{ include('components/_table_toolbar.html.twig', {placeholder: 'Buscar zona...'}) }}

            <div data-table-filter-target="panel"
                 class="hidden bg-slate-50/60 border-b border-slate-100 px-4 py-3">
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Estado</label>
                        <select data-table-filter-target="filterSelect"
                                data-col="2"
                                data-match="exact"
                                data-action="change->table-filter#filterRows"
                                class="text-sm rounded-lg border border-slate-200 px-3 py-1.5 bg-white w-40 focus:outline-none">
                            <option value="">Todos</option>
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="text-xs uppercase tracking-wide text-white" style="background: #1e3585;">
                    <tr>
                        <th class="px-6 py-3.5 text-left font-semibold">Nombre</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Ciudades</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Estado</th>
                        <th class="px-6 py-3.5 text-left font-semibold">Creada</th>
                        <th class="px-6 py-3.5 text-right font-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for zone in zones %}
                        <tr class="hover:bg-slate-50 transition-colors"
                            data-table-filter-target="row">
                            <td class="px-6 py-4 font-medium text-gray-900">{{ zone.name }}</td>
                            <td class="px-6 py-4 text-gray-500">{{ zone.cityIds|length }}</td>
                            <td class="px-6 py-4">
                                <span class="hidden">{{ zone.status == 'active' ? 'Activo' : 'Inactivo' }}</span>
                                {{ ui.status_badge(zone.status) }}
                            </td>
                            <td class="px-6 py-4 text-gray-500">{{ zone.createdAt|date('d/m/Y') }}</td>
                            <td class="px-6 py-4 text-right">
                                {{ ui.btn_view(path('service_zone_show', {id: zone.id})) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
