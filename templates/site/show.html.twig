{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}Sucursal {{ site.name }}{% endblock %}
{% block page_title %}Sucursal: {{ site.name }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('client_show', {id: site.clientId}) }}" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver al cliente
    </a>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <p class="text-sm text-green-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
            <p class="text-sm text-red-700">{{ message }}</p>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="mb-4 bg-amber-50 border border-amber-200 rounded-xl px-5 py-3">
            <p class="text-sm text-amber-700">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="w-full max-w-4xl mx-auto space-y-6">

        {# ── Errors ── #}
        {% if errors is defined and errors|length > 0 %}
            <div class="bg-red-50 border border-red-200 rounded-xl px-5 py-4">
                {% for error in errors %}
                    <p class="text-sm text-red-700">{{ error }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {# ── Profile header ── #}
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shrink-0"
                         style="background: #1e3585;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-gray-900">{{ site.name }}</h1>
                        <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                            <span>{{ ui.status_badge(site.status) }}</span>
                            <span class="text-gray-300">|</span>
                            <span class="font-medium">{{ client.name }}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if is_granted('site.update') %}
                        <button type="button" id="toggle-edit-site"
                                class="text-sm font-medium px-3 py-1.5 rounded-lg border text-blue-700 bg-blue-50 border-blue-200 hover:bg-blue-100 transition-colors">
                            Editar
                        </button>
                    {% endif %}
                    {% if site.status == 'active' and is_granted('site.update') %}
                        <form method="POST" action="{{ path('site_deactivate', {clientId: site.clientId, siteId: site.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-amber-700 bg-amber-50 border-amber-200 hover:bg-amber-100 transition-colors">
                                Desactivar
                            </button>
                        </form>
                    {% elseif site.status != 'active' and is_granted('site.update') %}
                        <form method="POST" action="{{ path('site_reactivate', {clientId: site.clientId, siteId: site.id}) }}">
                            <button type="submit"
                                    class="text-sm font-medium px-3 py-1.5 rounded-lg border text-emerald-700 bg-emerald-50 border-emerald-200 hover:bg-emerald-100 transition-colors">
                                Reactivar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── View: Details ── #}
        <div id="view-site" class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-gray-700">Información de la sucursal</h2>
                {% if is_granted('site.update') %}
                    <button type="button" id="toggle-edit-site-tab"
                            class="text-xs text-blue-600 hover:underline font-medium">Editar</button>
                {% endif %}
            </div>
            <dl class="divide-y divide-gray-100">
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">ID</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ site.id }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Nombre</dt>
                    <dd class="text-gray-900 font-medium">{{ site.name }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Cliente</dt>
                    <dd class="text-gray-800">{{ client.name }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Ciudad</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ site.cityId }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Terminal</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ site.terminalId }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Zona de servicio</dt>
                    <dd class="text-gray-800 font-mono text-xs">{{ site.serviceZoneId ?? '—' }}</dd>
                </div>
                <div class="px-6 py-4 flex justify-between text-sm">
                    <dt class="text-gray-500">Estado</dt>
                    <dd>{{ ui.status_badge(site.status) }}</dd>
                </div>
            </dl>
        </div>

        {# ── Edit Form ── #}
        <form id="form-edit-site" method="POST" action="{{ path('site_edit', {clientId: site.clientId, siteId: site.id}) }}"
              class="{{ editMode is defined and editMode ? '' : 'hidden' }} bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700">Editar sucursal</h2>
            </div>

            {% if editErrors is defined and editErrors|length > 0 %}
                <div class="mx-6 mt-4 bg-red-50 border border-red-200 rounded-lg p-4 space-y-1">
                    {% for error in editErrors %}
                        <p class="text-sm text-red-700">• {{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="px-6 py-5 space-y-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Nombre</label>
                    <input type="text" name="name"
                           value="{{ (editInput.name is defined) ? editInput.name : site.name }}"
                           class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                           required>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Zona de servicio</label>
                    <select name="service_zone_id"
                            class="w-full rounded-lg border border-gray-300 text-sm px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">— Sin zona —</option>
                        {% for zone in zones %}
                            <option value="{{ zone.id }}" {% if (editInput.serviceZoneId is defined and editInput.serviceZoneId == zone.id) or (editInput.serviceZoneId is not defined and site.serviceZoneId == zone.id) %}selected{% endif %}>
                                {{ zone.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="flex items-center gap-3 pt-2">
                    <button type="submit"
                            class="inline-flex items-center gap-2 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm"
                            style="background: #1e3585;"
                            onmouseover="this.style.background='#152970'"
                            onmouseout="this.style.background='#1e3585'">
                        Guardar cambios
                    </button>
                    <button type="button" id="cancel-edit-site" class="text-sm text-gray-500 hover:text-gray-700">Cancelar</button>
                </div>
            </div>
        </form>

    </div>

    <script>
        (function() {
            var toggle = document.getElementById('toggle-edit-site-tab') || document.getElementById('toggle-edit-site');
            var view   = document.getElementById('view-site');
            var form   = document.getElementById('form-edit-site');
            var cancel = document.getElementById('cancel-edit-site');
            if (form && !form.classList.contains('hidden')) {
                toggle && toggle.classList.add('hidden');
            }
            toggle && toggle.addEventListener('click', function() {
                view.classList.add('hidden');
                form.classList.remove('hidden');
                toggle.classList.add('hidden');
            });
            cancel && cancel.addEventListener('click', function() {
                view.classList.remove('hidden');
                form.classList.add('hidden');
                toggle.classList.remove('hidden');
            });
        })();
    </script>
{% endblock %}
