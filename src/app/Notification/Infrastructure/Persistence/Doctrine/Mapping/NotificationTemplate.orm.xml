<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        Plantilla de notificación configurable por evento + canal.
        Define el asunto y cuerpo del mensaje para cada combinación event_type/channel.
    -->
    <entity name="App\Notification\Domain\Entities\NotificationTemplate" table="notification_templates">

        <id name="id" type="notification_template_id" column="id" length="26" />

        <field name="eventType"    type="notification_event_type" column="event_type"     length="50" />
        <field name="channel"      type="notification_channel"    column="channel"        length="20" />
        <field name="subject"      type="string"                  column="subject"        length="255" nullable="true" />
        <field name="bodyTemplate" type="text"                    column="body_template" />
        <field name="isActive"     type="boolean"                 column="is_active" />
        <field name="createdAt"    type="datetime_immutable"      column="created_at" />
        <field name="updatedAt"    type="datetime_immutable"      column="updated_at"     nullable="true" />

        <unique-constraints>
            <unique-constraint name="uq_notification_templates_event_channel" columns="event_type,channel" />
        </unique-constraints>

        <indexes>
            <index name="idx_notification_templates_event_type" columns="event_type" />
            <index name="idx_notification_templates_channel"    columns="channel" />
        </indexes>

    </entity>

</doctrine-mapping>
