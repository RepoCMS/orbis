<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Inventory\Domain\Entities\Request" table="stock_requests">

        <id name="id" type="request_id" column="id" length="26" />

        <field name="reference"             type="string"             column="reference"               length="30"  unique="true" />
        <field name="requestedBy"           type="user_id"            column="requested_by_id"         length="26" />
        <field name="sourceLocationId"      type="location_id"        column="source_location_id"      length="26" />
        <field name="destinationLocationId" type="location_id"        column="destination_location_id" length="26" />
        <field name="status"                type="inventory_request_status" column="status" length="20" />
        <field name="notes"                 type="text"               column="notes"                   nullable="true" />
        <field name="approvedBy"            type="user_id"            column="approved_by_id"          length="26"  nullable="true" />
        <field name="approvedAt"            type="datetime_immutable" column="approved_at"             nullable="true" />
        <field name="rejectedBy"            type="user_id"            column="rejected_by_id"          length="26"  nullable="true" />
        <field name="rejectedAt"            type="datetime_immutable" column="rejected_at"             nullable="true" />
        <field name="rejectionReason"       type="text"               column="rejection_reason"        nullable="true" />
        <field name="cancelledBy"           type="user_id"            column="cancelled_by_id"         length="26"  nullable="true" />
        <field name="createdAt"             type="datetime_immutable" column="created_at" />

        <one-to-many field="items" target-entity="App\Inventory\Domain\Entities\RequestItem" mapped-by="request" fetch="EAGER">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <indexes>
            <index name="idx_stock_requests_status"       columns="status" />
            <index name="idx_stock_requests_requested_by" columns="requested_by_id" />
        </indexes>

    </entity>

</doctrine-mapping>
