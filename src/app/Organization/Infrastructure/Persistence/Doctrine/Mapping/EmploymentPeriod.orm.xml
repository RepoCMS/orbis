<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Organization\Domain\Entities\EmploymentPeriod" table="org_employment_periods">

        <id name="id" type="employment_period_id" column="id" length="26" />

        <field name="employeeId" type="employee_id"          column="employee_id" length="26" />
        <field name="startedAt"  type="datetime_immutable"   column="started_at" />
        <field name="endedAt"    type="datetime_immutable"   column="ended_at"    nullable="true" />
        <field name="status"     type="employment_period_status" column="status"  length="10" />
        <field name="createdAt"  type="datetime_immutable"   column="created_at" />
        <field name="deletedAt"  type="datetime_immutable"   column="deleted_at"  nullable="true" />

        <indexes>
            <index name="idx_ep_employee_id" columns="employee_id" />
            <index name="idx_ep_status"      columns="status" />
        </indexes>

    </entity>

</doctrine-mapping>
