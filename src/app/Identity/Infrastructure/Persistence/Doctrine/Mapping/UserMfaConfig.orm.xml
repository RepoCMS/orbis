<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Identity\Domain\Entities\UserMfaConfig" table="identity_user_mfa_configs">

        <id name="id" type="user_mfa_config_id" column="id" length="26" />

        <field name="userId"       type="user_id"            column="user_id"       length="26" />
        <field name="secret"       type="string"             column="secret"        length="255" />
        <field name="isEnabled"    type="boolean"            column="is_enabled" />
        <field name="confirmedAt"  type="datetime_immutable" column="confirmed_at"  nullable="true" />
        <field name="createdAt"    type="datetime_immutable" column="created_at"    nullable="false" />

        <unique-constraints>
            <unique-constraint name="uniq_user_mfa_configs_user_id" columns="user_id" />
        </unique-constraints>

        <indexes>
            <index name="idx_user_mfa_configs_user_id" columns="user_id" />
        </indexes>

    </entity>

</doctrine-mapping>
