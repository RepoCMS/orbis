<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Identity\Domain\Entities\User" table="users">

        <id name="id" type="user_id" column="id" length="26" />

        <field name="username"            type="username"           column="username"              length="15" unique="true" />
        <field name="password"            type="hashed_password"     column="password"              length="255" />
        <field name="roleId"              type="role_id"            column="role_id"               length="26" />
        <field name="status"              type="user_status" column="status" length="20" />
        <field name="failedLoginAttempts" type="integer"            column="failed_login_attempts"             nullable="false" />
        <field name="lockedUntil"         type="datetime_immutable" column="locked_until"          nullable="true" />
        <field name="deletedAt"           type="datetime_immutable" column="deleted_at"            nullable="true" />

        <lifecycle-callbacks>
            <!-- Doctrine lifecycle callbacks can be registered here if needed -->
        </lifecycle-callbacks>

    </entity>

</doctrine-mapping>
