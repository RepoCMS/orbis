<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Support\Domain\Entities\TicketWaiting" table="ticket_waitings">

        <id name="id" type="ticket_waiting_id" column="id" length="26" />

        <field name="ticketId"  type="string"             column="ticket_id"   length="26" />
        <field name="category"  type="support_waiting_category" column="category"    length="20" />
        <field name="subReason" type="text"               column="sub_reason"  nullable="true" />
        <field name="startedAt" type="datetime_immutable" column="started_at" />
        <field name="endedAt"   type="datetime_immutable" column="ended_at"    nullable="true" />

        <indexes>
            <index name="idx_tw_ticket_id"  columns="ticket_id" />
            <index name="idx_tw_category"   columns="category" />
            <index name="idx_tw_started_at" columns="started_at" />
        </indexes>

    </entity>

</doctrine-mapping>
