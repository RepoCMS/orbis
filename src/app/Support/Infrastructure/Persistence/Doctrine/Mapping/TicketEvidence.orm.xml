<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Support\Domain\Entities\TicketEvidence" table="ticket_evidences">

        <id name="id" type="ticket_evidence_id" column="id" length="26" />

        <field name="ticketId"   type="ticket_id" column="ticket_id"   length="26" />
        <field name="filePath"   type="string"    column="file_path"   length="500" />
        <field name="uploadedBy" type="string"    column="uploaded_by" length="26" />
        <field name="uploadedAt" type="datetime_immutable" column="uploaded_at" />

        <indexes>
            <index name="idx_ticket_evidences_ticket_id" columns="ticket_id" />
        </indexes>

    </entity>

</doctrine-mapping>
