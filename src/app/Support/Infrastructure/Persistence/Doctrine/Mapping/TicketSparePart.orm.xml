<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Support\Domain\Entities\TicketSparePart" table="ticket_spare_parts">

        <id name="id" type="ticket_spare_part_id" column="id" length="26" />

        <field name="ticketId"          type="ticket_id"         column="ticket_id"           length="26" />
        <field name="findingId"         type="ticket_finding_id" column="finding_id"           length="26" />
        <field name="productCode"       type="string"            column="product_code"         length="50" />
        <field name="serialNumber"      type="string"            column="serial_number"        length="100" nullable="true" />
        <field name="quantity"          type="integer"           column="quantity" />
        <field name="isIncoming"        type="boolean"           column="is_incoming" />
        <field name="isVisibleToClient" type="boolean"           column="is_visible_to_client" />
        <field name="autoMarkedDamaged" type="boolean"           column="auto_marked_damaged" />

        <indexes>
            <index name="idx_ticket_spare_parts_ticket_id"  columns="ticket_id" />
            <index name="idx_ticket_spare_parts_finding_id" columns="finding_id" />
            <index name="idx_ticket_spare_parts_product_code" columns="product_code" />
        </indexes>

    </entity>

</doctrine-mapping>
