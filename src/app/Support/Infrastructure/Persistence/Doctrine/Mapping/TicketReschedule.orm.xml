<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Support\Domain\Entities\TicketReschedule" table="ticket_reschedules">

        <id name="id" type="ticket_reschedule_id" column="id" length="26" />

        <field name="ticketId"            type="ticket_id" column="ticket_id"              length="26" />
        <field name="previousScheduledAt" type="datetime_immutable" column="previous_scheduled_at" />
        <field name="newScheduledAt"      type="datetime_immutable" column="new_scheduled_at" />
        <field name="reason"              type="text"      column="reason" />
        <field name="requestedBy"         type="support_reschedule_requested_by" column="requested_by" length="10" />
        <field name="rescheduledBy"       type="string"    column="rescheduled_by"         length="26" />
        <field name="rescheduledAt"       type="datetime_immutable" column="rescheduled_at" />

        <indexes>
            <index name="idx_ticket_reschedules_ticket_id" columns="ticket_id" />
        </indexes>

    </entity>

</doctrine-mapping>
